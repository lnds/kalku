import kalku.wire.enums
import kalku.orchestrator.telling
import kalku.core.costing

# Reading the account back is what a handler is for: no process, no
# stderr, and the lines in the order they were said in.
fn heard(body: () -> Unit / Telling) : [String] = handle {
  body()
} with Telling([]) {
  tell_of(line, resume) -> resume((), state ++ [line])
  entered(phase, resume) -> resume((), state ++ ["entered #{phase_name(phase)}"])
  got_through(done, total, resume) -> resume((), state ++ ["#{done} of #{total}"])
  will_cost(casts, estimate_ms, most_ms, resume) ->
    resume((), state ++ ["#{casts} casts, #{estimate_ms}ms, at most #{most_ms}ms"])
  still_on(worker, what, ms, resume) -> resume((), state ++ [stalled(worker, what, ms)])
  return(_x) -> state
}

fn phases() : Unit / Telling {
  Telling.tell_of("preparing")
  Telling.tell_of("casting 2 of 6")
}

test "an account is heard in the order it was said" {
  assert heard(phases) == ["preparing", "casting 2 of 6"]
}

# The cost is a note of its own rather than a sentence, because two kinds
# of listener render it differently: a person reads words, a client reads
# the number and can refuse the run over it.
test "what a run will cost is heard as numbers, not as prose" {
  assert heard(() => Telling.will_cost(480, 540000, 900000))
    == ["480 casts, 540000ms, at most 900000ms"]
}

# The last cast always gets a note, whatever the size of the run: a client
# that drew a bar from these numbers has to be able to finish it.
test "the cast that ends a run is always worth a note" {
  assert worth_saying(1, 1)
  assert worth_saying(7, 7)
  assert worth_saying(4376, 4376)
}

# A run small enough that every cast is more than a percent of it hears
# about every cast; a big one hears about the steps.
test "a note is worth making once the run has moved a percent" {
  assert worth_saying(1, 10)
  assert worth_saying(3, 10)
  assert not worth_saying(1, 1000)
  assert worth_saying(10, 1000)
}

# A figure that could not describe a run is worth no note. This is a
# guard rather than a contract on purpose: a run must not lose what it
# measured over an arithmetic slip in a progress count.
test "a count that describes no run says nothing" {
  assert not worth_saying(0, 480)
  assert not worth_saying(5, 0)
  assert not worth_saying(0 - 1, 480)
}

fn notes_over(total: Int) : Int =
  list.length(enumerate(repeat(0, total)) |? (i => worth_saying(i.fst + 1, total)))

# Whatever the size of a run, a client hears about it a bounded number of
# times — which is the whole reason the threshold exists — and hears about
# its end exactly once.
check "a run of any size is reported at most a hundred times" with n: Int {
  let total = 1 + abs(n) % 5000
  notes_over(total) <= 100 and worth_saying(total, total)
}

# A quiet run is not a run that says nothing to nobody: the notes are
# made and dropped, and what the body returns is untouched.
test "a quiet run drops the account and keeps the answer" {
  assert untold(() => {
    phases()
    42
  })
    == 42
}

# A person watching a run reads how far it has got and how long is left,
# and a figure under a second says nothing worth reading.
test "how far the casting has got says how long is left once that says anything" {
  assert counted(120, 446, 480000) == "casting 120 of 446, 8 minutes left"
  assert counted(446, 446, 480000) == "casting 446 of 446"
  assert counted(3, 10, 500) == "casting 3 of 10"
}

# The baseline's estimate stands until a cast has finished; after that the
# casts' own rate is the better guess.
test "what is left is the rate the casts went at, and the estimate before any" {
  assert left_ms(0, 10, 0, 9000) == 9000
  assert left_ms(2, 10, 4000, 9000) == 16000
}

test "a cast that has gone on long is named with its worker and its wekufe" {
  assert stalled(2, "src/a.ts:41 return", 95400)
    == "worker 2 is still on src/a.ts:41 return after 95 s"
}

fn shown_on(tty: Bool, body: () -> Unit / Telling) : [String] / Clock = handle {
  shown(body)
} with Stderr([]) {
  eprint(s, resume) -> resume((), state ++ [s])
  is_tty(resume) -> resume(tty, state)
  return(_x) -> state
}

fn a_run() : Unit / Telling {
  Telling.entered(PhaseCasting)
  Telling.will_cost(10, 5000, 5000)
  Telling.tell_of("worker 1 casts lib/a.kai:3 arm against 1 test(s)")
  Telling.got_through(1, 10)
  Telling.still_on(1, "lib/a.kai:3 arm", 31000)
  Telling.got_through(10, 10)
}

# A CI log is read after the fact: each phase, a cast that hung, and where
# the run ended, with nothing rewritten and no sentence per wekufe.
test "off a terminal, a run says each phase, a cast that is taking long, and the last count" {
  assert shown_on(false, a_run)
    == [
      "kalku: #{phase_name(PhaseCasting)}",
      "kalku: #{what_it_costs(5000, 5000)}",
      "kalku: worker 1 is still on lib/a.kai:3 arm after 31 s",
      "kalku: casting 10 of 10"
    ]
}

# On a terminal the count is one line drawn over itself; a cast taking long
# goes above it and stays, and the line is gone before the report.
test "on a terminal, the count is drawn in place and cleared, and a long cast stays above it" {
  let up = "\x1b[1A\x1b[2K"
  assert shown_on(true, a_run)
    == [
      "kalku: #{phase_name(PhaseCasting)}",
      "#{up}kalku: casting 0 of 10, under a minute left",
      "#{up}kalku: casting 1 of 10",
      "#{up}kalku: worker 1 is still on lib/a.kai:3 arm after 31 s",
      "kalku: casting 1 of 10",
      "#{up}kalku: casting 10 of 10",
      "#{up}\x1b[1A"
    ]
}

test "a quiet run says nothing" {
  assert shown_on(false, () => untold(a_run)) == []
}
