import actor
import kalku.wire.enums
import kalku.wire.shapes
import kalku.core.planner.{plan}
import kalku.core.told
import kalku.orchestrator.kalku_proc
import kalku.orchestrator.pool
import kalku.orchestrator.attending
import kalku.orchestrator.telling
import kalku.orchestrator.scheduler
import kalku.orchestrator.measure
import kalku.core.report

const FAKE : String = "./tests/fake_kalku/fake_kalku"

fn asking_of(script: String) : Asking = Asking {
  spec: PoolSpec {
    command: FAKE,
    args: ["tests/fixtures/scripts/#{script}"],
    workers: 1,
    root: ".",
    reni: ".kalku",
    inline_limit_bytes: 65536,
    env: StrMap { entries: [] },
    greeting_ms: 5000,
    summons_allowed: 1,
    memory_mb: 0
  },
  files: ["lib/a.ex"],
  only: [],
  spells: [],
  exclude_calls: [],
  exclude: [],
  equivalents: [],
  limit: 0,
  timeout_floor_ms: 1000,
  touched: None
}

fn learnt(script: String) : Result[measure.Known, String] / Process + Spawn + Clock + File =
  with_mailbox { alone(() => untold(() => discover(asking_of(script)))) }

fn nothing_cached(id: String) : Option[Outcome] = None

# A test that already fails would fail against every wekufe it was sent
# with, and each of those would be a kill nobody made. It is taken out once,
# where what the baseline said is put together, so that nothing a cast is
# ever handed can hold it: not the suite, not the coverage, not the plan.
test "a test that fails before anything is cast is handed to no cast" {
  match learnt("red_some_pass.ndjson") {
    Err(why) -> {
      assert why == "a suite with a test that passes should be measured"
    }
    Ok(known) -> {
      assert known.tests == ["test/a_test.exs:3"]
      assert (known.left_out | (.test_id)) == ["test/a_test.exs:9"]
      assert known.differences == ["the build is elsewhere"]

      let ready = plan(inputs_for(asking_of("red_some_pass.ndjson"), known), nothing_cached)
      assert (ready.to_cast | (c => (c.site.site_id, c.tests))) == [("s3", ["test/a_test.exs:3"])]

      # Line 7 only the failing test reaches; line 9 nothing does. Neither
      # is cast, and they are not the same thing to tell a reader.
      assert (ready.no_coverage | (.site_id)) == ["s7", "s9"]
      assert known.only_theirs == [place_of("lib/a.ex", 7)]
    }
  }
}

test "a suite in which nothing passes is still refused, in the kalku's words" {
  match learnt("red_none_pass.ndjson") {
    Ok(_) -> {
      assert false
    }
    Err(why) -> {
      assert is_some(index_of(why, "2 test(s), and none of it passes"))
      assert is_some(index_of(why, "the build is elsewhere"))
    }
  }
}

# Every test passed because none of them met the wekufe: code that runs
# once, as an application starts, does not run again where a wekufe is
# cast. A kalku that saw that says so, and it is not a hole anyone found.
test "a wekufe a kalku saw no test run is not a survivor, and its reason is kept" {
  match learnt("red_some_pass.ndjson") {
    Err(why) -> {
      assert why == "a suite with a test that passes should be measured"
    }
    Ok(known) -> {
      let ready = plan(inputs_for(asking_of("red_some_pass.ndjson"), known), nothing_cached)
      let unrun = Verdict {
        wekufe: "s3",
        outcome: NoCoverage,
        tests: ["test/a_test.exs:3"],
        said: Some("no test ran `A.init/1` while the wekufe was in it.")
      }
      let r =
        report_of(ready, Casting { verdicts: [unrun], failure: None, cancelled: false }, known)

      assert r.survivors == []
      assert r.counts.survived == 0
      assert r.counts.no_coverage == 3
      assert (r.troubles | (t => (t.wekufe, t.outcome, t.said)))
        == [("s3", NoCoverage, Some("no test ran `A.init/1` while the wekufe was in it."))]

      # It was cast and answered for, so the run did not stop short.
      assert r.planned == 0
      let text = human(r)
      assert is_some(index_of(text, "what could not be measured:"))
      assert is_some(index_of(text, "no test ran `A.init/1` while the wekufe was in it."))
      assert is_none(index_of(text, "PARTIAL"))
    }
  }
}
