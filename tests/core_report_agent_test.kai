import encoding.json
import kalku.wire.enums
import kalku.wire.shapes
import kalku.core.verdict
import kalku.core.gate
import kalku.core.report
import kalku.core.blaming
import kalku.core.report_agent
import kalku.core.report_json

const SOURCE : [String] = [
  "defmodule Parser do",
  "  defp next_token(s, i) when i >= 0 do",
  "    case String.at(s, i) do",
  "      nil -> :eof",
  "      c -> {c, i + 1}",
  "    end",
  "  end",
  "end"
]

fn lines_of(file: String) : [String] = if file == "lib/parser.ex" { SOURCE } else { [] }

fn survivor(file: String, line: Int, spell: Spell, tests: [String]) : Survivor = Survivor {
  site: Site {
    site_id: "c1f3",
    file: file,
    enclosing: Some("Parser.next_token/2"),
    ordinal: None,
    span: Span { start: Position { line: line, col: 7, byte: 0 }, end: None },
    spell: spell,
    original: Some(">="),
    replacement: ">",
    reload: ModuleOnly
  },
  tests: tests,
  chosen: true
}

fn report_of(survivors: [Survivor], counts: Counts) : Report = Report {
  counts: counts,
  planned: 0,
  survivors: survivors,
  on_changed_lines: 0,
  suppressions: SuppressionChanges {
    equivalent_added: 0,
    exclude_added: [],
    exclude_calls_added: []
  },
  troubles: [],
  skipped: [],
  uncovered: [],
  blockers: [],
  left_out: nobody_left_out(),
  withheld: None,
  shard: None
}

fn one() : Counts = tally([Cast(Killed), Cast(Survived)])

fn first_line(text: String) : String = head(lines(text)).unwrap_or("")

fn last_line(text: String) : String = last(lines(text)).unwrap_or("")

fn field(line: String, name: String) : JsonValue = match json_decode(line) {
  Some(v) -> get(v, name)
  None -> JNull
}

fn has(text: String, needle: String) : Bool = is_some(index_of(text, needle))

fn where_of(line: String) : String = match as_string(field(line, "file")) {
  Some(file) ->
    "#{file}:#{as_int(field(line, "line")).unwrap_or(0)}:#{as_string(field(line, "spell")).unwrap_or("")}"
  None -> "summary"
}

# Everything the agent needs to write the killing test, without opening
# a file: where it is, what changed, what already covers it, what to do.
test "a survivor carries what it takes to close the hole" {
  let out = agent(
    report_of([survivor("lib/parser.ex", 2, Compare, ["test/parser_test.exs:18"])], one()),
    lines_of
  )
  let line = first_line(out)

  assert field(line, "wekufe") == JStr("c1f3")
  assert field(line, "file") == JStr("lib/parser.ex")
  assert field(line, "line") == JNum(2)
  assert field(line, "spell") == JStr("compare")
  assert field(line, "enclosing") == JStr("Parser.next_token/2")
  assert field(line, "original") == JStr(">=")
  assert field(line, "replacement") == JStr(">")
  assert field(line, "covering_tests") == JArr([JStr("test/parser_test.exs:18")])
  assert field(line, "covering_count") == JNum(1)
  assert has(line, "boundary where the two sides are equal")
}

# A field kalku does not know is left out. An agent reading `null` learns
# nothing the absence did not already tell it, and pays tokens for it.
test "what the kalku does not know is absent, never null" {
  let bare = Survivor {
    site: Site {
      site_id: "b1",
      file: "lib/other.ex",
      enclosing: None,
      ordinal: None,
      span: Span { start: Position { line: 1, col: 1, byte: 0 }, end: None },
      spell: Arm,
      original: None,
      replacement: "",
      reload: ModuleOnly
    },
    tests: [],
    chosen: true
  }
  let line = first_line(agent(report_of([bare], one()), lines_of))

  assert not has(line, "null")
  assert not has(line, "enclosing")
  assert not has(line, "original")
  assert not has(line, "covering_tests")
  assert not has(line, "covering_count")
  assert not has(line, "context")
  assert field(line, "hint") != JNull
}

# Shared indentation is noise an agent pays for by the token.
test "context is the lines around the site, without the indentation they share" {
  let line = first_line(agent(report_of([survivor("lib/parser.ex", 4, Arm, [])], one()), lines_of))

  assert field(line, "context")
    == JArr([
      JStr("defp next_token(s, i) when i >= 0 do"),
      JStr("  case String.at(s, i) do"),
      JStr("    nil -> :eof"),
      JStr("    c -> {c, i + 1}"),
      JStr("  end")
    ])
}

test "a file the reader cannot answer for travels without context" {
  let line = first_line(agent(report_of([survivor("lib/missing.ex", 2, Arm, [])], one()), lines_of))
  assert not has(line, "context")
}

# Same input, same bytes: an agent that re-runs a report should see a
# diff only where the code changed.
test "survivors come out in a settled order" {
  let out = agent(
    report_of(
      [
        survivor("lib/b.ex", 10, Arm, []),
        survivor("lib/a.ex", 100, Arm, []),
        survivor("lib/a.ex", 9, Negate, []),
        survivor("lib/a.ex", 9, Arm, [])
      ],
      one()
    ),
    lines_of
  )

  assert (lines(out) | where_of)
    == ["lib/a.ex:9:arm", "lib/a.ex:9:negate", "lib/a.ex:100:arm", "lib/b.ex:10:arm", "summary"]
}

test "the summary closes the report, with the score and what to exit with" {
  let out = agent(report_of([survivor("lib/parser.ex", 2, Compare, [])], one()), lines_of)
  let summary = last(lines(out)).unwrap_or("")

  assert field(summary, "summary") == JBool(true)
  assert field(summary, "score") == JReal(0.5)
  assert field(summary, "survivors_on_changed_lines") == JNum(0)
  assert field(summary, "exit") == JNum(0)
  assert get(field(summary, "counts"), "survived") == JNum(1)
}

# A score that does not exist is absent, not zero: nothing could have
# been killed, and zero would read as everything survived.
test "a run with nothing to kill reports no score at all" {
  let summary = last(lines(agent(report_of([], tally([Cast(Timeout)])), lines_of))).unwrap_or("")

  assert field(summary, "score") == JNull
  assert not has(summary, "score")
}

# A change that hid nothing costs an agent no tokens to learn it.
test "suppressions travel only when a change made some" {
  let quiet = last(lines(agent(report_of([], one()), lines_of))).unwrap_or("")
  assert not has(quiet, "suppression_changes")

  let noisy = Report {
    ...report_of([], one()),
    suppressions: SuppressionChanges {
      equivalent_added: 2,
      exclude_added: ["lib/gen/**"],
      exclude_calls_added: []
    }
  }
  let loud = last(lines(agent(noisy, lines_of))).unwrap_or("")

  assert get(field(loud, "suppression_changes"), "equivalent_added") == JNum(2)
  assert get(field(loud, "suppression_changes"), "exclude_added") == JArr([JStr("lib/gen/**")])
  assert not has(loud, "exclude_calls_added")
}

# An agent that cannot tell a hole from a wekufe that never compiled will
# write a test for the second and learn nothing from it.
test "a wekufe that produced nothing to score travels with its reason" {
  let troubled = Report {
    ...report_of([], one()),
    troubles: [
      Trouble {
        wekufe: "lib/a.ex:42:compare",
        at: None,
        outcome: CompileError,
        said: Some("error: undefined function f/1")
      }
    ]
  }
  let line = head(lines(agent(troubled, lines_of))).unwrap_or("")

  assert field(line, "wekufe") == JStr("lib/a.ex:42:compare")
  assert field(line, "outcome") == JStr("compile_error")
  assert field(line, "message") == JStr("error: undefined function f/1")
}

# An agent told a score and not told which files it leaves out will think the
# file is clean and stop looking at it.
test "a file that was not searched travels as a line of its own, and in the JSON" {
  let skipped = Report {
    ...report_of([], one()),
    skipped: [Skipped { file: "lib/b.ex", reason: "parse_error", message: "line 3" }]
  }
  let line = "{\"skipped\":\"lib/b.ex\",\"reason\":\"parse_error\",\"message\":\"line 3\"}"

  assert contains(lines(agent(skipped, _f => [])), line)
  assert has_text(
    json(skipped, 2),
    "\"skipped\":[{\"file\":\"lib/b.ex\",\"reason\":\"parse_error\",\"message\":\"line 3\"}]"
  )
  assert has_text(json(report_of([], one()), 0), "\"skipped\":[]")
}

fn has_text(text: String, needle: String) : Bool = is_some(index_of(text, needle))

# A line the whole suite reaches is covered by every test in it. With a
# thousand tests that was tens of kilobytes per survivor, and a run of twenty
# came to more than a host takes as one tool result.
test "an agent gets the first few covering tests and how many there are in all" {
  let many = enumerate(repeat(0, 1200)) | (i => "tests/t_#{i.fst}.rs::t")
  let line =
    first_line(agent(report_of([survivor("lib/parser.ex", 2, Compare, many)], one()), lines_of))

  assert field(line, "covering_tests")
    == JArr(take(many, COVERING_SHOWN) | (t => JStr(t)))
  assert field(line, "covering_count") == JNum(1200)
  assert length(line) < 2000
}

# Where coverage was not measured the whole suite judged the wekufe, and its
# first five tests are no nearer the site than its last: listed as the tests
# that cover the line, they sent an agent to read files that never touch it.
test "an agent is not told the whole suite covers the line" {
  let suite = enumerate(repeat(0, 105)) | (i => "test/t_#{i.fst}_test.exs:3")
  let judged = Survivor { ...survivor("lib/parser.ex", 2, Compare, suite), chosen: false }
  let line = first_line(agent(report_of([judged], one()), lines_of))

  assert field(line, "judged_by_whole_suite") == JNum(105)
  assert not has(line, "covering_tests")
  assert not has(line, "covering_count")
}

# An agent that reads a score and not which tests stood behind it takes a
# suite with failing tests for one that judged.
test "an agent is told which tests a run went on without" {
  let r = Report {
    ...report_of([], one()),
    left_out: LeftOut {
      tests: [Failure { test_id: "test/ssl_test.exs:120", message: "boom" }],
      differences: ["the build is elsewhere"],
      sites: []
    }
  }
  let summary = last_line(agent(r, lines_of))

  assert field(summary, "left_out") == JArr([JStr("test/ssl_test.exs:120")])
  assert field(summary, "differences") == JArr([JStr("the build is elsewhere")])
  assert not has(last_line(agent(report_of([], one()), lines_of)), "left_out")
}

# "The whole suite" with no reason leaves an agent looking for the test to
# extend among all of them, and for the cause nowhere.
test "an agent is told why no survivor names the tests that reach it" {
  let r = Report { ...report_of([], one()), withheld: Some("a line no test is credited with") }
  let summary = last_line(agent(r, lines_of))

  assert field(summary, "coverage_withheld") == JStr("a line no test is credited with")
  assert not has(last_line(agent(report_of([], one()), lines_of)), "coverage_withheld")
}
