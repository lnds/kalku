import kalku.core.setting_up
import kalku.version

fn elixir() : Known = Known {
  language: "elixir",
  marker: "mix.exs",
  also: [],
  summon: "",
  outside: "",
  sources: [],
  tests: [],
  test_prefixes: [],
  test_suffixes: [],
  ignored: []
}

test "a project says what it is written in" {
  assert map(detect(["mix.exs", "README.md"]), .language) == Ok("elixir")
  assert map(detect(["kai.toml"]), .language) == Ok("kaikai")
}

# Two markers are two answers and no way to choose, which is a question
# for the owner rather than a coin to flip.
test "a project that looks like two is asked about, not guessed at" {
  assert detect(["mix.exs", "kai.toml"]) == Err(Ambiguous(["elixir", "kaikai"]))
  assert has(explain(Ambiguous(["elixir", "kaikai"])), "--lang")
}

test "a project with no marker says what it looked for" {
  assert detect(["README.md"]) == Err(Undetected)
  assert has(explain(Undetected), "mix.exs")
}

test "a language kalku has no kalku for is named, with what it does have" {
  assert named("cobol") == Err(Unknown("cobol"))
  assert has(explain(Unknown("cobol")), "elixir")
  assert map(named("Elixir"), .language) == Ok("elixir")
}

# The reni lives outside the tree it measures, named after the project so
# a person can find it.
test "the reni is outside the project and named after it" {
  assert reni_for("/tmp", "thing", "k") == "/tmp/kalku/thing-k"
  assert reni_for("/tmp/", "thing", "k") == "/tmp/kalku/thing-k"
}

# Two checkouts whose folders share a name — two clones, two worktrees —
# are two projects, and sharing a reni would mix one's artefacts into the
# other's run.
test "two projects whose folders share a name do not share a reni" {
  assert path_key("/home/u/a/kalku") != path_key("/home/u/b/kalku")
  assert length(path_key("/home/u/a/kalku")) == 12
}

test "one project has one key however its path is spelled" {
  let key = path_key("/home/u/kalku")

  assert path_key("/home/u/kalku/") == key
  assert path_key("/home/u/./kalku") == key
  assert path_key("/home//u/kalku") == key
}

test "what init writes says how to summon the kalku" {
  let plan = plan_for(elixir(), "/tmp/kalku/thing")

  assert has(plan.config, "language = \"elixir\"")
  assert has(plan.config, "summon = \".kalku/summon\"")
}

# `.kalku.toml` is shared through the repository and a reni is one
# machine's temporary directory. Writing the path in means the next
# person to clone the project reads a directory that is not theirs, and
# the run they get is not the run this file describes.
test "the reni is not written into the file everyone shares" {
  let plan = plan_for(elixir(), "/tmp/kalku/thing")

  assert not has(plan.config, "reni = ")
  assert has(plan.config, "/tmp/kalku/thing")
}

# A path dependency left uncompiled by `deps.compile` gets compiled by
# `mix kalku.serve` instead — while the protocol is already running, with
# mix announcing each one on stdout. Compiling twice up front costs
# nothing and keeps the channel clean.
test "the summoning compiles the project too, not only its dependencies" {
  let plan = plan_for(find(catalogue(), k => k.language == "elixir") |> unwrap_or(elixir()), "/r")

  assert has(plan.summoner, "mix deps.compile >&2")
  assert has(plan.summoner, "mix compile >&2")
  assert index_of(plan.summoner, "mix compile >&2")
    < index_of(plan.summoner, "exec mix kalku.serve")
}

# stdout carries the protocol: a summoning that let a build write there
# would have the worker banished for nonsense it never meant to write.
test "the summoning keeps the build off the protocol channel" {
  let plan = plan_for(find(catalogue(), k => k.language == "elixir") |> unwrap_or(elixir()), "/r")

  assert has(plan.summoner, ">&2")
  assert has(plan.summoner, "</dev/null")
  assert has(plan.summoner, "exec mix kalku.serve")
}

# The script goes into the repository, so a reni written into it is one
# machine's temporary directory travelling to every other machine — and,
# worse, one directory's: the reni is named after wherever `kalku init`
# was standing. A run knows its own reni and hands it over.
test "the reni is not written into the summoning either" {
  let plan = plan_for(
    find(catalogue(), k => k.language == "elixir") |> unwrap_or(elixir()),
    "/one/machine/reni"
  )

  assert not has(plan.summoner, "/one/machine/reni")
  assert has(plan.summoner, "RENI=\"${1:?")
  assert has(plan.summoner, "MIX_BUILD_PATH=\"$RENI/build\"")
  # rebar3 keeps a cache under each dependency it builds, in the project.
  assert has(plan.summoner, "REBAR_BASE_DIR=\"$MIX_BUILD_PATH/rebar3\"")
}

# Every summoning takes the reni first, whatever the language, so the
# kaikai side has one way of starting a kalku rather than one per kalku.
test "a summoning that needs no build path still takes the reni first" {
  let plan = plan_for(find(catalogue(), k => k.language == "kaikai") |> unwrap_or(elixir()), "/r")

  assert has(plan.summoner, "${1:?")
  assert has(plan.summoner, "shift")
  assert not has(plan.summoner, "/r")
}

# A kalku runs inside the project's runtime, so the project depends on
# it. kalku says so; it does not edit someone's build file behind them.
test "an Elixir project is told what to add, and only when it is missing" {
  let plan = plan_for(elixir(), "/r")

  assert is_some(plan.dependency)
  assert not depends_already(elixir(), "defmodule A do\n  defp deps, do: []\nend")
  assert depends_already(elixir(), "{:kalku_elixir, path: \"../kalku\"}")
}

fn has(text: String, needle: String) : Bool = is_some(index_of(text, needle))

fn mix_exs() : String = """
defmodule Thing.MixProject do
  use Mix.Project

  def project do
    [app: :thing, version: "0.1.0", deps: deps()]
  end

  defp deps do
    [{:jason, "~> 1.4"}]
  end
end
"""

# The two halves are released together. A requirement any old kalku meets
# lets a lock file keep one this binary was never run against.
test "init requires the kalku of the binary that writes the requirement" {
  let elixir_plan =
    plan_for(find(catalogue(), k => k.language == "elixir") |> unwrap_or(elixir()), "/r")

  assert minor_of("0.14.6") == "0.14"
  assert minor_of("1.2.0") == "1.2"
  assert elixir_plan.dependency
    == Some("{:kalku_elixir, \"~> #{minor_of(VERSION)}\", only: :test, runtime: false}")
}

# The dependency goes inside the list `deps` returns, which is the shape
# every Mix project shares.
test "init declares the dependency in the build file" {
  let line = "{:kalku_elixir, \"~> 0.1\", only: :test, runtime: false}"
  let written = with_dependency(mix_exs(), line) |> unwrap_or("")

  assert has(written, line)
  assert has(written, "{:jason, \"~> 1.4\"}")
  assert index_of(written, "kalku_elixir") > index_of(written, "defp deps do")
  assert index_of(written, "kalku_elixir") < index_of(written, "\nend")
}

# An entry with nothing after it needs no comma, so what init writes reads
# as though a hand had written it.
test "an empty deps list gets an entry without a dangling comma" {
  let written = with_dependency("defp deps do\n    []\n  end\n", "{:k, \"~> 1\"}") |> unwrap_or("")

  assert has(written, "{:k, \"~> 1\"}")
  assert not has(written, "},")
}

# The file belongs to its owner, so the entry takes the shape the list
# already had rather than imposing one: a formatter finds nothing to
# reflow after init has been here.
test "the entry keeps the shape the list was written in" {
  let one = with_dependency("defp deps do\n    [{:jason, \"~> 1.4\"}]\n  end\n", "{:k, \"~> 1\"}")
  assert one == Ok("defp deps do\n    [{:k, \"~> 1\"}, {:jason, \"~> 1.4\"}]\n  end\n")

  let many = with_dependency(
    "defp deps do\n    [\n      {:jason, \"~> 1.4\"}\n    ]\n  end\n",
    "{:k, \"~> 1\"}"
  )
  assert many
    == Ok("defp deps do\n    [\n      {:k, \"~> 1\"},\n      {:jason, \"~> 1.4\"}\n    ]\n  end\n")
}

# Elixir takes `defp deps() do` as readily as `defp deps do`, and so does
# init.
test "a deps function written with parentheses gets the entry too" {
  let written =
    with_dependency("defp deps() do\n    [{:jason, \"~> 1.4\"}]\n  end\n", "{:k, \"~> 1\"}")
  assert written == Ok("defp deps() do\n    [{:k, \"~> 1\"}, {:jason, \"~> 1.4\"}]\n  end\n")
}

# Guessing at a build file that is not shaped like the others would be
# worse than saying so, because the guess edits somebody's code.
test "a build file init does not recognise is left alone, with a reason" {
  assert with_dependency("defmodule A do\nend\n", "{:k, \"~> 1\"}")
    == Err("no `deps do` with a list in it")
  assert with_dependency("defp deps do\n    [{:kalku_elixir, \"~> 0.1\"}]\n  end\n", "x")
    == Err("it already depends on kalku_elixir")
}

# `index_of` answers in bytes, so a build file with an accent anywhere
# before the list would be cut mid-character by an offset meant for
# codepoints — and the file would come out corrupted.
test "a build file with multibyte text survives the insertion" {
  let source = "# año\ndefp deps do\n    [{:jason, \"~> 1.4\"}]\n  end\n"
  let written = with_dependency(source, "{:k, \"~> 1\"}") |> unwrap_or("")

  assert has(written, "# año")
  assert has(written, "{:k, \"~> 1\"}")
  assert has(written, "{:jason, \"~> 1.4\"}")
}

# The summoning lives in the project for as long as the project does, so
# every fix to it reaches only the projects that run `init` again — and
# nothing ever told them to. The contract is how a run can tell.
test "a summoning says which contract it was written against" {
  let plan = plan_for(find(catalogue(), k => k.language == "elixir") |> unwrap_or(elixir()), "/r")

  assert has(plan.summoner, contract_line(SUMMON_CONTRACT))
  assert contract_of(plan.summoner) == Some(SUMMON_CONTRACT)
  assert summon_is_current(plan.summoner)
}

# A summoning written before rebar3's cache went into the reni compiles
# the project's dependencies with rebar3 writing under `deps/`, in the
# user's tree. It says the contract it was written against, and a run
# refuses it rather than running it.
test "a summoning from before rebar3's cache went into the reni is refused" {
  let before =
    "#!/bin/sh\n# kalku-summon-contract: 1\nset -eu\nRENI=\"$1\"\nMIX_ENV=test\nMIX_BUILD_PATH=\"$RENI/build\"\nexport MIX_ENV MIX_BUILD_PATH\nmix deps.compile >&2 </dev/null\nmix compile >&2 </dev/null\nexec mix kalku.serve \"$@\"\n"

  assert contract_of(before) == Some(1)
  assert not summon_is_current(before)
}

test "an Elixir summoning keeps rebar3's cache in the reni" {
  let plan = plan_for(find(catalogue(), k => k.language == "elixir") |> unwrap_or(elixir()), "/r")

  assert has(plan.summoner, "REBAR_BASE_DIR=\"$MIX_BUILD_PATH/rebar3\"")
}

# A first run on a project with many dependencies spent most of its time
# compiling them again in the reni. It starts from a copy of what the
# project built for its tests, and a copy is all: a link would let the run
# write into the project's own build.
test "an Elixir summoning starts the reni's build from a copy of the project's" {
  let plan = plan_for(find(catalogue(), k => k.language == "elixir") |> unwrap_or(elixir()), "/r")

  assert has(plan.summoner, "cp -RL \"_build/test/lib/$name\" \"$MIX_BUILD_PATH/lib/$name\"")
  assert has(plan.summoner, "if [ ! -d \"$MIX_BUILD_PATH/lib\" ]")
  assert not has(plan.summoner, "ln -s")
}

test "every language's summoning declares one" {
  each(catalogue(), k => {
    let plan = plan_for(k, "/r")
    assert summon_is_current(plan.summoner)
  })
}

# A script from before the contract existed, and one from a contract this
# kalku no longer speaks, are both refused rather than run and puzzled over.
test "a summoning from an older kalku is not current" {
  assert not summon_is_current("#!/bin/sh\nexec mix kalku.serve\n")
  assert not summon_is_current("#!/bin/sh\n# kalku-summon-contract: 0\n")
  assert contract_of("#!/bin/sh\n") == None
}

test "a Cargo project is Rust, and its summoning starts the Rust kalku" {
  assert map(detect(["Cargo.toml", "README.md"]), .language) == Ok("rust")
  let plan = plan_for(named("rust") |> unwrap_or(elixir()), "/r")
  assert has(plan.config, "language = \"rust\"")
  assert has(plan.summoner, "exec kalku-rust")
  assert plan.dependency == None
  assert starts_with(plan.summoner, "#!/bin/sh")
}

# A repository with a Rust crate beside another project's marker is two
# answers, and the owner is asked rather than a coin flipped.
test "a Cargo.toml beside another marker is ambiguous" {
  assert detect(["Cargo.toml", "mix.exs"]) == Err(Ambiguous(["elixir", "rust"]))
}

fn of(language: String) : Known = named(language) |> unwrap_or(elixir())

test "a source file is the language's own, outside its suite and its build" {
  assert is_source_of(of("elixir"), "lib/thing.ex")
  assert is_source_of(of("elixir"), "apps/billing/lib/thing.ex")
  assert is_source_of(of("rust"), "src/lib.rs")
  assert is_source_of(of("rust"), "crates/core/src/sites.rs")
  assert is_source_of(of("kaikai"), "kalku/core/gate.kai")
  assert is_source_of(of("kaikai"), "main.kai")
}

# The oracle is not what is measured.
test "tests and what a build leaves are not sources" {
  assert not is_source_of(of("elixir"), "test/support/helper.ex")
  assert not is_source_of(of("elixir"), "deps/jason/lib/jason.ex")
  assert not is_source_of(of("rust"), "tests/pipe.rs")
  assert not is_source_of(of("rust"), "target/debug/build/x/out.rs")
  assert not is_source_of(of("kaikai"), "tests/gate_test.kai")
  assert not is_source_of(of("kaikai"), "kalku/core/gate_test.kai")
}

test "another language's files are not this one's" {
  assert not is_source_of(of("rust"), "lib/thing.ex")
  assert not is_source_of(of("elixir"), "src/lib.rs")
  assert not is_source_of(of("rust"), "README.md")
}

# A directory called `test` holds a suite; a file called `test_utils` does not.
test "a path is under a test directory by its directories, not its file name" {
  assert not is_source_of(of("elixir"), "lib/billing/test/fixture.ex")
  assert is_source_of(of("elixir"), "lib/billing/test_utils.ex")
  assert is_test_of(of("elixir"), "test/billing_test.exs")
  assert is_test_of(of("elixir"), "test/test_helper.exs")
  assert is_test_of(of("rust"), "tests/pipe.rs")
  assert is_test_of(of("kaikai"), "adapters/kaikai/tests/kalku_test.kai")
  assert not is_test_of(of("elixir"), "lib/billing.ex")
  assert not is_test_of(of("elixir"), "deps/foo/test/foo_test.exs")
}

test "a Python project is told by any of the files that mean Python, and runs in its own interpreter" {
  assert map(detect(["pyproject.toml", "README.md"]), .language) == Ok("python")
  assert map(detect(["setup.py"]), .language) == Ok("python")
  assert map(detect(["requirements.txt", "src"]), .language) == Ok("python")
  let plan = plan_for(of("python"), "/r")
  assert has(plan.config, "language = \"python\"")
  assert has(plan.config, "# memory_limit_mb = 8192")
  assert has(plan.summoner, "APP=\"$(command -v kalku-python)\"")
  assert has(plan.summoner, "kalku-python is not on PATH")
  assert has(plan.summoner, "exec \"$PY\" \"$APP\"")
  assert has(plan.summoner, ".venv/bin/python")
  assert summon_is_current(plan.summoner)
  assert starts_with(plan.summoner, "#!/bin/sh")
}

test "a Maven or a Gradle project is Java, and is summoned on its own JDK with nothing built on the way up" {
  assert map(detect(["pom.xml", "src", "README.md"]), .language) == Ok("java")
  assert map(detect(["build.gradle", "settings.gradle", "src"]), .language) == Ok("java")
  assert map(detect(["build.gradle.kts"]), .language) == Ok("java")
  assert map(detect(["pom.xml", "build.gradle"]), .language) == Ok("java")
  let plan = plan_for(of("java"), "/r")
  assert has(plan.config, "language = \"java\"")
  assert has(plan.summoner, "exec kalku-java \"$@\"")
  assert has(plan.summoner, "kalku-java is not on PATH")
  assert has(plan.summoner, "KALKU_JAVA")
  assert not has(plan.summoner, "mvn ")
  assert summon_is_current(plan.summoner)
  assert starts_with(plan.summoner, "#!/bin/sh")
  assert plan.dependency == None
}

test "a Go module is told by its go.mod, and summoned with nothing built on the way up" {
  assert map(detect(["go.mod", "go.sum", "main.go"]), .language) == Ok("go")
  let plan = plan_for(of("go"), "/r")
  assert has(plan.config, "language = \"go\"")
  assert has(plan.summoner, "exec kalku-go \"$@\"")
  assert has(plan.summoner, "kalku-go is not on PATH")
  assert not has(plan.summoner, "go build")
  assert not has(plan.summoner, "go test ")
  assert summon_is_current(plan.summoner)
  assert starts_with(plan.summoner, "#!/bin/sh")
  assert plan.dependency == None
}

# Go keeps a package's tests beside its code, known by their suffix alone;
# `testdata` is never built, and `vendor` is someone else's code.
test "Go sources are .go files that are not tests, testdata or vendored" {
  let go = of("go")
  assert is_source_of(go, "parser.go")
  assert is_source_of(go, "internal/lexer/scan.go")
  assert is_source_of(go, "cmd/tool/test.go")
  assert not is_source_of(go, "parser_test.go")
  assert not is_source_of(go, "internal/lexer/testdata/input.go")
  assert not is_source_of(go, "vendor/github.com/x/y/y.go")
  assert not is_source_of(go, "go.mod")
  assert is_test_of(go, "internal/lexer/scan_test.go")
  assert not is_test_of(go, "internal/lexer/scan.go")
}

# A tsconfig.json, and not a package.json: a project in another language
# often keeps one at its root for its tooling, and would become ambiguous.
test "a TypeScript project is told by its tsconfig.json, and summoned with nothing built on the way up" {
  assert map(detect(["package.json", "tsconfig.json", "src"]), .language) == Ok("typescript")
  assert map(detect(["go.mod", "package.json"]), .language) == Ok("go")
  let plan = plan_for(of("typescript"), "/r")
  assert has(plan.config, "language = \"typescript\"")
  assert has(plan.summoner, "exec kalku-typescript \"$@\"")
  assert has(plan.summoner, "kalku-typescript is not on PATH")
  assert not has(plan.summoner, "npm ")
  assert summon_is_current(plan.summoner)
  assert starts_with(plan.summoner, "#!/bin/sh")
  assert plan.dependency == None
}

# A test file is known by its suffix or by the directory it is kept in, with
# the helpers beside it, and node_modules and what a build leaves are someone
# else's.
test "TypeScript and JavaScript sources are the files outside the suite, node_modules and a build" {
  let ts = of("typescript")
  assert is_source_of(ts, "src/parser.ts")
  assert is_source_of(ts, "src/view.tsx")
  assert is_source_of(ts, "lib/index.mjs")
  assert is_source_of(ts, "src/testing.ts")
  assert not is_source_of(ts, "src/parser.test.ts")
  assert not is_source_of(ts, "src/view.spec.tsx")
  assert not is_source_of(ts, "src/__tests__/parser.ts")
  assert not is_source_of(ts, "test/helpers.ts")
  assert not is_source_of(ts, "tests/fixtures/input.ts")
  assert not is_source_of(ts, "node_modules/vitest/index.js")
  assert not is_source_of(ts, "dist/index.js")
  assert not is_source_of(ts, "package.json")
  assert is_test_of(ts, "test/calc.test.ts")
  assert not is_test_of(ts, "src/calc.ts")
}

test "a CMake project that asks for C++ is C++, and summoned with nothing built on the way up" {
  let markers = ["CMakeLists.txt", "src", "include"]
  assert map(detect_cmake(markers, "project(calc CXX)", []), .language) == Ok("cpp")
  assert detect_cmake(["CMakeLists.txt", "pyproject.toml"], "project(calc CXX)", [])
    == Err(Ambiguous(["python", "cpp"]))
  let plan = plan_for(of("cpp"), "/r")
  assert has(plan.config, "language = \"cpp\"")
  assert has(plan.summoner, "exec kalku-cpp \"$@\"")
  assert has(plan.summoner, "kalku-cpp is not on PATH")
  assert not has(plan.summoner, "cmake --build")
  assert summon_is_current(plan.summoner)
  assert starts_with(plan.summoner, "#!/bin/sh")
  assert plan.dependency == None
}

# C++ keeps its suite in a directory of its own or names a test after its
# code; a build tree and other people's code are neither.
test "C++ sources and headers are the files outside the suite, a build tree and vendored code" {
  let cpp = of("cpp")
  assert is_source_of(cpp, "src/parser.cpp")
  assert is_source_of(cpp, "include/acme/parser.hpp")
  assert is_source_of(cpp, "lib/ring.h")
  assert is_source_of(cpp, "src/testing.cc")
  assert not is_source_of(cpp, "src/parser_test.cpp")
  assert not is_source_of(cpp, "src/ParserTest.cpp")
  assert not is_source_of(cpp, "tests/parser.cpp")
  assert not is_source_of(cpp, "test/helpers.hpp")
  assert not is_source_of(cpp, "src/test_parser.cpp")
  assert not is_source_of(cpp, "build/generated/version.hpp")
  assert not is_source_of(cpp, "third_party/fmt/format.h")
  assert not is_source_of(cpp, "CMakeLists.txt")
  assert is_test_of(cpp, "tests/parser_test.cpp")
  assert not is_test_of(cpp, "src/parser.cpp")
}

# A CMakeLists.txt marks both languages, so what it asks for decides, and
# the same kalku is summoned either way.
test "a CMake project that asks for C alone is C, measured by the C and C++ kalku" {
  let markers = ["CMakeLists.txt", "src", "include"]
  assert map(detect_cmake(markers, "project(calc C)", []), .language) == Ok("c")
  assert map(detect_cmake(markers, "project(calc)", ["./src/calc.c"]), .language) == Ok("c")
  assert map(detect_cmake(markers, "project(calc)", ["./src/calc.cc"]), .language) == Ok("cpp")
  assert detect_cmake(markers, "project(kernels CUDA)", []) == Err(Undetected)
  assert detect(["CMakeLists.txt"]) == Err(Ambiguous(["cpp", "c"]))
  let plan = plan_for(of("c"), "/r")
  assert has(plan.config, "language = \"c\"")
  assert has(plan.summoner, "exec kalku-cpp \"$@\"")
  assert summon_is_current(plan.summoner)
  assert has(explain(Undetected), "or CMakeLists.txt")
  assert not has(explain(Undetected), "CMakeLists.txt or CMakeLists.txt")
}

# A C++ project with C in it has its C measured too: each file is read with
# its own compile command.
test "C sources are the .c files outside the suite, in a C project and in a C++ one" {
  let c = of("c")
  assert is_source_of(c, "src/calc.c")
  assert is_source_of(c, "include/calc.h")
  assert not is_source_of(c, "src/calc.cpp")
  assert not is_source_of(c, "tests/calc.c")
  assert not is_source_of(c, "test/test_ring.c")
  assert not is_source_of(c, "src/calc_test.c")
  assert not is_source_of(c, "vendor/unity/unity.c")
  assert not is_source_of(c, "build/CMakeFiles/feature.c")
  assert is_test_of(c, "test/test_ring.c")
  assert is_test_of(c, "test.c")
  assert not is_source_of(c, "fuzzing/afl.c")
  assert is_source_of(c, "src/attest.c")
  assert is_source_of(of("cpp"), "src/legacy.c")
}

# Maven keeps the suite apart by directory, and a test class is known by its name too.
test "Java sources are .java files outside the suite, which is named by directory or by suffix" {
  let java = of("java")
  assert is_source_of(java, "src/main/java/com/acme/Parser.java")
  assert is_source_of(java, "src/main/java/com/acme/Testing.java")
  assert not is_source_of(java, "src/test/java/com/acme/ParserTest.java")
  assert not is_source_of(java, "src/test/java/com/acme/Fixtures.java")
  assert not is_source_of(java, "src/main/java/com/acme/ParserTest.java")
  assert not is_source_of(java, "src/main/java/com/acme/ParserIT.java")
  assert not is_source_of(java, "src/main/resources/app.properties")
  assert not is_source_of(java, "target/generated-sources/annotations/com/acme/Gen.java")
  assert not is_source_of(
    java,
    "build/generated/sources/annotationProcessor/java/main/com/acme/Gen.java"
  )
  assert is_source_of(java, "app/src/main/java/com/acme/App.java")
  assert is_test_of(java, "src/test/java/com/acme/ParserTest.java")
  assert not is_test_of(java, "src/main/java/com/acme/Parser.java")
}

# A Rust crate that ships Python bindings has both: asked, not guessed.
test "a pyproject.toml beside a Cargo.toml is ambiguous" {
  assert detect(["Cargo.toml", "pyproject.toml"]) == Err(Ambiguous(["rust", "python"]))
}

test "Python sources are .py files outside the suite, which is named by directory, prefix or suffix" {
  let python = of("python")
  assert is_source_of(python, "src/pkg/core.py")
  assert is_source_of(python, "pkg/utils.py")
  assert is_source_of(python, "pkg/testing_utils.py")
  assert not is_source_of(python, "tests/test_core.py")
  assert not is_source_of(python, "pkg/test_core.py")
  assert not is_source_of(python, "pkg/core_test.py")
  assert not is_source_of(python, "pkg/conftest.py")
  assert not is_source_of(python, "src/pkg/core.pyi")
  assert not is_source_of(python, ".venv/lib/python3.13/site-packages/x.py")
  assert not is_source_of(python, "build/lib/pkg/core.py")
  assert is_test_of(python, "tests/test_core.py")
  assert is_test_of(python, "tests/helpers/data.py")
  assert is_test_of(python, "pkg/test_core.py")
  assert is_test_of(python, "conftest.py")
  assert not is_test_of(python, "pkg/core.py")
}

# A project nobody set up does not have the kalku among its dependencies,
# and adding it is what a run must not do. So its summoning says nothing
# of the project's build file and fetches the kalku itself, in the version
# of the kalku that wrote it: any other is a kalku this one was not tested
# against.
test "the summoning for a project nobody set up brings the kalku with it" {
  let known = find(catalogue(), k => k.language == "elixir") |> unwrap_or(elixir())
  let script = outside_text(known)

  assert summon_is_current(script)
  assert has(script, "mix hex.package fetch kalku_elixir #{VERSION} --unpack")
  assert has(script, "$RENI/kalku_elixir-#{VERSION}}")
  assert has(script, "MIX_BUILD_PATH=\"$RENI/build\"")
  assert has(script, ">&2 </dev/null")
  assert not has(script, "mix deps.get")
  assert index_of(script, "mix compile >&2 </dev/null") < index_of(script, "exec sh")
}

# Only a kalku that lives inside the project's runtime needs another way
# in. The rest are programs beside kalku, summoned the same way whether
# the project was set up or not.
test "a kalku that is its own program is summoned the same way set up or not" {
  assert all(catalogue() |? (k => k.language != "elixir"), k => k.outside == k.summon)
}
