import actor
import time
import fs.file
import os.process as proc
import kalku.wire.enums
import kalku.wire.envelope
import kalku.wire.shapes
import kalku.wire.kalku_msg
import kalku.orchestrator.kalku_proc
import kalku.orchestrator.telling

# Every test here talks to a real child process, so every wait has a
# deadline: a broken orchestrator fails the suite instead of hanging it.
const PATIENCE : Duration = seconds(5)

# What a kalku that is never going to answer is given before we say so.
const BRIEF : Duration = millis(300)

const FAKE : String = "./tests/fake_kalku/fake_kalku"

fn spec(script: String) : KalkuSpec =
  KalkuSpec {
    life: Life { worker: 0, summons: 1 },
    command: FAKE,
    args: ["tests/fixtures/scripts/#{script}"]
  }

# The bug this reproduces: a kalku is reached through a launcher, so the
# process doing the work is a grandchild. A shell that outlives its own
# child is that shape with nothing else in it — `mix` is one, and so is
# every asdf shim between here and the runtime.
fn launcher_of(pidfile: String) : KalkuSpec = KalkuSpec {
  life: Life { worker: 0, summons: 1 },
  command: "/bin/sh",
  args: ["-c", "sleep 60 & echo $! > #{pidfile}; wait"]
}

# The same, with the grandchild in a process group of its own, which is what
# cargo is to the Rust kalku and what a forked child is to the Python one:
# a kill aimed at the kalku's group does not reach it.
fn launcher_apart(pidfile: String) : KalkuSpec = KalkuSpec {
  life: Life { worker: 0, summons: 1 },
  command: "/bin/sh",
  args: ["-c", "set -m; sleep 60 & echo $! > #{pidfile}; wait"]
}

# `file.read` panics on a file that is not there, and a launcher that never
# wrote one is a test failure with a reason rather than a crash.
fn temp_under() : String / Env {
  let dir = Env.get("TMPDIR").unwrap_or("/tmp")
  if ends_with(dir, "/") { slice(dir, 0, length(dir) - 1) } else { dir }
}

# Two `kai test` runs at once share a TMPDIR, so the file is named after the
# process that owns it.
fn own_pid() : String / Process = match proc.pipe_errs("/bin/sh", ["-c", "echo $PPID"]) {
  Err(_) -> "0"
  Ok(child) -> {
    let out = match proc.read_stdout(child) {
      Ok(chunk) -> chunk
      Err(_) -> ""
    }
    let _ = proc.wait(child)
    trim(out)
  }
}

fn launched(pidfile: String) : Option[Int] / File =
  if file.exists(pidfile) { to_int(trim(file.read(pidfile))) } else { None }

fn still_running(pid: Int) : Bool / Process = match proc.kill(Child { pid: pid }, 0) {
  Ok(_) -> true
  Err(_) -> false
}

fn hello() : KalkuRequest = Hello(HelloMsg {
  version: 1,
  root: ".",
  reni: ".kalku",
  worker: 0,
  inline_limit_bytes: 65536,
  env: StrMap { entries: [] }
})

fn a_cast(wekufe: String) : KalkuRequest =
  Cast(CastMsg { wekufe: wekufe, site: a_site(), tests: ["test/arm_test.kai"] })

fn a_site() : Site = Site {
  site_id: "s1",
  file: "lib/a.kai",
  enclosing: Some("add"),
  ordinal: None,
  span: Span { start: Position { line: 12, col: 5, byte: 0 }, end: None },
  spell: Arm,
  original: Some("+"),
  replacement: "-",
  reload: ModuleOnly
}

# Whatever the kalku did next, as one line a test can assert on: a reply,
# a protocol error, a closed pipe, or silence.
fn next_within(patience: Duration) : String / Actor[OrchMsg] + Clock =
  match receive_timeout(patience) {
    None -> "silence"
    Some(Wire(_, Said(line))) -> match heard(line) {
      Ok(m) -> tell(m.body)
      Err(e) -> "protocol error: #{kind_name(e.kind)}"
    }
    Some(Wire(_, Closed)) -> "closed"
    Some(Wire(_, Unreadable(_))) -> "unreadable"
    # What a kalku wrote on stderr, and what is not from a kalku at all, is not its next
    # word: the wait goes on.
    Some(_) -> next_within(patience)
  }

fn next() : String / Actor[OrchMsg] + Clock = next_within(PATIENCE)

# A pipe that has ended says so in one of two ways, depending on whether the
# reader was reading when the process died or the reap closed it first.
fn pipe_ended(word: String) : String =
  if word == "closed" or word == "unreadable" { "pipe ended" } else { word }

fn tell(r: KalkuReply) : String {
  case Ready(m) -> "ready #{m.language} protocol #{m.version}"
  case CastDone(m) -> "cast_done #{outcome_name(m.outcome)}"
  case Prepared(_) -> "prepared"
  case Bye -> "bye"
  case other -> "#{other}"
}

fn listen_to(k: Kalku) : Unit / Process + Spawn + Actor[OrchMsg] {
  let me = Actor.self()
  let _reader = spawn_actor(() => read_loop(k, me))
  ()
}

fn ready_of(r: String) : Option[ReadyMsg] = match json_ready(r) {
  Ok(m) -> Some(m)
  Err(_) -> None
}

fn json_ready(line: String) : Result[ReadyMsg, ProtocolError] = match heard(line) {
  Ok(m) -> match m.body {
    Ready(r) -> Ok(r)
    _ -> fail(Invalid, "not a ready")
  }
  Err(e) -> Err(e)
}

test "a kalku is summoned, answers, and leaves of its own accord" {
  let told = untold(
    () => with_mailbox {
      match summon(spec("one_cast.ndjson")) {
        Err(e) -> [e]
        Ok(k) -> {
          listen_to(k)
          let _h = ask(k, 1, hello())
          let ready = next()
          let _p = ask(k, 9, Prepare)
          let prepared = next()
          let _c = ask(k, 2, a_cast("w1"))
          let outcome = next()
          let _s = ask(k, 3, Shutdown)
          let farewell = next()
          [ready, prepared, outcome, farewell, ending(reap(k))]
        }
      }
    }
  )
  assert told == ["ready fake protocol 1", "prepared", "cast_done killed", "bye", "exited 0"]
}

# A kalku holds the reni's build lock through whatever its launcher
# started, so a kill that reaches only the child leaves a lock nobody will
# release and the next run hangs at 0% CPU with no cause. Killing the
# group is what makes the promise in `security.md` true: a killed kalku
# leaves nothing behind.
test "killing a kalku kills what its launcher started, not just the launcher" {
  # Outside the repo, because a test that writes into the tree it measures
  # is the thing this project refuses everywhere else. The separator is
  # added here rather than assumed: macOS hands back a `TMPDIR` with a
  # trailing slash and Linux usually hands back nothing at all.
  let pidfile = "#{temp_under()}/kalku_grandchild_#{own_pid()}.pid"
  let outcome = untold(
    () => with_mailbox {
      match summon(launcher_of(pidfile)) {
        Err(e) -> Err(e)
        Ok(k) -> {
          sleep(BRIEF)
          match launched(pidfile) {
            None -> Err("the launcher never said what it started")
            Some(grandchild) -> {
              let before = still_running(grandchild)
              kill_now(k)
              sleep(BRIEF)
              # Said as words rather than a pair, which has no `Eq`, and
              # which would read as two booleans nobody can tell apart.
              Ok("alive before: #{show(before)}, after: #{show(still_running(grandchild))}")
            }
          }
        }
      }
    }
  )

  let _ = file.delete(pidfile)

  assert outcome == Ok("alive before: true, after: false")
}

test "killing a kalku kills what it started even in a group of its own" {
  let pidfile = "#{temp_under()}/kalku_apart_#{own_pid()}.pid"
  let outcome = untold(
    () => with_mailbox {
      match summon(launcher_apart(pidfile)) {
        Err(e) -> Err(e)
        Ok(k) -> {
          sleep(BRIEF)
          match launched(pidfile) {
            None -> Err("the launcher never said what it started")
            Some(grandchild) -> {
              let before = still_running(grandchild)
              kill_now(k)
              sleep(BRIEF)
              Ok("alive before: #{show(before)}, after: #{show(still_running(grandchild))}")
            }
          }
        }
      }
    }
  )

  let _ = file.delete(pidfile)

  assert outcome == Ok("alive before: true, after: false")
}

# A version this side cannot speak is refused by name: guessing at what a
# message means would produce numbers nobody can trust.
test "a kalku that speaks another protocol version is refused" {
  let told = untold(
    () => with_mailbox {
      match summon(spec("protocol_mismatch.ndjson")) {
        Err(e) -> [e]
        Ok(k) -> {
          listen_to(k)
          let _h = ask(k, 1, hello())
          let line = match receive_timeout(PATIENCE) {
            Some(Wire(_, Said(l))) -> l
            _ -> "nothing the kalku said"
          }
          let refusal = match ready_of(line) {
            Some(m) -> ready_refused(m).unwrap_or("accepted")
            None -> "undecodable"
          }
          kill_now(k)
          [refusal]
        }
      }
    }
  )
  # A kalku from the future means this binary is the old half, and the
  # refusal has to say which one to move: the two are installed apart.
  let refusal = match told {
    [only] -> only
    _ -> "#{told}"
  }
  assert is_some(index_of(refusal, "speaks protocol 99, this kalku speaks 1"))
  assert is_some(index_of(refusal, "brew upgrade kalku"))
}

# Garbage on stdout is a protocol error naming the line, not a silent skip:
# a kalku that writes noise is not one whose results can be believed.
test "a line that is not JSON is a protocol error, and the kalku is still reapable" {
  let told = untold(
    () => with_mailbox {
      match summon(spec("garbage.ndjson")) {
        Err(e) -> [e]
        Ok(k) -> {
          listen_to(k)
          let _h = ask(k, 1, hello())
          let ready = next()
          let _p = ask(k, 9, Prepare)
          let prepared = next()
          let _c = ask(k, 2, a_cast("w1"))
          let noise = next()
          kill_now(k)
          [ready, prepared, noise]
        }
      }
    }
  )
  assert told == ["ready fake protocol 1", "prepared", "protocol error: not_json"]
}

# A kalku that dies mid-cast closes its pipe; the wekufe it was casting is
# reported by the caller, never lost, and the exit status says what happened.
test "a kalku that crashes mid-cast closes its pipe and reaps with its code" {
  let told = untold(
    () => with_mailbox {
      match summon(spec("crash_mid_cast.ndjson")) {
        Err(e) -> [e]
        Ok(k) -> {
          listen_to(k)
          let _h = ask(k, 1, hello())
          let ready = next()
          let _p = ask(k, 9, Prepare)
          let prepared = next()
          let _c = ask(k, 2, a_cast("w1"))
          let end = next()
          [ready, prepared, end, ending(reap(k))]
        }
      }
    }
  )
  assert told == ["ready fake protocol 1", "prepared", "closed", "exited 7"]
}

# The last step of the escalation: a kalku deaf to `abort` answers nothing,
# so the deadline passes and the kill is what ends it.
test "a kalku that never answers is killed, and killing it leaves nothing behind" {
  let told = untold(
    () => with_mailbox {
      match summon(spec("deaf.ndjson")) {
        Err(e) -> [e]
        Ok(k) -> {
          listen_to(k)
          let _h = ask(k, 1, hello())
          let ready = next()
          let _p = ask(k, 9, Prepare)
          let prepared = next()
          let _c = ask(k, 2, a_cast("w1"))
          let hung = next_within(BRIEF)
          let _a = ask(k, 3, Abort(AbortMsg { cast: 2 }))
          let still_hung = next_within(BRIEF)
          kill_now(k)
          # The pipe ends, as a read error if the reap closed it under the
          # reader and as end of input if the death reached the reader first:
          # which of the two comes first is the scheduler's, and neither is a
          # kalku that lived. Waited for rather than snatched at: this test
          # asserts silence twice already, and a loaded machine that takes a
          # moment to deliver the reader's last word is not a kalku that lived.
          [ready, prepared, hung, still_hung, pipe_ended(next())]
        }
      }
    }
  )

  let expected = ["ready fake protocol 1", "prepared", "silence", "silence", "pipe ended"]
  # A failure here names what was received, which an assertion does not.
  let _ = if told == expected { () } else { Stderr.eprint("received #{told}") }
  assert told == expected
}
