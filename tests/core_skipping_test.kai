import encoding.json
import encoding.json_bind
import kalku.core.skipping
import kalku.wire.shapes

fn bad(file: String) : Skipped =
  Skipped { file: file, reason: "parse_error", message: "line 1", by_design: None }

test "a skipped file is told with its reason and what the kalku said" {
  assert skipped_line(bad("src/a.rs")) == "src/a.rs: parse_error: line 1"
}

# The run that read every file as skipped is the one that used to print
# `0 site(s) found` and nothing else.
test "a run whose every file was skipped cannot go on, and says which and why" {
  let why = nothing_usable(0, [bad("src/a.rs"), bad("src/b.rs")])
  assert why
    == Some(
      "no file could be searched for sites:\n  src/a.rs: parse_error: line 1\n  src/b.rs: parse_error: line 1"
    )
}

test "one file that yielded a site is enough to go on" {
  assert nothing_usable(3, [bad("src/a.rs")]) == None
}

test "no site and no file skipped is a project with nothing to mutate, not an error" {
  assert nothing_usable(0, []) == None
}

test "the gate hears of skipped files, naming them" {
  assert trouble_of([]) == None
  assert trouble_of([bad("src/a.rs"), bad("src/b.rs")])
    == Some(
      "2 file(s) could not be searched, so the score says nothing about them: src/a.rs, src/b.rs"
    )
}

fn left(file: String) : Skipped =
  Skipped { file: file, reason: "config", message: "configures the tools", by_design: Some(true) }

# A Jest config at the root of a TypeScript project is matched as a source
# file and left out by the kalku: no run could ever measure it.
test "a file left out by design does not reach the gate" {
  assert trouble_of([left("jest.config.cjs")]) == None
  assert trouble_of([left("jest.config.cjs"), bad("src/a.ts")])
    == Some("1 file(s) could not be searched, so the score says nothing about them: src/a.ts")
}

test "a kalku that does not say why it skipped a file is heard as one that could not search it" {
  let said = json_decode("{\"file\":\"src/a.ts\",\"reason\":\"config\",\"message\":\"m\"}")
    |> unwrap_or(JNull)
  assert skipped_of_json(said, "")
    == Ok(Skipped { file: "src/a.ts", reason: "config", message: "m", by_design: None })
}
