import kalku.wire.shapes
import kalku.core.shard

fn ids() : [String] = [1..200] | (n => "site-#{n}")

fn owned_by(index: Int, count: Int) : [String] = keep(ids(), index, count)

test "one shard owns everything" {
  assert owned_by(1, 1) == ids()
  assert shard_of("anything", 1) == 1
}

test "shards are disjoint and together cover the plan" {
  let parts = [1..4] | (i => owned_by(i, 4))
  assert length(concat(parts)) == length(ids())
  assert all(ids(), id => length(filter(concat(parts), other => other == id)) == 1)
}

test "the shard of a wekufe depends on its id, not on its place in the plan" {
  assert shard_of("site-7", 4) == shard_of("site-7", 4)
  assert sort(owned_by(2, 4)) == sort(keep(reverse(ids()), 2, 4))
}

test "a shard index is 1-based and within the count" {
  assert all(ids(), id => shard_of(id, 4) >= 1 and shard_of(id, 4) <= 4)
  assert valid(1, 4)
  assert valid(4, 4)
  assert not valid(0, 4)
  assert not valid(5, 4)
  assert not valid(1, 0)
}

test "the partition is even enough to be worth sharding" {
  let sizes = [1..4] | (i => length(owned_by(i, 4)))
  assert all(sizes, n => n > 25)
}

test "owns agrees with shard_of" {
  assert all(ids(), id => owns(id, shard_of(id, 3), 3))
  assert not any(ids(), id => owns(id, shard_of(id, 3) % 3 + 1, 3))
}

# A run with no sharding is `1/1`, which is the default every CI job that
# does not shard uses — the boundary most likely to be trusted untested.
test "one shard of one is a valid run, and so is the last shard of many" {
  assert valid(1, 1)
  assert valid(4, 4)
  assert valid(1, 4)
  assert not valid(0, 1)
  assert not valid(2, 1)
  assert not valid(5, 4)
}

# The three things sharding promises, as algebra rather than as sentences
# about 200 ids: every wekufe lands somewhere, nowhere twice, and the
# same place whoever asks.

check "every wekufe lands in a shard, and only in one" with id: String, n: Int {
  let count = 1 + abs(n) % 8
  let mine = filter([1..count], i => owns(id, i, count))
  length(mine) == 1
}

check "a shard index is within the count it was asked for" with id: String, n: Int {
  let count = 1 + abs(n) % 8
  shard_of(id, count) >= 1 and shard_of(id, count) <= count
}

check "the same id lands in the same shard, however often it is asked" with id: String {
  shard_of(id, 4) == shard_of(id, 4)
}

check "a shard of one owns everything" with id: String {
  owns(id, 1, 1)
}

# Sharding is on the path of every run that splits across CI jobs, and it
# hashes every wekufe id twice — once to place it, once to ask whether
# this shard owns it. Worth knowing what that costs before anyone is
# tempted to cache it.
bench "placing 200 wekufe in 4 shards" {
  [1..4] | (i => length(owned_by(i, 4)))
}

test "a part is read as `i/n`, and nothing else is one" {
  assert shard_named("2/4") == Some(Shard { index: 2, count: 4 })
  assert shard_named("1/1") == Some(Shard { index: 1, count: 1 })
  assert shard_named("0/4") == None
  assert shard_named("5/4") == None
  assert shard_named("2") == None
  assert shard_named("a/b") == None
  assert shard_named("1/2/3") == None
}

# A run that is not a shard owns every wekufe; one that is owns what
# `owns` says, so the parts of a count hold each wekufe once between them.
test "a run that is not a shard owns everything" {
  assert in_shard("s1", None)
  assert in_shard("s1", Some(Shard { index: 1, count: 2 }))
    != in_shard("s1", Some(Shard { index: 2, count: 2 }))
}
