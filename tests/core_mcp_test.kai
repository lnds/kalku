import encoding.json
import kalku.core.mcp

fn has(text: String, needle: String) : Bool = is_some(index_of(text, needle))

fn call(json: String) : Heard = asked_of(json).snd

fn tool_names() : [String] = match json_decode(tools(Some(1))) {
  None -> []
  Some(v) -> flat_map(as_arr(get(get(v, "result"), "tools")), named_tool)
}

fn as_arr(v: JsonValue) : [JsonValue] = match v {
  JArr(items) -> items
  _ -> []
}

fn named_tool(v: JsonValue) : [String] = match as_string(get(v, "name")) {
  Some(n) -> [n]
  None -> []
}

test "a host's first word is answered with what kalku is and speaks" {
  let hello = greeting(Some(1))

  assert has(hello, "\"jsonrpc\":\"2.0\"")
  assert has(hello, "\"protocolVersion\":\"#{PROTOCOL}\"")
  assert has(hello, "\"name\":\"kalku\"")
}

test "the methods a host uses are read, and anything else is said to be unknown" {
  assert call("{\"method\":\"initialize\",\"id\":1}") == Initialise
  assert call("{\"method\":\"tools/list\",\"id\":2}") == ListTools
  assert call("{\"method\":\"notifications/initialized\"}") == Notice
  assert call("{\"method\":\"resources/list\",\"id\":3}")
    == Garbled("no such method `resources/list`")
  assert call("not json") == Garbled("not JSON")
}

test "a tool call carries its tool, its wekufe and its reason" {
  let asked = call(
    "{\"method\":\"tools/call\",\"id\":4,\"params\":{\"name\":\"kalku_cast\",\"arguments\":{\"wekufe\":[\"w1\",\"w2\"],\"root\":\"/p\"}}}"
  )

  assert asked
    == CallTool(Call {
      tool: "kalku_cast",
      root: Some("/p"),
      wekufe: ["w1", "w2"],
      reason: "",
      limit: None,
      since: None,
      progress: None
    })
}

# A host may send one id as a string where another sends a list, and the
# files a run measures arrive under their own name.
test "one wekufe, many, or a list of files all read as what was named" {
  assert call(
    "{\"method\":\"tools/call\",\"params\":{\"name\":\"kalku_show\",\"arguments\":{\"wekufe\":\"w1\"}}}"
  )
    == CallTool(Call {
      tool: "kalku_show",
      root: None,
      wekufe: ["w1"],
      reason: "",
      limit: None,
      since: None,
      progress: None
    })
  assert call(
    "{\"method\":\"tools/call\",\"params\":{\"name\":\"kalku_run\",\"arguments\":{\"files\":[\"lib/a.ex\"]}}}"
  )
    == CallTool(Call {
      tool: "kalku_run",
      root: None,
      wekufe: ["lib/a.ex"],
      reason: "",
      limit: None,
      since: None,
      progress: None
    })
}

# The tools are the CLI's, and there is deliberately no tool that
# suppresses anything: an agent proposes, a person decides.
test "every tool an agent gets, and no tool that hides a hole" {
  let names = tool_names()

  assert names == ["kalku_run", "kalku_cast", "kalku_show", "kalku_propose_equivalent"]
  assert not any(names, n => has(n, "suppress") or has(n, "exclude") or has(n, "ignore"))
}

# What the proposal tool says about itself is the guardrail itself: a
# host shows this text to the agent before it decides to call it.
test "the proposal tool says it suppresses nothing" {
  assert has(tools(Some(1)), "suppresses nothing")
  assert has(tools(Some(1)), "for a person to review")
}

test "a tool that could not run is a result the agent sees, not a protocol error" {
  assert has(refused(Some(2), "never cast: w9"), "\"isError\":true")
  assert has(refused(Some(2), "never cast: w9"), "never cast: w9")
  assert has(answered(Some(2), "all killed"), "\"isError\":false")
  assert has(protocol_error(Some(3), "no method"), "\"error\"")
}

# `--since` is the mode an agent wants most: the survivors on the lines it
# just wrote. A run asked that way need not name a file.
test "a run can be narrowed to a change and to a number of wekufe" {
  assert call(
    "{\"method\":\"tools/call\",\"params\":{\"name\":\"kalku_run\",\"arguments\":{\"since\":\"main\",\"limit\":20}}}"
  )
    == CallTool(
      Call {
        tool: "kalku_run",
        root: None,
        wekufe: [],
        reason: "",
        limit: Some(20),
        since: Some("main"),
        progress: None
      }
    )
  assert has(tools(Some(1)), "\"since\"")
  assert has(tools(Some(1)), "\"limit\"")
}

# A host that closed the pipe has nobody left to read what a run finds.
test "a host that leaves while a run is going ends the run" {
  assert heard_mid_run_of_host(NO_MORE, "", Some(2)) == HostLeft
}

# Who this is and what it can do never wait for a run to end.
test "a host is answered mid-run for what does not need the kalku" {
  assert heard_mid_run_of_host(SAID, "{\"method\":\"tools/list\",\"id\":3}", Some(2))
    == ToldMidRun(tools(Some(3)))
  assert heard_mid_run_of_host(SAID, "{\"method\":\"initialize\",\"id\":1}", Some(2))
    == ToldMidRun(greeting(Some(1)))
  assert heard_mid_run_of_host(SAID, "{\"method\":\"notifications/initialized\"}", Some(2))
    == NothingToSay
}

# One set of kalku measures one thing at a time, and the host is told why.
test "a second tool is refused while a run is going, with the reason" {
  match heard_mid_run_of_host(
    SAID,
    "{\"method\":\"tools/call\",\"id\":9,\"params\":{\"name\":\"kalku_run\",\"arguments\":{\"files\":[\"a.ex\"]}}}",
    Some(2)
  ) {
    ToldMidRun(answer) -> {
      assert has(answer, "\"id\":9")
      assert has(answer, "\"isError\":true")
      assert has(answer, "one thing at a time")
    }
    other -> {
      assert other == NothingToSay
    }
  }
}

fn called_off(request: Int) : String =
  "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/cancelled\",\"params\":{\"requestId\":#{request},\"reason\":\"gave up\"}}"

# A host gives up on a call without leaving: the run it gave up on ends,
# and no other does.
test "a host that calls its call off ends that run, and only that one" {
  assert call(called_off(7)) == CalledOff(Some(7))
  assert heard_mid_run_of_host(SAID, called_off(7), Some(7)) == CallIsOff
  assert heard_mid_run_of_host(SAID, called_off(6), Some(7)) == NothingToSay
  assert heard_mid_run_of_host(SAID, called_off(7), None) == NothingToSay
}

fn with_token(token: String) : String =
  "{\"method\":\"tools/call\",\"id\":2,\"params\":{\"name\":\"kalku_run\",\"arguments\":{\"files\":[\"a.ex\"]},\"_meta\":{\"progressToken\":#{token}}}}"

# A host says it wants to hear of a call by giving it a token, a string or
# a number, and is answered with the one it gave.
test "a call says whether its host wants to hear how it is going" {
  match call(with_token("\"tok-1\"")) {
    CallTool(c) -> {
      assert c.progress == Some("\"tok-1\"")
    }
    other -> {
      assert other == Notice
    }
  }
  match call(with_token("41")) {
    CallTool(c) -> {
      assert c.progress == Some("41")
    }
    other -> {
      assert other == Notice
    }
  }
}

# A host counts a call that says nothing as dead. The count only rises;
# how far along the run is goes in the words.
test "a note of progress carries the host's own token and what the run is doing" {
  let note = progress_note("\"tok-1\"", 3, "baseline")

  assert has(note, "\"method\":\"notifications/progress\"")
  assert has(note, "\"progressToken\":\"tok-1\"")
  assert has(note, "\"progress\":3")
  assert has(note, "\"message\":\"baseline\"")
  assert not has(note, "\"id\"")
  assert has(progress_note("41", 1, "cast"), "\"progressToken\":41")
}
