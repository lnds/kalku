import kalku.wire.enums
import kalku.wire.shapes
import kalku.core.verdict
import kalku.core.score

fn tally_of(vs: [Verdict]) : Counts = tally(vs)

fn repeat_verdict(v: Verdict, n: Int) : [Verdict] = repeat(v, n)

test "the score is killed over killed plus survived" {
  let c = tally_of(repeat_verdict(Cast(Killed), 3) ++ [Cast(Survived)])
  assert score(c) == Some(0.75)
  assert score_text(c) == "75%"
}

test "nothing that could have been killed means no score, never 100%" {
  assert score(tally_of([])) == None
  assert score_text(tally_of([])) == "n/a"

  let only_timeouts = tally_of([Cast(Timeout), Cast(Timeout)])
  assert score(only_timeouts) == None
  assert score_text(only_timeouts) == "n/a"
}

# Tier 1, honest results: a timeout is not a failing assertion, a crash is
# not a kill, an uncovered line was never asked, an equivalent could not die.
test "timeouts, crashes, missing coverage, and equivalents stay out of the score" {
  let bare = tally_of([Cast(Killed), Cast(Survived)])
  let noisy = tally_of([
    Cast(Killed),
    Cast(Survived),
    Cast(Timeout),
    Cast(Crashed),
    Cast(NoCoverage),
    EquivalentBy(Bytecode),
    EquivalentBy(Declared)
  ])
  assert score(noisy) == score(bare)
  assert score(noisy) == Some(0.5)
}

test "the score rounds to one decimal for reading, not for arithmetic" {
  let c = tally_of(repeat_verdict(Cast(Killed), 2) ++ [Cast(Survived)])
  assert score_text(c) == "66.7%"
  assert score(c) != Some(0.667)
}

test "compile errors are measured against what was cast, not what was planned" {
  let c = tally_of([Cast(Killed), Cast(CompileError), Cast(NoCoverage)])
  assert compile_error_rate(c) == 0.5
  assert compile_error_rate(tally_of([])) == 0.0
}

test "too many compile errors accuse the spells, not the suite" {
  let noisy = tally_of([Cast(CompileError), Cast(CompileError), Cast(Killed)])
  let calm = tally_of([Cast(CompileError)] ++ repeat_verdict(Cast(Killed), 9))
  assert spells_look_wrong(noisy, COMPILE_ERROR_LIMIT)
  assert not spells_look_wrong(calm, COMPILE_ERROR_LIMIT)
}

# The limit is the last rate that still accuses the suite: a project
# sitting exactly on it is not told its spells are broken.
test "a compile-error rate exactly at the limit does not accuse the spells" {
  let at_limit = Counts { ...empty(), killed: 4, compile_error: 1 }
  assert compile_error_rate(at_limit) == 0.2
  assert not spells_look_wrong(at_limit, 0.2)
  let over = Counts { ...empty(), killed: 3, compile_error: 2 }
  assert spells_look_wrong(over, 0.2)
}

# Tier 1 as algebra rather than as a sentence: a timeout, a crash or a
# wekufe that would not compile cannot move the score, because the score
# is killed over killed plus survived and nothing else.

fn counted(killed: Int, survived: Int, aside: [Verdict]) : Counts =
  tally_of(
    repeat_verdict(Cast(Killed), killed) ++ repeat_verdict(Cast(Survived), survived) ++ aside
  )

fn score_of(killed: Int, survived: Int, aside: [Verdict]) : Real =
  score(counted(killed, survived, aside)).unwrap_or(0.0 - 1.0)

check "a score is a share: between nothing and everything" with k: Int, s: Int {
  let killed = abs(k) % 50
  let survived = abs(s) % 50
  killed + survived == 0
    or score_of(killed, survived, []) >= 0.0 and score_of(killed, survived, []) <= 1.0
}

check "nothing that never entered the score can move it" with k: Int, s: Int, n: Int {
  let killed = 1 + abs(k) % 50
  let survived = abs(s) % 50
  let aside = repeat_verdict(Cast(Timeout), abs(n) % 5)
    ++ repeat_verdict(Cast(Crashed), abs(n) % 3)
    ++ repeat_verdict(Cast(CompileError), abs(n) % 7)
    ++ repeat_verdict(Cast(NoCoverage), abs(n) % 4)
    ++ repeat_verdict(EquivalentBy(Bytecode), abs(n) % 2)
  score_of(killed, survived, aside) == score_of(killed, survived, [])
}

check "one more kill never lowers a score, and one more survivor never raises it" with k: Int, s: Int {
  let killed = abs(k) % 50
  let survived = abs(s) % 50
  score_of(killed + 1, survived, []) >= score_of(killed, survived, [])
    and score_of(killed, survived + 1, []) <= score_of(killed, survived, [])
}

check "a run with nothing to kill has no score at all" with n: Int {
  score(counted(0, 0, repeat_verdict(Cast(Timeout), abs(n) % 9))) == None
}
