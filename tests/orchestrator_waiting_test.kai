import actor
import time
import os.process
import kalku.wire.shapes
import kalku.wire.kalku_msg
import kalku.orchestrator.kalku_proc
import kalku.orchestrator.pool
import kalku.orchestrator.attending
import kalku.orchestrator.telling
import kalku.orchestrator.measure
import kalku.orchestrator.hearing

const LINES : Int = 60000

# A kalku whose build talks all the way up and then dies without a word of
# the protocol: what it wrote is all there is to wait through.
fn talkative() : PoolSpec = PoolSpec {
  command: "/bin/sh",
  args: [
    "-c",
    "i=0; while [ $i -lt #{LINES} ]; do echo \"line $i of a very talkative build\" >&2; i=$((i+1)); done; sleep 1"
  ],
  workers: 1,
  root: ".",
  reni: ".kalku",
  inline_limit_bytes: 65536,
  env: StrMap { entries: [] },
  options: None,
  greeting_ms: 5000,
  summons_allowed: 1,
  memory_mb: 0
}

fn asking_of(spec: PoolSpec) : Asking = Asking {
  spec: spec,
  files: [],
  only: [],
  spells: [],
  exclude_calls: [],
  exclude: [],
  equivalents: [],
  limit: 0,
  timeout_floor_ms: 1000,
  touched: None,
  shard: None,
  store: None,
  reuse: false,
  every_kill: false,
  whole: false,
  sample: None
}

fn after_writing(said: [String], from: Int, upto: Int) : [String] = if from >= upto {
  said
} else {
  after_writing(heard_last(said, "line #{from}\n"), from + 1, upto)
}

# A stack trace ends where the reason is, so the end is what is kept — and
# only the end, however much came before it.
test "of what a kalku writes, only its last lines are held" {
  let early = heard_last([], "one\n\ntwo\n")
  assert early == ["one", "two"]

  let late = after_writing(early, 0, 1000)
  assert length(late) == 12
  assert (late | (l => l == "line 999"))
    == [false, false, false, false, false, false, false, false, false, false, false, true]
  assert (late | (l => l == "line 988"))
    == [true, false, false, false, false, false, false, false, false, false, false, false]
}

# One wait takes a turn for every chunk the kalku writes meanwhile. A wait
# that kept a little stack for each turn ended the run, and the whole
# binary with it, on a project whose build or suite logs through it.
test "a kalku that writes a great deal before its first answer is waited through" {
  let answer = with_mailbox { alone(() => untold(() => discover(asking_of(talkative())))) }

  match answer {
    Ok(_) -> {
      assert false
    }
    Err(why) -> {
      assert is_some(index_of(why, "closed its pipe before saying `ready`"))
      assert is_some(index_of(why, "line #{LINES - 1} of a very talkative build"))
    }
  }
}

# A kalku whose runtime logs to stdout, as JSON: a line that parses and is
# no message. Its stderr has nothing to do with it.
fn logging() : PoolSpec = PoolSpec {
  ...talkative(),
  args: [
    "-c",
    "echo compiling >&2; sleep 0.2; echo '{\"level\":\"info\",\"message\":\"the application started\"}'; sleep 1"
  ]
}

# The line that broke the protocol is the one thing that names who wrote
# it, and it was on stdout: quoting only stderr sends the reader after
# lines that had no part in it.
test "a line on stdout that is not a message is quoted, and said to be from stdout" {
  let answer = with_mailbox { alone(() => untold(() => discover(asking_of(logging())))) }

  match answer {
    Ok(_) -> {
      assert false
    }
    Err(why) -> {
      assert is_some(index_of(why, "wrote a line on stdout that is not a protocol message"))
      assert is_some(index_of(why, "{\"level\":\"info\",\"message\":\"the application started\"}"))
      assert is_some(index_of(why, "what it wrote on stderr before that:\n  compiling"))
    }
  }
}

# `prepare` can honestly take minutes, and a run that names the phase and
# then shows nothing for ten of them cannot be told from one that has hung.
test "a long wait says what it is waiting for and for how long" {
  let said = still_waiting(0, "prepared", 60000, None)

  assert is_some(index_of(said, "worker 0 is still waiting for `prepared` after 60 s"))
  assert is_some(index_of(said, "slow one"))
}

# The commonest cause of a wait that does not end is a build lock held by a
# runtime nobody killed, and the runtime announces that on its own channel.
test "the kalku's own last line is quoted, which is where a lock shows up" {
  let said = still_waiting(0, "prepared", 120000, Some("Waiting for lock on the build directory"))

  assert is_some(index_of(said, "it last wrote: Waiting for lock on the build directory"))
  assert is_some(index_of(said, "after 120 s"))
}

fn a_kalku() : Kalku = Kalku { life: Life { worker: 0, summons: 1 }, child: Child { pid: 1 } }

# A wait of more than a minute, in no time: each read of the clock is ten
# seconds after the one before, and each receive is the next line of the
# script, `None` for one that timed out. What is kept is what the wait
# said while it went on.
fn waited_through(
  script: [Option[OrchMsg]]
) : ([String], Result[KalkuReply, String]) / Clock {
  let start = monotonic()
  handle {
    alone(
      () => handle {
        handle {
          await_kind(a_kalku(), "prepared")
        } with Actor[OrchMsg](script) {
          receive_timeout(_ns, resume) -> match state {
            [] -> resume(None, [])
            [next, ...rest] -> resume(next, rest)
          }
          receive(_resume) -> panic("receive is not scripted")
          send(_pid, _msg, resume) -> resume((), state)
          self(_resume) -> panic("a scripted mailbox has no Pid")
          return(x) -> x
        }
      } with Clock(0) {
        monotonic_now(resume) ->
          resume(instant_add_duration(start, millis(state * 10000)), state + 1)
        wall_now(resume) -> resume(Clock.wall_now(), state)
        sleep_ns(_ns, resume) -> resume((), state)
        return(x) -> x
      }
    )
  } with Telling([]) {
    tell_of(_line, resume) -> resume((), state)
    entered(_phase, resume) -> resume((), state)
    got_through(_done, _total, resume) -> resume((), state)
    will_cost(_casts, _estimate_ms, _most_ms, resume) -> resume((), state)
    still_on(_worker, _site, _ms, resume) -> resume((), state)
    kalku_wrote(_worker, _chunk, resume) -> resume((), state)
    kalku_at(_worker, _done, _total, resume) -> resume((), state)
    logging_to(_path, resume) -> resume((), state)
    cast_survived(_w, resume) -> resume((), state)
    found_survivor(_s, resume) -> resume((), state)
    advised(_line, resume) -> resume((), state)
    waiting_on(worker, kind, ms, last, resume) ->
      resume((), state ++ [still_waiting(worker, kind, ms, last)])
    return(x) -> (state, x)
  }
}

# A build that writes is no more visible to a person than one that is
# silent: the wait is said every thirty seconds either way, with the last
# line the kalku wrote, until the answer comes.
test "a wait is said every thirty seconds it goes on, with the kalku's last line" {
  let life = a_kalku().life
  let (notes, answer) = waited_through([
    Some(Wire(life, Wrote("Compiling 12 files (.ex)\n"))),
    None,
    None,
    None,
    None,
    None,
    Some(Wire(life, Said("{\"type\":\"prepared\",\"id\":2,\"duration_ms\":1,\"modules\":1}")))
  ])

  assert is_ok(answer)
  assert notes
    == [
      "worker 0 is still waiting for `prepared` after 30 s; it last wrote: Compiling 12 files (.ex)",
      "worker 0 is still waiting for `prepared` after 60 s; it last wrote: Compiling 12 files (.ex)"
    ]
}

test "a wait that ends before thirty seconds says nothing" {
  let life = a_kalku().life
  let (notes, answer) = waited_through([
    None,
    Some(Wire(life, Said("{\"type\":\"prepared\",\"id\":2,\"duration_ms\":1,\"modules\":1}")))
  ])

  assert is_ok(answer)
  assert notes == []
}
