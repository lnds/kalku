import actor
import kalku.wire.shapes
import kalku.orchestrator.kalku_proc
import kalku.orchestrator.pool
import kalku.orchestrator.attending
import kalku.orchestrator.telling
import kalku.orchestrator.measure

const LINES : Int = 60000

# A kalku whose build talks all the way up and then dies without a word of
# the protocol: what it wrote is all there is to wait through.
fn talkative() : PoolSpec = PoolSpec {
  command: "/bin/sh",
  args: [
    "-c",
    "i=0; while [ $i -lt #{LINES} ]; do echo \"line $i of a very talkative build\" >&2; i=$((i+1)); done; sleep 1"
  ],
  workers: 1,
  root: ".",
  reni: ".kalku",
  inline_limit_bytes: 65536,
  env: StrMap { entries: [] },
  greeting_ms: 5000,
  summons_allowed: 1,
  memory_mb: 0
}

fn asking_of(spec: PoolSpec) : Asking = Asking {
  spec: spec,
  files: [],
  only: [],
  spells: [],
  exclude_calls: [],
  exclude: [],
  equivalents: [],
  limit: 0,
  timeout_floor_ms: 1000,
  touched: None,
  shard: None
}

fn after_writing(said: [String], from: Int, upto: Int) : [String] = if from >= upto {
  said
} else {
  after_writing(heard_last(said, "line #{from}\n"), from + 1, upto)
}

# A stack trace ends where the reason is, so the end is what is kept — and
# only the end, however much came before it.
test "of what a kalku writes, only its last lines are held" {
  let early = heard_last([], "one\n\ntwo\n")
  assert early == ["one", "two"]

  let late = after_writing(early, 0, 1000)
  assert length(late) == 12
  assert (late | (l => l == "line 999"))
    == [false, false, false, false, false, false, false, false, false, false, false, true]
  assert (late | (l => l == "line 988"))
    == [true, false, false, false, false, false, false, false, false, false, false, false]
}

# One wait takes a turn for every chunk the kalku writes meanwhile. A wait
# that kept a little stack for each turn ended the run, and the whole
# binary with it, on a project whose build or suite logs through it.
test "a kalku that writes a great deal before its first answer is waited through" {
  let answer = with_mailbox { alone(() => untold(() => discover(asking_of(talkative())))) }

  match answer {
    Ok(_) -> {
      assert false
    }
    Err(why) -> {
      assert is_some(index_of(why, "closed its pipe before saying `ready`"))
      assert is_some(index_of(why, "line #{LINES - 1} of a very talkative build"))
    }
  }
}

# A kalku whose runtime logs to stdout, as JSON: a line that parses and is
# no message. Its stderr has nothing to do with it.
fn logging() : PoolSpec = PoolSpec {
  ...talkative(),
  args: [
    "-c",
    "echo compiling >&2; sleep 0.2; echo '{\"level\":\"info\",\"message\":\"the application started\"}'; sleep 1"
  ]
}

# The line that broke the protocol is the one thing that names who wrote
# it, and it was on stdout: quoting only stderr sends the reader after
# lines that had no part in it.
test "a line on stdout that is not a message is quoted, and said to be from stdout" {
  let answer = with_mailbox { alone(() => untold(() => discover(asking_of(logging())))) }

  match answer {
    Ok(_) -> {
      assert false
    }
    Err(why) -> {
      assert is_some(index_of(why, "wrote a line on stdout that is not a protocol message"))
      assert is_some(index_of(why, "{\"level\":\"info\",\"message\":\"the application started\"}"))
      assert is_some(index_of(why, "what it wrote on stderr before that:\n  compiling"))
    }
  }
}

# `prepare` can honestly take minutes, and a run that says so once and
# then goes quiet for ten of them cannot be told from one that has hung.
# Saying how long it has been waiting turns a hang into a wait.
test "a long wait says what it is waiting for and for how long" {
  let said = still_waiting("prepared", 60000, [])

  assert is_some(index_of(said, "still waiting for `prepared`"))
  assert is_some(index_of(said, "60s"))
  assert is_some(index_of(said, "slow one"))
}

# The commonest cause of the silence is a build lock held by a runtime
# nobody killed, and the runtime announces that on its own channel. This
# side already has the line; holding it until the kalku dies is holding it
# forever, because a wait on a lock does not end.
test "the kalku's own last word is quoted, which is where a lock shows up" {
  let said = still_waiting(
    "prepared",
    120000,
    ["Compiling 4 files", "Waiting for lock on the build directory"]
  )

  assert is_some(index_of(said, "Waiting for lock on the build directory"))
  assert is_none(index_of(said, "Compiling 4 files"))
  assert is_some(index_of(said, "120s"))
}
