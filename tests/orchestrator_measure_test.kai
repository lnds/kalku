import actor
import fs.file
import os.process as proc
import kalku.wire.enums
import kalku.wire.shapes
import kalku.core.report
import kalku.core.gate
import kalku.core.sampling
import kalku.orchestrator.kalku_proc
import kalku.orchestrator.pool
import kalku.orchestrator.attending
import kalku.orchestrator.telling
import kalku.orchestrator.measure

const FAKE : String = "./tests/fake_kalku/fake_kalku"

fn asking_of(script: String) : Asking = Asking {
  spec: PoolSpec {
    command: FAKE,
    args: ["tests/fixtures/scripts/#{script}"],
    workers: 1,
    root: ".",
    reni: ".kalku",
    inline_limit_bytes: 65536,
    env: StrMap { entries: [] },
    options: None,
    greeting_ms: 5000,
    summons_allowed: 1,
    memory_mb: 0
  },
  files: ["lib/a.ex"],
  only: [],
  spells: [],
  exclude_calls: [],
  exclude: [],
  equivalents: [],
  limit: 0,
  timeout_floor_ms: 5000,
  touched: None,
  shard: None,
  store: None,
  reuse: false,
  every_kill: false,
  whole: false,
  sample: None
}

fn measured(script: String) : Found / Process + Spawn + Clock + File + Stderr =
  measured_with(asking_of(script))

fn measured_with(asking: Asking) : Found / Process + Spawn + Clock + File + Stderr =
  with_mailbox { alone(() => untold(() => measuring(asking))) }

# The kalku of this script casts only after it has run the suite, and is
# greeted once: a second kalku, summoned to cast what the first could, would
# be handed a wekufe where the script expects `baseline` and die of it. So a
# run that ends with both wekufe judged cast them with the kalku that read
# the project, which had built it and held its suite already.
test "the kalku that read the project is the one that casts, with one worker" {
  let found = measured("reads_then_casts.ndjson")

  assert found.failure == None
  assert (found.cast | (c => (c.wekufe, c.outcome))) == [("s3", Killed), ("s7", Killed)]
  match found.report {
    None -> {
      assert false
    }
    Some(r) -> {
      assert r.counts.killed == 2
      assert starts_with(r.log ?? "", ".kalku/logs/run-")
    }
  }
}

# It may be the one that goes on to cast, so what a pool asks of every
# kalku it greets is asked of this one before anything else.
test "a kalku that reads the project in a protocol this side cannot speak is refused" {
  let found = measured("protocol_mismatch.ndjson")

  assert found.report == None
  assert is_some(index_of(found.failure |> unwrap_or(""), "the kalku speaks protocol 99"))
}

# The same kalku, saying nothing of what a cast after its baseline is worth.
# It is not handed a wekufe: another is summoned to cast, and that one dies
# of this script, which is how the test knows there was another.
test "a kalku that does not say it can cast after its baseline is not kept" {
  let found = measured("reads_and_leaves.ndjson")

  assert is_some(index_of(found.failure |> unwrap_or(""), "expected `baseline`, got `cast`"))
}

# The same run, read for what it leaves: the wekufe that kalku took with it
# was cast, and the one after it was not. What was cast is reported, with
# the stop said in the report itself and nothing to hold a floor to.
test "a run that stops short reports what it cast, and that it stopped" {
  let found = measured("reads_and_leaves.ndjson")

  match found.report {
    None -> {
      assert false
    }
    Some(r) -> {
      assert is_some(r.stopped)
      assert r.stopped == found.failure
      assert r.counts.crashed == 1
      assert r.planned == 2
      assert exit_code(judged_by(r, no_policy(), None).blockers) == 2
    }
  }
}

# With more workers than one, the kalku that read the project keeps the
# first slot and the rest are summoned beside it: greeted, prepared, and
# never asked for a baseline.
test "the kalku that read the project casts beside the ones summoned after it" {
  let one = asking_of("reads_or_casts.ndjson")
  let found = measured_with(Asking { ...one, spec: PoolSpec { ...one.spec, workers: 2 } })

  assert found.failure == None
  assert (found.cast | (c => (c.wekufe, c.outcome))) == [("s3", Killed), ("s7", Killed)]
}

# The kalku lists `s3` twice, differing only in its ordinal, and the script
# answers two casts and then expects `shutdown`: a third cast would end the
# run. One wekufe is cast once, and the run is not partial for it.
test "a wekufe a kalku lists twice is cast once and planned once" {
  let found = measured("lists_twice.ndjson")

  assert found.failure == None
  assert (found.cast | (c => (c.wekufe, c.outcome))) == [("s3", Killed), ("s7", Killed)]
  match found.report {
    None -> {
      assert false
    }
    Some(r) -> {
      assert r.planned == 2
      assert r.counts.killed == 2
    }
  }
}

test "one name a kalku gives two different wekufe ends the run before anything is cast" {
  let found = measured("names_two.ndjson")

  assert found.cast == []
  assert is_some(index_of(found.failure |> unwrap_or(""), "named two different wekufe `s3`"))
}

# The script answers one cast and then expects `shutdown`, so a second cast
# would end the run: a sample of one casts one wekufe of the two planned,
# and says so. Its score is an estimate, never held to a floor.
test "a sample casts the wekufe it draws, and reports what it drew of what" {
  let found =
    measured_with(Asking { ...asking_of("casts_one.ndjson"), whole: true, sample: Some(1) })

  assert found.failure == None
  assert list.length(found.cast) == 1
  match found.report {
    None -> {
      assert false
    }
    Some(r) -> {
      assert r.sample == Some(Sampled { drawn: 1, of: 2 })
      assert r.counts.killed == 1
      assert r.planned == 2
      assert exit_code(judged_by(r, no_policy(), None).blockers) == 0
      let floor = Policy { threshold: Some(0.5), baseline: None }
      assert exit_code(judged_by(r, floor, None).blockers) == 2
    }
  }
}

# Two files of 100 kB are more source than one batch holds, so their sites
# are asked for in two requests. The script answers `sites` twice and then
# expects casts: a run that asked once would hand it a cast too early.
test "the sites of more source than a batch holds are asked for a batch at a time" {
  let root = "#{Env.get("TMPDIR") |> unwrap_or("/tmp")}/kalku-search-test"
  let _ = proc.pipe_errs("/bin/mkdir", ["-p", "#{root}/lib"]) |> map(c => proc.wait(c))
  let big = string.repeat("x", 100000)
  file.write("#{root}/lib/a.ex", big) |> ignore
  file.write("#{root}/lib/b.ex", big) |> ignore
  let one = asking_of("sites_in_two.ndjson")
  let found = measured_with(
    Asking { ...one, spec: PoolSpec { ...one.spec, root: root }, files: ["lib/a.ex", "lib/b.ex"] }
  )
  let _ = proc.pipe_errs("/bin/rm", ["-rf", root]) |> map(c => proc.wait(c))

  assert found.failure == None
  assert (found.cast | (c => (c.wekufe, c.outcome))) == [("s3", Killed), ("s7", Killed)]
}
