import kalku.cli
import kalku.cli_help
import kalku.wire.shapes
import kalku.version

test "no arguments shows the help" {
  assert cli.parse_args([]) == ShowHelp
}

test "help and version flags" {
  assert cli.parse_args(["help"]) == ShowHelp
  assert cli.parse_args(["-h"]) == ShowHelp
  assert cli.parse_args(["--help"]) == ShowHelp
  assert cli.parse_args(["--version"]) == ShowVersion
  assert cli.parse_args(["-V"]) == ShowVersion
}

# A command that does not know `--help` is read as a command: `kalku mcp
# --help` served MCP on stdin and waited there for good, and `kalku init
# --help` was refused. Asked about itself, every command says what it does.
test "every command answers `--help` instead of running" {
  assert all(explained(), cmd => cli.parse_args([cmd, "--help"]) == ShowHelpOf(cmd))
  assert all(explained(), cmd => cli.parse_args([cmd, "-h"]) == ShowHelpOf(cmd))
  assert all(explained(), cmd => cli.parse_args(["help", cmd]) == ShowHelpOf(cmd))
  assert cli.parse_args(["mcp", "--help"]) == ShowHelpOf("mcp")
  assert cli.parse_args(["init", "--lang", "elixir", "--help"]) == ShowHelpOf("init")
  assert cli.parse_args(["run", "lib/a.ex", "--limit", "5", "-h"]) == ShowHelpOf("run")
}

# A server started with an argument it does not know started all the same,
# and one started by something that is not a host waited for it for good.
test "the servers take no arguments, and refuse any before they start" {
  assert cli.parse_args(["mcp"]) == Mcp
  assert cli.parse_args(["serve"]) == Serve
  assert cli.parse_args(["mcp", "--foo"]) == Misused("`kalku mcp` does not take --foo")
  assert cli.parse_args(["serve", "--x"]) == Misused("`kalku serve` does not take --x")
}

test "what a command says of itself starts with how it is used" {
  assert all(explained(), cmd => starts_with(trim(help_of(cmd)), "usage: kalku #{cmd}"))
}

test "help of something that is not a command is the whole help" {
  assert cli.parse_args(["help", "nope"]) == ShowHelp
  assert cli.parse_args(["nope", "--help"]) == Unknown("nope")
}

test "a command kalku does not have is unknown" {
  assert cli.parse_args(["nope"]) == Unknown("nope")
  assert cli.parse_args(["serve"]) == Serve
}

test "merge takes the shards' reports, a format, and whether to store the score" {
  assert cli.parse_args(["merge", "a.json", "b.json", "--format", "json", "--store-baseline"])
    == Merge(Merging { reports: ["a.json", "b.json"], shape: AsJson, store: true })
  assert cli.parse_args(["merge", "a.json"])
    == Merge(Merging { reports: ["a.json"], shape: AsHuman, store: false })
}

test "merge refuses to start without a report, or with what it does not take" {
  assert cli.parse_args(["merge"])
    == Misused(
      "`kalku merge` needs the reports of the shards, as `kalku run --all --shard i/n --format json` wrote them"
    )
  assert cli.parse_args(["merge", "a.json", "--all"])
    == Misused("`kalku merge` does not take --all")
  assert cli.parse_args(["merge", "a.json", "--format", "xml"])
    == Misused("`--format` takes human, agent, json or github, not `xml`")
}

test "the version line carries VERSION" {
  assert cli.version_line() == "kalku #{version.VERSION}"
}

# `kalku init` in the directory one is standing in is the whole point, so
# everything it takes is optional.
test "init defaults to here, guessing the language, asking first" {
  assert cli.parse_args(["init"])
    == Initialise(Setup { root: ".", language: None, assume_yes: false })
}

test "init takes a directory, a language and a yes" {
  assert cli.parse_args(["init", "../thing", "--lang", "elixir", "--yes"])
    == Initialise(Setup { root: "../thing", language: Some("elixir"), assume_yes: true })
  assert cli.parse_args(["init", "-y"])
    == Initialise(Setup { root: ".", language: None, assume_yes: true })
}

# A flag with a missing or unreadable value is told, never guessed at: a
# run that quietly measured something else is worse than one that stopped.
test "a flag without its value is a misuse, not a default" {
  assert cli.parse_args(["init", "--lang"]) == Misused("`--lang` needs a language")
  assert cli.parse_args(["run", "--limit"]) == Misused("`--limit` needs a number")
  assert cli.parse_args(["run", "--limit", "many"])
    == Misused("`--limit` takes a number, not `many`")
  assert cli.parse_args(["init", "--wat"]) == Misused("`kalku init` does not take --wat")
}

test "run takes the files to measure, and how much of them" {
  assert cli.parse_args(["run", "lib/a.ex", "lib/b.ex"])
    == Measure(
      Wanted {
        files: ["lib/a.ex", "lib/b.ex"],
        limit: None,
        aloud: false,
        quiet: false,
        shape: AsHuman,
        since: None,
        all: false,
        shard: None,
        store: false,
        watch: false,
        every_kill: false
      }
    )
  assert cli.parse_args(["run", "--limit", "6", "-v", "lib/a.ex"])
    == Measure(Wanted {
      files: ["lib/a.ex"],
      limit: Some(6),
      aloud: true,
      quiet: false,
      shape: AsHuman,
      since: None,
      all: false,
      shard: None,
      store: false,
      watch: false,
      every_kill: false
    })
}

# A run says how far it has got by default; asked for quiet, it says
# nothing until the report.
test "run takes -q and --quiet to say nothing until the report" {
  assert cli.parse_args(["run", "-q"]) == Measure(Wanted { ...nothing_wanted(), quiet: true })
  assert cli.parse_args(["run", "--quiet"]) == Measure(Wanted { ...nothing_wanted(), quiet: true })
}

# The files a run measures come from the config when none are named.
test "run with nothing named is still a run" {
  assert cli.parse_args(["run"])
    == Measure(Wanted {
      files: [],
      limit: None,
      aloud: false,
      quiet: false,
      shape: AsHuman,
      since: None,
      all: false,
      shard: None,
      store: false,
      watch: false,
      every_kill: false
    })
}

test "info takes a topic and how to print it" {
  assert cli.parse_args(["info"])
    == Inform(Asked { topic: None, as_json: false, snippet_only: false })
  assert cli.parse_args(["info", "spells", "--json"])
    == Inform(Asked { topic: Some("spells"), as_json: true, snippet_only: false })
  assert cli.parse_args(["info", "agents", "--snippet"])
    == Inform(Asked { topic: Some("agents"), as_json: false, snippet_only: true })
  assert cli.parse_args(["info", "--wat"]) == Misused("`kalku info` does not take --wat")
}

# The format is how a run is read, and reading it wrong is worse than not
# reading it: a name that is not a format stops the run rather than
# quietly printing something else.
test "run takes the shape it should print in" {
  assert cli.parse_args(["run", "lib/a.ex", "--format", "agent"])
    == Measure(Wanted {
      files: ["lib/a.ex"],
      limit: None,
      aloud: false,
      quiet: false,
      shape: AsAgent,
      since: None,
      all: false,
      shard: None,
      store: false,
      watch: false,
      every_kill: false
    })
  assert cli.parse_args(["run", "--format", "github", "lib/a.ex"])
    == Measure(Wanted {
      files: ["lib/a.ex"],
      limit: None,
      aloud: false,
      quiet: false,
      shape: AsGithub,
      since: None,
      all: false,
      shard: None,
      store: false,
      watch: false,
      every_kill: false
    })
  assert cli.parse_args(["run", "--format"])
    == Misused("`--format` needs a name: human, agent, json or github")
  assert cli.parse_args(["run", "--format", "yaml"])
    == Misused("`--format` takes human, agent, json or github, not `yaml`")
}

# The loop: a survivor is named, a test is written, that one wekufe is
# re-cast. Naming files instead would re-measure everything.
test "cast names wekufe, show names one, and both need a name" {
  assert cli.parse_args(["cast", "w1", "w2"])
    == Recast(
      Wanted {
        files: ["w1", "w2"],
        limit: None,
        aloud: false,
        quiet: false,
        shape: AsHuman,
        since: None,
        all: false,
        shard: None,
        store: false,
        watch: false,
        every_kill: false
      }
    )
  assert cli.parse_args(["cast"]) == Misused("`kalku cast` needs a wekufe to re-cast")
  assert cli.parse_args(["show", "w1"]) == Display("w1", AsHuman)
  assert cli.parse_args(["show", "w1", "--format", "json"]) == Display("w1", AsJson)
  assert cli.parse_args(["show"]) == Misused("`kalku show` needs a wekufe to show")
}

# An equivalent without a reason is a hole somebody talked themselves out
# of, so the reason is not optional.
test "proposing an equivalent needs a wekufe and a reason" {
  assert cli.parse_args(["propose-equivalent", "w1", "--reason", "logging only"])
    == Propose("w1", "logging only")
  assert cli.parse_args(["propose-equivalent", "w1"])
    == Misused("`kalku propose-equivalent` needs a `--reason`")
  assert cli.parse_args(["propose-equivalent", "--reason", "why"])
    == Misused("`kalku propose-equivalent` needs a wekufe")
}

# A change is asked about by naming where it started. With no files named
# the run is about whatever the change touched, so naming none is allowed.
test "run takes the ref a change started from" {
  assert cli.parse_args(["run", "--since", "origin/main"])
    == Measure(
      Wanted {
        files: [],
        limit: None,
        aloud: false,
        quiet: false,
        shape: AsHuman,
        since: Some("origin/main"),
        all: false,
        shard: None,
        store: false,
        watch: false,
        every_kill: false
      }
    )
  assert cli.parse_args(["run", "lib/a.ex", "--since", "main", "--format", "github"])
    == Measure(
      Wanted {
        files: ["lib/a.ex"],
        limit: None,
        aloud: false,
        quiet: false,
        shape: AsGithub,
        since: Some("main"),
        all: false,
        shard: None,
        store: false,
        watch: false,
        every_kill: false
      }
    )
}

# Handed to git as an argument, a ref that begins with a dash is an option,
# and `--output=<file>` would have `git diff` write into the project.
test "a ref that is really an option is refused where it is read" {
  match cli.parse_args(["run", "--since", "--output=/tmp/x"]) {
    Misused(why) -> {
      assert is_some(index_of(why, "not the option"))
    }
    _ -> {
      assert false
    }
  }
  match cli.parse_args(["run", "--since"]) {
    Misused(why) -> {
      assert is_some(index_of(why, "needs a ref"))
    }
    _ -> {
      assert false
    }
  }
}

# A re-cast names wekufe, so a change has nothing to say to it.
test "cast does not take a change" {
  match cli.parse_args(["cast", "abc123", "--since", "main"]) {
    Misused(why) -> {
      assert is_some(index_of(why, "kalku run"))
    }
    _ -> {
      assert false
    }
  }
}

# The whole project in parts is a nightly run's recipe, and a part that is
# not one is a typo that would otherwise cast the wrong wekufe.
test "run takes the whole project, and a part of it" {
  assert parse_args(["run", "--all", "--shard", "2/4"])
    == Measure(Wanted { ...nothing_wanted(), all: true, shard: Some(Shard { index: 2, count: 4 }) })
  assert parse_args(["run", "--shard"]) == Misused("`--shard` needs a part, as in `--shard 2/4`")
  assert parse_args(["run", "--all", "--shard", "5/4"])
    == Misused("`--shard` takes a part of a count, as in `2/4`, not `5/4`")
  assert parse_args(["run", "--all", "--shard", "half"])
    == Misused("`--shard` takes a part of a count, as in `2/4`, not `half`")
}

test "the whole project is not also some files, nor a change" {
  assert parse_args(["run", "--all", "lib/a.ex"])
    == Misused("`--all` measures every source file; name files or say `--all`, not both")
  assert parse_args(["run", "--all", "--since", "origin/main"])
    == Misused("`--all` measures the whole project and `--since` a change; say one")
}

# A baseline is the score of the whole project, so only a run of the whole
# project can store one.
test "a baseline is stored by a run of the whole project and no other" {
  assert parse_args(["run", "--all", "--store-baseline"])
    == Measure(Wanted { ...nothing_wanted(), all: true, store: true })
  let part =
    "`--store-baseline` stores the score of the whole project: it goes with `--all`, and with neither `--shard` nor `--limit`"
  assert parse_args(["run", "lib/a.ex", "--store-baseline"]) == Misused(part)
  assert parse_args(["run", "--all", "--shard", "1/2", "--store-baseline"]) == Misused(part)
  assert parse_args(["run", "--all", "--limit", "10", "--store-baseline"]) == Misused(part)
}

test "run --watch is a run that goes on" {
  assert parse_args(["run", "--watch", "lib/a.ex"])
    == Measure(Wanted { ...nothing_wanted(), files: ["lib/a.ex"], watch: true })
  assert parse_args(["run", "--since", "origin/main", "--watch", "--format", "agent"])
    == Measure(Wanted {
      ...nothing_wanted(),
      since: Some("origin/main"),
      shape: AsAgent,
      watch: true,
      every_kill: false
    })
}

# A watch prints a report after every save, and each of these is about one
# report: refused before anything runs, not ignored for as long as it watches.
test "run --watch refuses what is about one report" {
  assert parse_args(["run", "--all", "--watch", "--store-baseline"])
    == Misused("`--watch` runs again on every save; `--store-baseline` stores the score of one run")
  assert parse_args(["run", "--all", "--watch", "--shard", "1/2"])
    == Misused("`--watch` runs again on every save; `--shard` is a part of one run, for a CI job")
  let one_report =
    "`--watch` prints a report after every save; `--format json` and `--format github` are one report, read by a program"
  assert parse_args(["run", "lib/a.ex", "--watch", "--format", "json"]) == Misused(one_report)
  assert parse_args(["run", "lib/a.ex", "--watch", "--format", "github"]) == Misused(one_report)
  assert parse_args(["cast", "abc", "--watch"])
    == Misused("`kalku cast` re-casts once; `--watch` is for `kalku run`")
}

# Every kill is about the whole suite: a test that kills nothing in one
# file may be the only one that kills in another.
test "run --every-kill weighs the tests of the whole project" {
  assert parse_args(["run", "--all", "--every-kill"])
    == Measure(Wanted { ...nothing_wanted(), all: true, every_kill: true })
  assert parse_args(["run", "lib/a.ex", "--every-kill"])
    == Misused(
      "`--every-kill` weighs the tests of the whole project: it goes with `--all`, since a test that kills nothing in one file may be the only one that kills in another"
    )
}
