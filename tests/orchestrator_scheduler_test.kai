import actor

import kalku.wire.enums
import kalku.wire.shapes
import kalku.core.planner
import kalku.orchestrator.kalku_proc
import kalku.orchestrator.pool
import kalku.orchestrator.scheduler

const FAKE : String = "./tests/fake_kalku/fake_kalku"

# Short enough that a hung kalku is caught while the suite is still young.
const SHORT_CAST_MS : Int = 200

fn pool_of(script: String, workers: Int, summons: Int) : PoolSpec = PoolSpec {
  command: FAKE,
  args: ["tests/fixtures/scripts/#{script}"],
  workers: workers,
  root: ".",
  reni: ".kalku",
  inline_limit_bytes: 65536,
  env: StrMap { entries: [] },
  greeting_ms: 5000,
  summons_allowed: summons
}

fn casts(n: Int, timeout_ms: Int) : [Cast] =
  enumerate(repeat(0, n))
    | (i => Cast {
      site: site_named("w#{i.fst}"),
      tests: ["test/a_test.kai"],
      timeout_ms: timeout_ms
    })

fn site_named(id: String) : Site = Site {
  site_id: id,
  file: "lib/a.kai",
  enclosing: Some("add"),
  ordinal: None,
  span: Span { start: Position { line: 12, col: 5, byte: 0 }, end: None },
  spell: Arm,
  original: Some("+"),
  replacement: "-",
  reload: ModuleOnly
}

fn tally(c: Casting) : [(String, Int)] {
  let names = c.verdicts | (v => outcome_name(v.outcome))
  uniq(names) | (n => (n, length(filter(names, x => x == n))))
}

fn wekufe_named(c: Casting) : [String] = c.verdicts | (.wekufe)

test "four kalku cast a hundred wekufe, and every one is accounted for exactly once" {
  let done = with_mailbox { cast_all(pool_of("pool_happy.ndjson", 4, 1), casts(100, 5000)) }
  assert length(done.verdicts) == 100
  assert tally(done) == [("killed", 100)]
  assert length(uniq(wekufe_named(done))) == 100
  assert done.failure == None
}

# The point of aborting: the kalku that timed out serves the next cast.
# The fake's script proves it — a replacement would start at `hello` and
# refuse a `cast`, so a re-summon would show up as a crash here.
test "a cast past its deadline is a timeout, and the same kalku takes the next one" {
  let done = with_mailbox {
    cast_all(pool_of("pool_timeout_abort.ndjson", 1, 1), casts(3, SHORT_CAST_MS))
  }
  assert tally(done) == [("timeout", 1), ("survived", 2)]
  assert done.failure == None
}

# A kalku deaf to `abort` cannot be kept, so it is killed and replaced —
# and the run carries on with the replacement.
test "a kalku that ignores `abort` is replaced, and the run carries on" {
  let done = with_mailbox {
    cast_all(pool_of("pool_deaf_abort.ndjson", 1, 3), casts(2, SHORT_CAST_MS))
  }
  assert tally(done) == [("timeout", 2)]
  assert done.failure == None
}

test "a kalku that never said it can abort is killed on the deadline" {
  let done = with_mailbox {
    cast_all(pool_of("pool_no_abort.ndjson", 1, 2), casts(1, SHORT_CAST_MS))
  }
  assert tally(done) == [("timeout", 1)]
}

# State one wekufe left behind would be read as another wekufe's result,
# so a dirty kalku is reset before it serves again.
test "a dirty cast is reset in place, and the kalku keeps working" {
  let done = with_mailbox {
    cast_all(pool_of("pool_dirty_reset.ndjson", 1, 1), casts(3, 5000))
  }
  assert tally(done) == [("killed", 1), ("survived", 2)]
  assert done.failure == None
}

test "a kalku whose reset is not clean is recycled" {
  let done = with_mailbox {
    cast_all(pool_of("pool_dirty_unclean.ndjson", 1, 2), casts(1, 5000))
  }
  assert tally(done) == [("killed", 1)]
  assert done.failure == None
}

# The kalku is lost; the wekufe it was casting is not.
test "a kalku that crashes mid-cast reports its wekufe as crashed" {
  let done = with_mailbox { cast_all(pool_of("pool_crash.ndjson", 1, 2), casts(1, 5000)) }
  assert tally(done) == [("crashed", 1)]
  assert wekufe_named(done) == ["w0"]
}

test "a kalku that writes a line this side cannot read is banished, its wekufe crashed" {
  let done = with_mailbox { cast_all(pool_of("pool_garbage.ndjson", 1, 2), casts(1, 5000)) }
  assert tally(done) == [("crashed", 1)]
}

# A version this side cannot speak is not a kalku problem: a replacement
# would say the same thing, so the run stops and says why.
test "a protocol version this side cannot speak fails the run with a readable reason" {
  let done = with_mailbox { cast_all(pool_of("pool_mismatch.ndjson", 1, 3), casts(2, 5000)) }
  assert done.verdicts == []
  assert done.failure == Some("worker 0 speaks protocol 99, this kalku speaks 1")
}

# A kalku that dies on startup would otherwise be summoned forever.
test "a kalku that dies at birth exhausts its summons and fails the run" {
  let done = with_mailbox {
    cast_all(pool_of("pool_dies_at_birth.ndjson", 1, 2), casts(1, 5000))
  }
  assert done.verdicts == []
  assert is_some(done.failure)
  assert is_some(index_of(done.failure.unwrap_or(""), "the most this run allows is 2"))
  # Quoted, not paraphrased: why a project will not build is the kalku's
  # to say, and it is the whole diagnostic a failed run can offer.
  assert is_some(
    index_of(done.failure.unwrap_or(""), "it wrote: fake: the project does not compile")
  )
}

# Cancelling stops the dispatching, and whatever was already measured is
# still reported. Here nothing had been dispatched yet, so the run ends
# empty rather than hanging.
test "a cancelled run stops dispatching and returns what it had" {
  let done = with_mailbox {
    Actor.send(Actor.self(), Cancel)
    cast_all(pool_of("pool_happy.ndjson", 1, 1), casts(50, 5000))
  }
  assert done.cancelled
  assert done.verdicts == []
  assert done.failure == None
}

# A pool of no workers has nobody to answer and no deadline to expire, so
# a run that waited for one would wait forever. It says so instead.
test "a run with no kalku at all fails instead of waiting" {
  let done = with_mailbox { cast_all(pool_of("pool_happy.ndjson", 0, 1), casts(3, 5000)) }
  assert done.verdicts == []
  assert done.failure == Some("a run needs at least one kalku, and this pool was asked for none")
}

test "a pool of no workers with nothing to cast is simply an empty run" {
  let done = with_mailbox { cast_all(pool_of("pool_happy.ndjson", 0, 1), []) }
  assert done.verdicts == []
  assert done.failure == None
}

# The budget is spent, not exceeded: `summoned 2 time(s)` is the whole
# point of a budget of 2.
test "a kalku that dies at birth is summoned exactly as often as allowed" {
  let done = with_mailbox {
    cast_all(pool_of("pool_dies_at_birth.ndjson", 1, 2), casts(1, 5000))
  }
  assert is_some(index_of(done.failure.unwrap_or(""), "summoned 2 time(s)"))
}
