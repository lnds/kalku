import encoding.json
import fs.file
import kalku.wire.envelope
import kalku.wire.kalku_codec
import kalku.wire.client_codec

const INVALID : String = "docs/protocol/fixtures/invalid"

# Each fixture line pairs a raw line with the protocol error kind it must produce.
fn entries(name: String) : [(String, String)] / File =
  flat_map(lines(file.read("#{INVALID}/#{name}.ndjson")), entry)

fn entry(raw: String) : [(String, String)] = match json_decode(raw) {
  Some(v) -> match as_string(get(v, "expect")) {
    Some(kind) -> match as_string(get(v, "line")) {
      Some(line) -> [(kind, line)]
      None -> []
    }
    None -> []
  }
  None -> []
}

fn kind_of[t](r: Result[t, ProtocolError]) : String = match r {
  Ok(_) -> "accepted"
  Err(e) -> kind_name(e.kind)
}

fn mismatches(name: String, decode: (String) -> String) : [String] / File =
  flat_map(entries(name), e => {
    let (expected, line) = e
    let got = decode(line)
    if got == expected { [] } else { ["#{name}: expected #{expected}, got #{got}\n  #{line}"] }
  })

fn report(ps: [String]) : Bool / Stdout {
  ps |> each(p => Stdout.print(p))
  ps == []
}

test "invalid kalku requests fail with the kind their fixture names" {
  assert report(mismatches("kalku_requests", l => kind_of(decode_request(l))))
}

test "invalid kalku replies fail with the kind their fixture names" {
  assert report(mismatches("kalku_replies", l => kind_of(decode_reply(l))))
}

test "invalid client requests fail with the kind their fixture names" {
  assert report(mismatches("client_requests", l => kind_of(decode_client_request(l))))
}

test "invalid server events fail with the kind their fixture names" {
  assert report(mismatches("client_events", l => kind_of(decode_event(l))))
}

test "every invalid fixture file has entries" {
  assert all(
    ["kalku_requests", "kalku_replies", "client_requests", "client_events"],
    n => entries(n) != []
  )
}
