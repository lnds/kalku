import fs.dir
import fs.file
import kalku.wire.envelope
import kalku.wire.kalku_codec

const FIXTURES : String = "docs/protocol/fixtures"

fn fixture_files(sub: String) : [String] / File =
  sort(dir.list_dir("#{FIXTURES}/#{sub}")) | (f => "#{FIXTURES}/#{sub}/#{f}")

fn lines_in(path: String) : [String] / File = fixture_lines(path)

# A valid line must decode and re-encode to itself, byte for byte.
fn request_problem(line: String) : Option[String] = match decode_request(line) {
  Err(e) -> Some("#{kind_name(e.kind)}: #{e.detail}\n  #{line}")
  Ok(m) -> {
    let again = encode_request(m.id, m.body)
    if again == line {
      None
    } else {
      Some("re-encodes differently\n  in:  #{line}\n  out: #{again}")
    }
  }
}

fn reply_problem(line: String) : Option[String] = match decode_reply(line) {
  Err(e) -> Some("#{kind_name(e.kind)}: #{e.detail}\n  #{line}")
  Ok(m) -> {
    let again = encode_reply(m.id, m.body)
    if again == line {
      None
    } else {
      Some("re-encodes differently\n  in:  #{line}\n  out: #{again}")
    }
  }
}

fn problems(sub: String, judge: (String) -> Option[String]) : [String] / File =
  flat_map(
    fixture_files(sub),
    path => flat_map(lines_in(path), l => tagged(path, judge(l)))
  )

fn tagged(path: String, p: Option[String]) : [String] = match p {
  Some(msg) -> ["#{path}: #{msg}"]
  None -> []
}

fn report(ps: [String]) : Bool / Stdout {
  ps |> each(p => print(p))
  ps == []
}

test "every kalku request fixture round-trips byte for byte" {
  assert report(problems("kalku/requests", request_problem))
}

test "every kalku reply fixture round-trips byte for byte" {
  assert report(problems("kalku/replies", reply_problem))
}

test "there is a fixture file for every kalku message type" {
  assert length(fixture_files("kalku/requests")) == 10
  assert length(fixture_files("kalku/replies")) == 12
}

# A kalku hands coverage over inline when it is small and in a file when
# it is not — which is every project big enough to be worth measuring.
# A reader that knows only the inline form loses exactly those projects'
# coverage, and then casts every wekufe against the whole suite while
# calling that suite the tests that cover it.
test "coverage spilled to a file decodes to the same entries as inline" {
  let text = """[{"file":"lib/a.ex","line":7,"tests":["test/a_test.exs:3"]},
                 {"file":"lib/b.ex","line":9,"tests":["test/b_test.exs:4","test/b_test.exs:8"]}]"""

  assert decode_coverage(text)
    == Ok([
      CoverageEntry { file: "lib/a.ex", line: 7, tests: ["test/a_test.exs:3"] },
      CoverageEntry { file: "lib/b.ex", line: 9, tests: ["test/b_test.exs:4", "test/b_test.exs:8"] }
    ])
}

# A coverage file is how a large project's coverage arrives, so reading it
# has to stay linear in its entries.
test "a coverage file of many entries decodes them all, in order" {
  let n = 20000
  let items =
    enumerate(list.repeat(0, n))
      | (p => "{\"file\":\"lib/a.ex\",\"line\":#{p.fst + 1},\"tests\":[\"t:1\"]}")
  let decoded = decode_coverage("[" ++ join(items, ",") ++ "]") |> unwrap_or([])

  assert length(decoded) == n
  assert (head(decoded) |> map(.line)) == Some(1)
  assert (last(decoded) |> map(.line)) == Some(n)
}

test "an empty coverage file is no coverage, not a failure" {
  assert decode_coverage("[]") == Ok([])
}

# Guessing at a coverage file that is not what it claims would put
# numbers nobody can trace behind a survivor's `covered by`.
test "a coverage file that is not an array of entries is refused" {
  assert is_err(decode_coverage("{\"file\":\"lib/a.ex\"}"))
  assert is_err(decode_coverage("not json at all"))
  assert is_err(decode_coverage("[{\"file\":\"lib/a.ex\"}]"))
}

# A fixture that cannot be read is a line no check accepts, so the test
# fails naming it instead of passing over nothing.
fn fixture_lines(path: String) : [String] / File = match file.read(path) {
  Ok(text) -> lines(text)
  Err(why) -> ["cannot read #{path}: #{why}"]
}
