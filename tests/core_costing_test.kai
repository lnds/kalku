import kalku.core.costing
import kalku.core.planner
import kalku.wire.shapes
import kalku.wire.enums

fn at(line: Int) : Site = Site {
  site_id: "s#{line}",
  file: "lib/a.ex",
  enclosing: Some("A.f/1"),
  ordinal: Some(1),
  span: Span { start: Position { line: line, col: 1, byte: 0 }, end: None },
  spell: Literal,
  original: Some("1"),
  replacement: "0",
  reload: ModuleOnly
}

fn cast_of(line: Int, tests: [String]) : Wekufe = Wekufe {
  site: at(line),
  tests: tests,
  rest: [],
  timeout_ms: 60000,
  casts: 1
}

fn took(ms: Int) : [(String, Int)] = [("t1", ms), ("t2", ms * 2)]

# A wekufe costs what the tests that judge it cost: that is the whole
# arithmetic, and it is why the number is worth printing rather than
# guessing at.
test "the work is the tests that judge each wekufe" {
  let casts = [cast_of(1, ["t1"]), cast_of(2, ["t1", "t2"])]

  assert tests_ms(casts, took(100)) == 100 + 100 + 200
}

# A test the baseline never timed contributes nothing rather than a
# number nobody measured.
test "a test with no timing costs nothing, not a guess" {
  assert tests_ms([cast_of(1, ["unknown"])], took(100)) == 0
  assert tests_ms([], took(100)) == 0
}

test "workers share the work" {
  let casts = [cast_of(1, ["t1", "t2"]), cast_of(2, ["t1", "t2"])]

  assert estimate_ms(casts, took(100), 1) == 600
  assert estimate_ms(casts, took(100), 2) == 300
  assert estimate_ms(casts, took(100), 0) == 0
}

# The words carry as much precision as the estimate has earned, and no
# more: nobody waits differently for eight minutes than for eight and a
# half.
test "the estimate is said in units someone can act on" {
  assert how_long(0) == "no time at all"
  assert how_long(900) == "no time at all"
  assert how_long(30000) == "under a minute"
  assert how_long(60000) == "1 minute"
  assert how_long(510000) == "9 minutes"
  assert how_long(7200000) == "2 hours"
}

# Rounding half up, so a run that takes a minute and a half is never
# announced as one that takes one.
test "an estimate never rounds its way down to nothing" {
  assert how_long(90000) == "2 minutes"
  assert how_long(61000) == "1 minute"
}

test "a run with nothing to cast promises nothing" {
  assert what_it_costs(estimate_ms([], took(100), 1), most_ms([], took(100), 1))
    == "this should be quick"
}

fn said_of(casts: [Wekufe], durations: [(String, Int)]) : String =
  what_it_costs(estimate_ms(casts, durations, 1), most_ms(casts, durations, 1))

fn says(said: String, part: String) : Bool = is_some(index_of(said, part))

test "a run that will take a while says so, and says what the number is" {
  let said = said_of(repeat(cast_of(1, ["t1", "t2"]), 100), took(1000))

  assert says(said, "about 5 minutes")
  assert says(said, "at the rate the baseline ran")
  assert says(said, "plus loading each wekufe")
  assert not says(said, "up to")
}

fn doubted(line: Int, tests: [String], rest: [String]) : Wekufe =
  Wekufe { ...cast_of(line, tests), rest: rest }

# Where the coverage is doubted, a wekufe its own tests do not kill faces
# the rest of the suite. Which ones will is only known by casting them, so
# the most a run can cost counts the rest for every one of them.
test "the most a run can cost counts the rest of the suite" {
  let casts = [doubted(1, ["t1"], ["t2"]), doubted(2, ["t2"], ["t1"])]

  assert tests_ms(casts, took(100)) == 300
  assert most_tests_ms(casts, took(100)) == 600
  assert most_ms(casts, took(100), 2) == 300
  assert most_ms([cast_of(1, ["t1", "t2"])], took(100), 1)
    == estimate_ms([cast_of(1, ["t1", "t2"])], took(100), 1)
}

# A hundred wekufe judged by a test of a second, with a suite of a minute
# behind each: the covering tests alone would announce two minutes for a
# run that can take more than an hour and a half.
test "a run whose coverage is doubted says the estimate is a floor" {
  let suite = [("t1", 1000), ("t2", 60000)]
  let said = said_of(repeat(doubted(1, ["t1"], ["t2"]), 100), suite)

  assert says(said, "at least 2 minutes and up to 2 hours")
  assert says(said, "the coverage is doubted")
  assert not says(said, "about")
}

test "a floor under a minute is not said as one" {
  let said = said_of(repeat(doubted(1, ["t1"], ["t2"]), 10), [("t1", 100), ("t2", 60000)])

  assert says(said, "up to 10 minutes")
  assert not says(said, "at least")
}

check "the most a run can cost is never less than its estimate" with a: Int, b: Int, n: Int {
  let durations = [("t1", abs(a) % 100000), ("t2", abs(b) % 100000)]
  let casts = [doubted(1, ["t1"], ["t2"]), cast_of(2, ["t2"])]
  let workers = 1 + abs(n) % 8
  most_ms(casts, durations, workers) >= estimate_ms(casts, durations, workers)
}

# More workers never make a run cost more, and neither does dropping a
# wekufe from it. An estimate that broke either rule would be describing
# something other than the run.
check "work never grows by adding a worker" with a: Int, b: Int {
  let casts = [cast_of(1, ["t1"]), cast_of(2, ["t2"])]
  let one = 1 + abs(a) % 8
  let more = one + abs(b) % 8
  estimate_ms(casts, took(100), more) <= estimate_ms(casts, took(100), one)
}
