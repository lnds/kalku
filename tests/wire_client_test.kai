import fs.dir
import fs.file
import kalku.wire.envelope
import kalku.wire.enums
import kalku.wire.shapes
import kalku.wire.client_msg
import kalku.wire.client_codec

const FIXTURES : String = "docs/protocol/fixtures"

fn fixture_files(sub: String) : [String] / File =
  sort(dir.list_dir("#{FIXTURES}/#{sub}")) | (f => "#{FIXTURES}/#{sub}/#{f}")

fn lines_in(path: String) : [String] / File = lines(file.read(path))

# A valid line must decode and re-encode to itself, byte for byte.
fn request_problem(line: String) : Option[String] = match decode_client_request(line) {
  Err(e) -> Some("#{kind_name(e.kind)}: #{e.detail}\n  #{line}")
  Ok(m) -> {
    let again = encode_client_request(m.id, m.body)
    if again == line {
      None
    } else {
      Some("re-encodes differently\n  in:  #{line}\n  out: #{again}")
    }
  }
}

fn event_problem(line: String) : Option[String] = match decode_event(line) {
  Err(e) -> Some("#{kind_name(e.kind)}: #{e.detail}\n  #{line}")
  Ok(m) -> {
    let again = encode_event(m.id, m.body)
    if again == line {
      None
    } else {
      Some("re-encodes differently\n  in:  #{line}\n  out: #{again}")
    }
  }
}

fn problems(sub: String, judge: (String) -> Option[String]) : [String] / File =
  flat_map(
    fixture_files(sub),
    path => flat_map(lines_in(path), l => tagged(path, judge(l)))
  )

fn tagged(path: String, p: Option[String]) : [String] = match p {
  Some(msg) -> ["#{path}: #{msg}"]
  None -> []
}

fn report(ps: [String]) : Bool / Stdout {
  ps |> each(p => Stdout.print(p))
  ps == []
}

test "every client request fixture round-trips byte for byte" {
  assert report(problems("client/requests", request_problem))
}

test "every server event fixture round-trips byte for byte" {
  assert report(problems("client/events", event_problem))
}

test "there is a fixture file for every client message type" {
  assert length(fixture_files("client/requests")) == 6
  assert length(fixture_files("client/events")) == 10
}

fn progress_with(estimate: Option[Int]) : Result[Unit, ProtocolError] = match decode_event(
  encode_event(1, ProgressEv(RunProgressMsg { done: 0, total: 480, estimate_ms: estimate }))
) {
  Ok(_) -> Ok(())
  Err(e) -> Err(e)
}

# The estimate is what a client decides on — whether to wait out the run
# or refuse it — so a number that could not describe a duration is refused
# at the edge rather than shown to someone as a time.
test "an estimate is a duration or it is not there at all" {
  assert progress_with(Some(540000)) == Ok(())
  assert progress_with(Some(0)) == Ok(())
  assert progress_with(None) == Ok(())
  assert progress_with(Some(0 - 1)) != Ok(())
}

fn run_with(shard: Option[Shard]) : Result[Unit, ProtocolError] = match decode_client_request(
  encode_client_request(1, RunReq(RunMsg { root: ".", scope: All, format: Human, shard: shard }))
) {
  Ok(_) -> Ok(())
  Err(e) -> Err(e)
}

fn refused(shard: Option[Shard]) : Bool = match run_with(shard) {
  Ok(_) -> false
  Err(_) -> true
}

# `3/3` is the last shard of a sharded run and the one a CI matrix always
# has, so a bound that excluded it would refuse a third of every run.
test "a shard index at either end of its range is accepted" {
  assert run_with(Some(Shard { index: 1, count: 1 })) == Ok(())
  assert run_with(Some(Shard { index: 3, count: 3 })) == Ok(())
  assert run_with(Some(Shard { index: 1, count: 3 })) == Ok(())
  assert run_with(None) == Ok(())
  assert refused(Some(Shard { index: 0, count: 3 }))
  assert refused(Some(Shard { index: 4, count: 3 }))
}
