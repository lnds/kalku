import core.list as list
import core.string as string
import fs.dir
import fs.file
import kalku.wire.envelope
import kalku.wire.client_codec

const FIXTURES : String = "docs/protocol/fixtures"

fn fixture_files(sub: String) : [String] / File =
  list.sort(dir.list_dir("#{FIXTURES}/#{sub}")) | (f => "#{FIXTURES}/#{sub}/#{f}")

fn lines_in(path: String) : [String] / File = string.lines(file.read(path))

# A valid line must decode and re-encode to itself, byte for byte.
fn request_problem(line: String) : Option[String] = match decode_client_request(line) {
  Err(e) -> Some("#{kind_name(e.kind)}: #{e.detail}\n  #{line}")
  Ok(m) -> {
    let again = encode_client_request(m.id, m.body)
    if again == line {
      None
    } else {
      Some("re-encodes differently\n  in:  #{line}\n  out: #{again}")
    }
  }
}

fn event_problem(line: String) : Option[String] = match decode_event(line) {
  Err(e) -> Some("#{kind_name(e.kind)}: #{e.detail}\n  #{line}")
  Ok(m) -> {
    let again = encode_event(m.id, m.body)
    if again == line {
      None
    } else {
      Some("re-encodes differently\n  in:  #{line}\n  out: #{again}")
    }
  }
}

fn problems(sub: String, judge: (String) -> Option[String]) : [String] / File =
  list.flat_map(
    fixture_files(sub),
    path => list.flat_map(lines_in(path), l => tagged(path, judge(l)))
  )

fn tagged(path: String, p: Option[String]) : [String] = match p {
  Some(msg) -> ["#{path}: #{msg}"]
  None -> []
}

fn report(ps: [String]) : Bool / Stdout {
  ps |> each(p => Stdout.print(p))
  ps == []
}

test "every client request fixture round-trips byte for byte" {
  assert report(problems("client/requests", request_problem))
}

test "every server event fixture round-trips byte for byte" {
  assert report(problems("client/events", event_problem))
}

test "there is a fixture file for every client message type" {
  assert list.length(fixture_files("client/requests")) == 6
  assert list.length(fixture_files("client/events")) == 10
}
