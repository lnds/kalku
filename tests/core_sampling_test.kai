import kalku.wire.shapes
import kalku.core.sampling

fn ids(n: Int) : [String] = enumerate(repeat(0, n)) | (i => "w#{i.fst}")

fn me(s: String) : String = s

fn counts(killed: Int, survived: Int) : Counts = Counts {
  killed: killed,
  survived: survived,
  timeout: 0,
  no_coverage: 0,
  compile_error: 0,
  crashed: 0,
  nondeterministic: 0,
  equivalent: EquivalentCounts { bytecode: 0, declared: 0 }
}

test "a sample holds as many wekufe as were asked for, in the order the plan had them" {
  let plan = ids(500)
  let s = drawn(plan, me, 40)
  assert list.length(s) == 40
  assert s == (plan |? (id => contains(s, id)))
}

test "a sample of more than the plan holds is the whole plan" {
  assert drawn(ids(7), me, 40) == ids(7)
}

# A plan runs file by file, so taking its first wekufe measures its first
# files: a sample draws from all of it.
test "a sample is not the start of the plan" {
  assert drawn(ids(500), me, 40) != take(ids(500), 40)
}

# Two runs that found the same wekufe in another order draw the same ones,
# which is what lets two samples be compared.
check "a sample does not depend on the order the wekufe were found in" with n: Int {
  let plan = ids(1 + abs(n) % 300)
  let k = 1 + abs(n) % 50
  sort(drawn(list.reverse(plan), me, k)) == sort(drawn(plan, me, k))
}

test "a sample with nothing killed or survived has no range" {
  assert margin(counts(0, 0), Sampled { drawn: 10, of: 100 }) == None
}

test "a sample of a tenth of the plan puts the score in a range around it" {
  let m = margin(counts(70, 30), Sampled { drawn: 100, of: 1000 })
  assert (m |> option.map(r => (percent(r.low), percent(r.high)))) == Some(("60.9%", "77.7%"))
}

# Every wekufe of a sample killed is not proof that every wekufe of the
# project would be.
test "a sample that killed everything does not say the project would" {
  let m = margin(counts(50, 0), Sampled { drawn: 50, of: 4000 })
  assert (m |> option.map(r => (percent(r.low), percent(r.high)))) == Some(("92.9%", "100%"))
}

test "the more of the plan a sample holds, the narrower the range, down to the score" {
  let most = margin(counts(70, 30), Sampled { drawn: 100, of: 101 })
  assert (most |> option.map(r => (percent(r.low), percent(r.high)))) == Some(("69.1%", "70.9%"))
  let all = margin(counts(70, 30), Sampled { drawn: 100, of: 100 })
  assert (all |> option.map(r => (percent(r.low), percent(r.high)))) == Some(("70%", "70%"))
}

check "the range lies within 0 and 1 and holds the sample's score" with n: Int {
  let killed = abs(n) % 200
  let survived = abs(n / 7) % 200
  let drawn_ = killed + survived + 1
  match margin(counts(killed, survived), Sampled { drawn: drawn_, of: drawn_ * 3 }) {
    None -> killed + survived == 0
    Some(r) -> {
      let p = int_to_real(killed) / int_to_real(killed + survived)
      r.low >= 0.0 and r.high <= 1.0 and r.low <= p and p <= r.high
    }
  }
}

test "a sample says what it cast of what, and where the whole project's score lies" {
  assert sample_line(counts(70, 30), Sampled { drawn: 100, of: 1000 })
    == "SAMPLE: 100 of 1000 wekufe, the whole project's score likely 60.9% to 77.7%"
  assert sample_line(counts(0, 0), Sampled { drawn: 3, of: 1000 }) == "SAMPLE: 3 of 1000 wekufe"
}
