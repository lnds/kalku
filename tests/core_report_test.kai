import kalku.wire.enums
import kalku.wire.shapes
import kalku.core.verdict
import kalku.core.gate
import kalku.core.report
import kalku.core.changed_lines
import kalku.core.report_json
import kalku.core.report_github

fn site_of(
  file: String,
  line: Int,
  enclosing: Option[String],
  original: Option[String],
  replacement: String
) : Site =
  Site {
    site_id: "id-#{file}-#{line}",
    file: file,
    enclosing: enclosing,
    ordinal: Some(1),
    span: Span { start: Position { line: line, col: 7, byte: 0 }, end: None },
    spell: Compare,
    original: original,
    replacement: replacement,
    reload: ModuleOnly
  }

fn compare_site() : Site = site_of("lib/a.ex", 42, Some("A.f/1"), Some(">="), ">")

fn arm_site() : Site = site_of("lib/b.ex", 7, None, Some("  nil -> :eof"), "")

fn no_suppressions() : SuppressionChanges =
  SuppressionChanges { equivalent_added: 0, exclude_added: [], exclude_calls_added: [] }

fn report_of(survivors: [Survivor], counts: Counts, blockers: [Blocker]) : Report =
  Report {
    counts: counts,
    planned: 0,
    survivors: survivors,
    on_changed_lines: length(blockers),
    suppressions: no_suppressions(),
    troubles: [],
    skipped: [],
    uncovered: [],
    blockers: blockers
  }

fn plain() : Report =
  report_of(
    [Survivor { site: compare_site(), tests: ["test/a_test.exs:18"], chosen: true }],
    tally([Cast(Killed), Cast(Survived)]),
    []
  )

fn has(text: String, needle: String) : Bool = is_some(index_of(text, needle))

test "a survivor reads as a place, a spell, and the change that made it" {
  let s = Survivor { site: compare_site(), tests: ["test/a_test.exs:18"], chosen: true }
  assert location(s) == "lib/a.ex:42  compare  A.f/1"
  assert diff_of(compare_site()) == ["- >=", "+ >"]
}

test "a deletion shows only what it removed" {
  assert diff_of(arm_site()) == ["-   nil -> :eof"]
}

test "the human report leads with survivors and closes with the summary" {
  let text = human(plain())
  assert starts_with(
    text,
    "lib/a.ex:42  compare  A.f/1\n  - >=\n  + >\n  covered by test/a_test.exs:18"
  )
  assert has(text, "score 50% · 1 killed · 1 survived")
}

test "a survivor no test covers says so" {
  let lonely = Survivor { site: arm_site(), tests: [], chosen: true }
  assert has(human(report_of([lonely], tally([Cast(Survived)]), [])), "no test covers it")
}

# Past a few, the tests that cover a site are counted: naming every one
# buries the diff.
test "a survivor many tests cover counts the tests it does not name" {
  let many =
    Survivor {
      site: arm_site(),
      tests: enumerate(list.repeat("t", 10)) | (p => "t#{p.fst}"),
      chosen: true
    }
  let text = human(report_of([many], tally([Cast(Survived)]), []))

  assert has(text, "covered by 10 tests")
}

# Without per-test coverage a survivor is judged by the whole suite, and
# that used to be reported as the tests that cover it: every survivor of a
# small service "covered by" all of its 105 tests, most of them in files
# that never touch the module.
test "a survivor the whole suite judged is not said to be covered by it" {
  let whole =
    Survivor {
      site: arm_site(),
      tests: enumerate(list.repeat("t", 105)) | (p => "t#{p.fst}"),
      chosen: false
    }
  let text = human(report_of([whole], tally([Cast(Survived)]), []))

  assert has(text, "judged by the whole suite, 105 test(s)")
  assert has(text, "was not measured")
  assert not has(text, "covered by")
}

test "the summary reports apart what never entered the score" {
  let counts = tally([
    Cast(Killed),
    Cast(Survived),
    Cast(Timeout),
    Cast(NoCoverage),
    Cast(CompileError),
    Cast(Crashed),
    EquivalentBy(Bytecode),
    EquivalentBy(Declared)
  ])
  assert summary_line(report_of([], counts, []))
    == "score 50% · 1 killed · 1 survived · 1 timeout · 1 no coverage · 1 compile error · 1 crashed · 2 equivalent (1 bytecode, 1 declared)"
}

# A survivor is only half the news; the other half is what to do about
# it, and a reader should not have to go looking for it.
test "every survivor is followed by what to do about it" {
  let text = human(plain())
  assert has(text, "No test tells")
  assert has(text, "Add a case at the boundary")
}

test "a run with nothing to kill says n/a, never 100%" {
  assert has(summary_line(report_of([], tally([Cast(Timeout)]), [])), "score n/a")
}

test "suppressions a change adds are as loud as the holes it leaves" {
  let noisy = Report {
    ...plain(),
    suppressions: SuppressionChanges {
      equivalent_added: 2,
      exclude_added: ["lib/gen/**"],
      exclude_calls_added: ["Logger.*"]
    }
  }
  let text = human(noisy)
  assert has(text, "Suppressions added in this change:")
  assert has(text, "2 declared equivalent")
  assert has(text, "wider exclusion: lib/gen/**")
  assert has(text, "wider exclusion: Logger.*")
}

# A change that suppressed nothing says nothing: "0 declared equivalent"
# under a "suppressions added" heading reads as a suppression that was
# added, which is exactly the thing this section exists to make loud.
test "a change that added no equivalents does not list them" {
  let only_excludes = Report {
    ...plain(),
    suppressions: SuppressionChanges {
      equivalent_added: 0,
      exclude_added: ["lib/gen/**"],
      exclude_calls_added: []
    }
  }
  let text = human(only_excludes)
  assert has(text, "wider exclusion: lib/gen/**")
  assert not has(text, "declared equivalent")
  assert not has(step_summary(only_excludes), "declared equivalent")
}

test "what blocks the run is stated, not implied" {
  let blocked = report_of([], tally([Cast(Killed)]), [SurvivorsOnChangedLines(2)])
  assert has(human(blocked), "blocked: 2 wekufe survived on lines this change touched")
}

test "the json report carries the score, the counts, and every survivor" {
  let text = json(plain(), 1)
  assert has(text, "\"score\":0.5")
  assert has(
    text,
    "\"survivors\":[{\"wekufe\":\"id-lib/a.ex-42\",\"file\":\"lib/a.ex\",\"enclosing\":\"A.f/1\",\"line\":42,\"spell\":\"compare\",\"original\":\">=\",\"replacement\":\">\",\"covering_tests\":[\"test/a_test.exs:18\"]}]"
  )
  assert has(text, "\"exit\":1")
}

test "the json report omits a score that does not exist" {
  let text = json(report_of([], tally([Cast(Timeout)]), []), 0)
  assert not has(text, "\"score\"")
  assert has(text, "\"timeout\":1")
}

test "a github annotation points at the line that survived" {
  assert annotations(plain()) == "::warning file=lib/a.ex,line=42,title=survived: compare::- >= + >"
}

test "the step summary tables the survivors" {
  let text = step_summary(plain())
  assert starts_with(text, "## kalku")
  assert has(text, "| `lib/a.ex:42` | compare | `- >= + >` |")
  assert has(step_summary(report_of([], tally([Cast(Killed)]), [])), "No survivors.")
}

# An outcome outside the score still has to be actionable: `1 compile
# error` with no reason leaves a reader with nothing to fix.
test "an outcome outside the score is reported with what the kalku said" {
  let troubled = Report {
    ...plain(),
    troubles: [
      Trouble {
        wekufe: "lib/a.ex:42:compare",
        at: Some(compare_site()),
        outcome: CompileError,
        said: Some("error: cannot find `f` in this scope\n  --> lib/a.ex:42\n")
      }
    ]
  }
  let text = human(troubled)

  assert has(text, "what could not be measured:")
  # Where it was cast, not the id it was cast under: a reader can open one
  # of those.
  assert has(text, "lib/a.ex:42  compare  A.f/1  compile_error")
  assert has(text, "error: cannot find `f` in this scope")
}

# A line no test reaches is a hole too, and a larger one than a wekufe
# that survived: there was nothing there to notice it.
test "a site no test reaches is named, not just counted" {
  let nothing_reaches = Report { ...plain(), uncovered: [arm_site()] }
  let text = human(nothing_reaches)

  assert has(text, "no test reaches these:")
  assert has(text, "lib/b.ex:7  compare")
}

# A run that cast part of what it planned reports a score over that part.
# Saying so is the precondition for any limit at all: a reader who takes a
# limited run's score for the file's score has been misled by silence, and
# a number that answers a question nobody asked is what this tool exists
# to refuse.
test "a partial run says so before it says its score" {
  let counts = tally([
    Cast(Killed),
    Cast(Killed),
    Cast(Killed),
    Cast(Killed),
    Cast(Survived),
    Cast(Survived)
  ])
  let base = report_of([], counts, [])
  let whole = human(Report { ...base, planned: 6 })
  let part = human(Report { ...base, planned: 40 })

  assert not has(whole, "PARTIAL")
  assert has(part, "PARTIAL: 6 of 40 planned wekufe")
  assert index_of(part, "PARTIAL") < index_of(part, "score")
}

fn survivor_on(file: String, line: Int) : Survivor =
  Survivor { site: site_of(file, line, Some("A.f/1"), Some(">="), ">"), tests: [], chosen: true }

fn change(file: String, from: Int, to: Int) : FileChange =
  FileChange { file: file, ranges: [LineRange { from: from, to: to }] }

# The gate on changed lines is made of this number, so it has to come from
# the diff: a survivor on a line the change added is a hole the change
# introduced, and the same survivor elsewhere in the file is old debt.
test "survivors are counted where the change touched, and only there" {
  let changes = [change("lib/a.ex", 40, 45)]
  let survivors = [
    survivor_on("lib/a.ex", 42),
    survivor_on("lib/a.ex", 7),
    survivor_on("lib/b.ex", 42)
  ]

  assert on_lines(changes, survivors) == 1
}

# The ends of a range are inside it, and a file the change did not touch
# contributes nothing however many survivors it holds.
test "both ends of a touched range count" {
  let changes = [change("lib/a.ex", 40, 45)]

  assert on_lines(changes, [survivor_on("lib/a.ex", 40), survivor_on("lib/a.ex", 45)]) == 2
  assert on_lines(changes, [survivor_on("lib/a.ex", 39), survivor_on("lib/a.ex", 46)]) == 0
}

test "no change touched means none counted" {
  assert on_lines([], [survivor_on("lib/a.ex", 1)]) == 0
}

# The other half of what a change can put in front of the tests: code that
# was added and never run. Only the lines the change touched count; an
# uncovered site elsewhere in the file is old debt.
test "unreached sites are counted where the change touched, and only there" {
  let changes = [change("lib/a.ex", 10, 14)]
  let sites = [
    site_of("lib/a.ex", 12, Some("A.f/1"), Some(">="), ">"),
    site_of("lib/a.ex", 3, Some("A.g/1"), Some(">="), ">"),
    site_of("lib/b.ex", 12, Some("B.f/1"), Some(">="), ">")
  ]

  assert uncovered_on_lines(changes, sites) == 1
  assert uncovered_on_lines([], sites) == 0
}

# A score over what was searched, said as if it were the score of what was
# asked, is the quiet way to be wrong: the file that would not parse has to
# be on the page.
test "a file that was not searched is named with why, above the summary" {
  let skipped = Report {
    ...plain(),
    skipped: [Skipped { file: "lib/b.ex", reason: "parse_error", message: "line 3" }]
  }
  let text = human(skipped)

  assert has(text, "files that were not searched:\n  lib/b.ex: parse_error: line 3")
  assert index_of(text, "files that were not searched") < index_of(text, "score ")
  assert not has(human(plain()), "not searched")
}
