#!/bin/sh
# Summons the Elixir kalku with a protocol channel nobody else has written
# to.
#
# stdout carries the protocol. mix writes what it compiles to stdout, and
# it writes it before the kalku exists, so the loop cannot silence it from
# the inside: one `==> kalku_elixir` ahead of the handshake and the kaikai
# side banishes the worker for writing nonsense. The build goes to stderr
# here, and only then does the loop take over the channel.
#
#   MIX_BUILD_PATH=<reni>/build bin/kalku-elixir
#
# Run from the root of the project to be measured.
set -eu

MIX_ENV=test
export MIX_ENV

if [ -z "${MIX_BUILD_PATH:-}" ]; then
  echo "kalku-elixir: MIX_BUILD_PATH must point inside the reni, so this" >&2
  echo "  run cannot write into the project's own _build." >&2
  exit 2
fi

# rebar3 keeps a cache of its own in `_build` under each dependency it
# builds, whatever Mix was told about where the build goes. Its base
# directory goes into the reni with the rest.
REBAR_BASE_DIR="$MIX_BUILD_PATH/rebar3"
export REBAR_BASE_DIR

# Dependencies first, with their output where it belongs and with no
# access to stdin: stdin is the protocol, and a build that reads even one
# byte of it leaves the loop at end of input before its first request.
mix deps.compile >&2 </dev/null

# Mix builds a dependency given by path again whenever a task starts, and
# says so on stdout before the task has run a line. The task quiets the
# shell once it is running; this quiets it for what comes before.
MIX_QUIET=1
export MIX_QUIET

# `exec` hands the process to the kalku, so a signal reaches it rather
# than a shell that would outlive it.
if grep -q kalku_elixir mix.exs 2>/dev/null; then
  exec mix kalku.serve "$@"
fi

# A project that does not depend on the kalku is measured all the same,
# and is not changed to do it: the kalku is compiled into the reni, beside
# the project's build, and put on the code path of this one runtime.
HERE="$(cd "$(dirname "$0")/.." && pwd -P)"
EBIN="$MIX_BUILD_PATH/kalku_elixir/ebin"
elixir "$HERE/bin/build.exs" "$HERE" "$EBIN" >&2 </dev/null
exec elixir -pa "$EBIN" -S mix kalku.serve "$@"
