import os.process as proc
import fs.file
import encoding.json
import encoding.json_bind
import time

# The kalku is driven as the kaikai side drives it: a real binary, a real
# pipe, a real package to measure. Nothing smaller proves it works.
const KALKU : String = "./bin/kalku-kaikai"

const TINY : String = "fixtures/tiny"

# Outside the package, deliberately: a reni inside it would be copied
# into itself, which the kalku now refuses (and there is a test for that).
fn reni() : String = "fixtures/reni"

fn hello() : String =
  "{\"type\":\"hello\",\"id\":1,\"protocol\":1,\"root\":\"#{TINY}\",\"reni\":\"#{reni()}\",\"worker\":0,\"inline_limit_bytes\":65536,\"env\":{}}"

fn hello_with(options: String) : String =
  "{\"type\":\"hello\",\"id\":1,\"protocol\":1,\"root\":\"#{TINY}\",\"reni\":\"#{reni()}\",\"worker\":0,\"inline_limit_bytes\":65536,\"env\":{},\"options\":#{options}}"

fn cast(id: Int, wekufe: String, from: Int, to: Int, replacement: String) : String =
  "{\"type\":\"cast\",\"id\":#{id},\"wekufe\":\"#{wekufe}\",\"site\":{\"site_id\":\"s#{id}\",\"file\":\"tiny.kai\",\"span\":{\"start\":{\"line\":1,\"col\":1,\"byte\":#{from}},\"end\":{\"line\":1,\"col\":1,\"byte\":#{to}}},\"spell\":\"compare\",\"replacement\":\"#{replacement}\",\"reload\":\"module\"},\"tests\":[]}"

# Everything the kalku says, given everything it is asked.
fn told(requests: [String]) : [String] / Process + File {
  let asked = join(requests ++ ["{\"type\":\"shutdown\",\"id\":99}"], "\n") ++ "\n"
  match proc.start_piped(KALKU, []) {
    Err(e) -> ["cannot start the kalku: #{e}"]
    Ok(child) -> {
      let _ = proc.write_stdin(child, asked)
      let _ = proc.close_stdin(child)
      let out = drain(child, "")
      let _ = proc.wait(child)
      lines(out)
    }
  }
}

fn drain(child: Child, so_far: String) : String / Process = match proc.read_stdout(child) {
  Err(_) -> so_far
  Ok(chunk) -> if is_empty(chunk) { so_far } else { drain(child, so_far ++ chunk) }
}

fn outcome_of(said: [String], wekufe: String) : String = match find(
  said,
  l => is_some(index_of(l, "\"wekufe\":\"#{wekufe}\""))
) {
  Some(line) -> field(line, "outcome")
  None -> "nothing said about #{wekufe}"
}

fn field(line: String, name: String) : String = match json_decode(line) {
  Some(v) -> (get(v, name) || as_string) ?? ""
  None -> ""
}

fn has(text: String, needle: String) : Bool = is_some(index_of(text, needle))

# `above/2` shifts `>=` to `>` at byte 305, and a test covers the
# boundary. `clamp/1` shifts `>` to `>=` at byte 523, and no test goes
# near zero — the hole planted on purpose. Both spans sit after a dash in
# the fixture, so a splice that counted codepoints would land two bytes
# along and measure something else.
test "the three outcomes a cast can have, against a real package" {
  let said = told([
    hello(),
    "{\"type\":\"prepare\",\"id\":2}",
    cast(3, "covered", 305, 307, ">"),
    cast(4, "uncovered", 523, 524, ">="),
    cast(5, "broken", 523, 524, "@")
  ])

  assert outcome_of(said, "covered") == "killed"
  assert outcome_of(said, "uncovered") == "survived"
  assert outcome_of(said, "broken") == "compile_error"
}

# A kill names the test that noticed, so a report can point at it.
test "a kill names the test that noticed" {
  let said = told([hello(), "{\"type\":\"prepare\",\"id\":2}", cast(3, "covered", 305, 307, ">")])
  let line = find(said, l => has(l, "\"wekufe\":\"covered\"")) |> unwrap_or("")

  assert has(field(line, "killed_by"), "tests/tiny_test.kai")
}

test "it greets as a kaikai kalku and claims only what it can do" {
  let ready = head(told([hello()])) |> unwrap_or("")

  assert field(ready, "type") == "ready"
  assert field(ready, "language") == "kaikai"
  # No warm runtime to reload into and nothing shared to dirty: a
  # capability is claimed only once it is true.
  assert has(ready, "\"cast\"")
  assert has(ready, "\"per_test_coverage\"")
  assert has(ready, "\"abort\"")
  assert has(ready, "\"cast_after_baseline\"")
  assert has(ready, "\"partial_baseline\"")
  assert not has(ready, "hot_load")
  assert not has(ready, "reset")
}

# An oracle judges the package as one test and says nothing of lines.
test "under an oracle no coverage is claimed" {
  let ready = head(told([hello_with("{\"oracle\":\"kai test .\"}")])) |> unwrap_or("")
  assert field(ready, "type") == "ready"
  assert not has(ready, "per_test_coverage")
}

fn baseline_line(said: [String]) : String =
  find(said, l => has(l, "\"type\":\"baseline_done\"")) |> unwrap_or("")

# Each line is credited to the tests that ran it, as `kai test --coverage`
# says them. `clamp/1` is run by one test only, and `wrapped/1`'s line by
# another, so a wekufe in either faces that test and no other.
test "a baseline says which tests ran which lines" {
  let line = baseline_line(
    told([
      hello(),
      "{\"type\":\"prepare\",\"id\":2}",
      "{\"type\":\"baseline\",\"id\":3}"
    ])
  )
  assert field(line, "status") == "green"
  assert has(
    line,
    "{\"file\":\"tiny.kai\",\"line\":10,\"tests\":[\"tests/tiny_test.kai:clamp keeps a positive number\"]}"
  )
  assert has(
    line,
    "{\"file\":\"tiny.kai\",\"line\":7,\"tests\":[\"tests/also_test.kai:total of nothing is nothing\",\"tests/tiny_test.kai:total adds\"]}"
  )
  assert not has(line, "tests/tiny_test.kai\",\"line\"")
}

# Coverage larger than `hello` allows on a line goes to a file in the reni.
test "coverage over the inline limit is written to a file" {
  let tight =
    "{\"type\":\"hello\",\"id\":1,\"protocol\":1,\"root\":\"#{TINY}\",\"reni\":\"#{reni()}\",\"worker\":0,\"inline_limit_bytes\":10,\"env\":{}}"
  let line = baseline_line(
    told([
      tight,
      "{\"type\":\"prepare\",\"id\":2}",
      "{\"type\":\"baseline\",\"id\":3}"
    ])
  )
  let path = field(line, "coverage_path")
  assert path == "#{reni()}/coverage-0.json"
  assert not has(line, "\"coverage\":")
  assert has(ok(file.read(path)) ?? "", "clamp keeps a positive number")
}

# Thousands of covered lines are said as surely as a handful: the kalku
# serves on a fiber, whose stack is small.
test "a baseline with thousands of covered lines is said in full" {
  let wide =
    "{\"type\":\"hello\",\"id\":1,\"protocol\":1,\"root\":\"fixtures/wide\",\"reni\":\"#{reni()}/wide\",\"worker\":0,\"inline_limit_bytes\":65536,\"env\":{}}"
  let line = baseline_line(
    told([
      wide,
      "{\"type\":\"prepare\",\"id\":2}",
      "{\"type\":\"baseline\",\"id\":3}"
    ])
  )
  assert field(line, "status") == "green"
  let path = field(line, "coverage_path")
  assert path == "#{reni()}/wide/coverage-0.json"
  assert has(ok(file.read(path)) ?? "", "{\"file\":\"wide.kai\",\"line\":3004,")
}

test "sites come from kaikai's own parser, with the span and text to match" {
  let said = told([
    hello(),
    "{\"type\":\"prepare\",\"id\":2}",
    "{\"type\":\"sites\",\"id\":3,\"files\":[\"tiny.kai\"],\"spells\":[\"compare\"],\"exclude_calls\":[]}"
  ])
  let found = find(said, l => has(l, "sites_found")) |> unwrap_or("")

  assert has(found, "\"enclosing\":\"tiny.above/2\"")
  assert has(found, "\"original\":\">=\"")
  assert has(found, "\"byte\":305")
}

# A reni inside the package would be copied into itself until the path
# ran out of room, filling a disk with copies of someone's project on the
# way. Refused before anything is copied.
test "a reni inside the package is refused rather than nested" {
  let nested =
    "{\"type\":\"hello\",\"id\":1,\"protocol\":1,\"root\":\"#{TINY}\",\"reni\":\"#{TINY}/inner\",\"worker\":0,\"inline_limit_bytes\":65536,\"env\":{}}"
  let said = told([nested, "{\"type\":\"prepare\",\"id\":2}"])
  let answer = find(said, l => has(l, "\"id\":2")) |> unwrap_or("")

  assert field(answer, "type") == "error"
  assert field(answer, "code") == "prepare_failed"
  assert has(field(answer, "message"), "inside the package")
  assert not file.exists("#{TINY}/inner")
}

# Tier 1: the package being measured is left exactly as it was found.
test "the package under test is never written to" {
  let before = file.read("#{TINY}/tiny.kai")

  let _ = told([
    hello(),
    "{\"type\":\"prepare\",\"id\":2}",
    cast(3, "covered", 305, 307, ">")
  ])

  assert file.read("#{TINY}/tiny.kai") == before
  assert not file.exists("#{TINY}/.kai-cache")
}

# A wekufe can take the runtime down with it: `n % 0` traps, and the tests
# that would have judged it never run. Their silence is not the suite
# failing to notice — it is the kalku failing to measure, and saying
# `survived` here would be the loudest possible lie.
test "a wekufe that stops the run is not a wekufe that survived" {
  let said = told([
    hello(),
    "{\"type\":\"prepare\",\"id\":2}",
    cast(3, "trapping", 794, 796, "0")
  ])

  assert outcome_of(said, "trapping") == "crashed"
}

# ---- a run that is gone -------------------------------------------------

const SLOW : String = "fixtures/slow"

fn slow_reni() : String = "#{reni()}/slow"

fn slow_hello() : String = replace(replace(hello(), reni(), slow_reni()), TINY, SLOW)

# A run that is killed asks nothing of its kalku: the input just ends, with
# no `shutdown` on it, in the middle of a suite that has a minute left to
# run. What is told is what is still there two seconds later.
fn orphaned(requests: [String]) : [String] / Process + File + Clock {
  let _ = heard("/bin/rm", ["-rf", slow_reni()])
  match proc.start_piped(KALKU, []) {
    Err(e) -> ["cannot start the kalku: #{e}"]
    Ok(kalku) -> {
      let _ = proc.write_stdin(kalku, join(requests, "\n") ++ "\n")
      let left = match started("#{slow_reni()}/work/0/child.pid", 600) {
        None -> ["the suite never started its program"]
        Some(program) -> {
          let _ = proc.close_stdin(kalku)
          sleep(seconds(2))
          still_there("#{kalku.pid}", "the kalku") ++ still_there(program, "what its suite started")
        }
      }
      let _ = proc.kill(kalku, 9)
      let _ = proc.wait(kalku)
      left
    }
  }
}

# The program the slow suite started, once it has said which.
fn started(pidfile: String, tries: Int) : Option[String] / File + Clock {
  let said = trim(ok(file.read(pidfile)) ?? "")
  if not is_empty(said) {
    Some(said)
  } else if tries == 0 {
    None
  } else {
    sleep(millis(100))
    started(pidfile, tries - 1)
  }
}

# Named if it is still running, and killed, so that a failure leaves
# nothing behind. A process that ended and was not reaped yet is a zombie:
# it has a line in `ps`, but it is not running.
fn still_there(pid: String, name: String) : [String] / Process {
  let state = trim(heard("/bin/ps", ["-o", "stat=", "-p", pid]))
  if is_empty(state) or starts_with(state, "Z") {
    []
  } else {
    let _ = heard("/bin/kill", ["-9", pid])
    [name]
  }
}

fn heard(cmd: String, args: [String]) : String / Process = match proc.pipe_from(cmd, args) {
  Err(_) -> ""
  Ok(child) -> {
    let out = drain(child, "")
    let _ = proc.wait(child)
    out
  }
}

test "a kalku whose run is gone ends in the middle of a baseline, with what it started" {
  let left =
    orphaned([slow_hello(), "{\"type\":\"prepare\",\"id\":2}", "{\"type\":\"baseline\",\"id\":3}"])

  assert left == []
}

# Between requests there is nothing to cancel, and the kalku ends all the same.
test "a kalku whose run is gone ends with nothing under way too" {
  let left = match proc.start_piped(KALKU, []) {
    Err(e) -> ["cannot start the kalku: #{e}"]
    Ok(kalku) -> {
      let _ = proc.write_stdin(kalku, hello() ++ "\n")
      let _ = proc.read_stdout(kalku)
      let _ = proc.close_stdin(kalku)
      sleep(seconds(1))
      let there = still_there("#{kalku.pid}", "the kalku")
      let _ = proc.wait(kalku)
      there
    }
  }

  assert left == []
}

# `above/2` in the slow package shifts `>=` to `>` at byte 156.
test "a kalku whose run is gone ends in the middle of a cast, and the package is as it was" {
  let before = file.read("#{SLOW}/slow.kai")
  let left = orphaned([
    slow_hello(),
    "{\"type\":\"prepare\",\"id\":2}",
    replace(cast(3, "slow", 156, 158, ">"), "tiny.kai", "slow.kai")
  ])

  assert left == []
  assert file.read("#{SLOW}/slow.kai") == before
}

fn error_of(said: [String]) : String =
  find(said, l => has(l, "\"type\":\"error\""))
    |> map(
      l => "#{field(l, "code")}: #{field(l, "message")}"
    )
    |> unwrap_or("no error")

# An oracle is any command, judged by its exit status alone. `kai test`
# exits non-zero when a test fails, so as an oracle it kills what the
# suite kills, and the kill names the oracle.
test "a project's oracle judges a wekufe by how it exits" {
  let said = told([
    hello_with("{\"oracle\":\"kai test .\"}"),
    "{\"type\":\"prepare\",\"id\":2}",
    cast(3, "covered", 305, 307, ">"),
    cast(4, "uncovered", 523, 524, ">="),
    cast(5, "broken", 523, 524, "@")
  ])

  assert outcome_of(said, "covered") == "killed"
  assert outcome_of(said, "uncovered") == "survived"
  assert outcome_of(said, "broken") == "compile_error"
  let line = find(said, l => has(l, "\"wekufe\":\"covered\"")) |> unwrap_or("")
  assert field(line, "killed_by") == "kai test ."
}

test "the oracle is the whole suite of a baseline" {
  let green = told([
    hello_with("{\"oracle\":\"kai test .\"}"),
    "{\"type\":\"prepare\",\"id\":2}",
    "{\"type\":\"baseline\",\"id\":3}"
  ])
  let line = find(green, l => has(l, "\"type\":\"baseline_done\"")) |> unwrap_or("")
  assert field(line, "status") == "green"
  assert has(line, "\"test\":\"kai test .\"")

  let red = told([
    hello_with("{\"oracle\":\"false\"}"),
    "{\"type\":\"prepare\",\"id\":2}",
    "{\"type\":\"baseline\",\"id\":3}"
  ])
  assert field(find(red, l => has(l, "\"type\":\"baseline_done\"")) |> unwrap_or(""), "status")
    == "red"
}

# A signal ends the oracle before it can say anything, so nothing judged
# the wekufe.
test "an oracle that is killed is a crash, not a kill" {
  let said = told([
    hello_with("{\"oracle\":\"kill -9 $$\"}"),
    "{\"type\":\"prepare\",\"id\":2}",
    cast(3, "covered", 305, 307, ">")
  ])
  assert outcome_of(said, "covered") == "crashed"
}

test "a setting this kalku does not take is refused when it is greeted" {
  assert has(
    error_of(told([hello_with("{\"orcale\":\"make test\"}")])),
    "bad_options: kaikai.orcale"
  )
  assert has(
    error_of(told([hello_with("{\"oracle\":3}")])),
    "bad_options: kaikai.oracle: expected a command"
  )
  assert has(error_of(told([hello_with("{\"oracle\":\" \"}")])), "bad_options: kaikai.oracle")
}

# The kalku that ran the baseline and listed the sites goes on to cast, so
# what those left in the copy must not change a verdict: the same wekufe
# come out as they do from a kalku that was only prepared.
test "a kalku that ran the baseline judges a wekufe as one only prepared would" {
  let said = told([
    hello(),
    "{\"type\":\"prepare\",\"id\":2}",
    "{\"type\":\"baseline\",\"id\":3}",
    "{\"type\":\"sites\",\"id\":4,\"files\":[\"tiny.kai\"],\"spells\":[\"compare\"],\"exclude_calls\":[]}",
    cast(5, "covered", 305, 307, ">"),
    cast(6, "uncovered", 523, 524, ">="),
    cast(7, "broken", 523, 524, "@"),
    cast(8, "covered-again", 305, 307, ">")
  ])

  assert has(find(said, l => has(l, "baseline_done")) |> unwrap_or(""), "\"status\":\"green\"")
  assert outcome_of(said, "covered") == "killed"
  assert outcome_of(said, "uncovered") == "survived"
  assert outcome_of(said, "broken") == "compile_error"
  assert outcome_of(said, "covered-again") == "killed"
}

fn reuse_hello(root: String, reni: String) : String =
  "{\"type\":\"hello\",\"id\":1,\"protocol\":1,\"root\":\"#{root}\",\"reni\":\"#{reni}\",\"worker\":0,\"inline_limit_bytes\":65536,\"env\":{}}"

fn baseline_with(reni: String, reuse: String) : String / Process + File =
  baseline_of_package(TINY, reni, reuse)

fn baseline_of_package(root: String, reni: String, reuse: String) : String / Process + File =
  baseline_line(
    told([
      reuse_hello(root, reni),
      "{\"type\":\"prepare\",\"id\":2}",
      "{\"type\":\"baseline\",\"id\":3,\"reuse\":#{reuse}}"
    ])
  )

fn of_each_test(line: String, name: String) : [String] = match json_decode(line) {
  Some(v) -> match get(v, "tests") {
    Some(JArr(tests)) -> tests | (t => (get(t, name) || as_string) ?? "")
    _ -> []
  }
  None -> []
}

fn reused_of(line: String) : [String] = match json_decode(line) {
  Some(v) -> match get(v, "reused") {
    Some(JArr(ids)) -> ids | (i => as_string(i) ?? "")
    _ -> []
  }
  None -> []
}

# Every test a baseline ran, offered back with the fingerprint it was given.
fn offered(line: String) : [(String, String)] =
  zip(of_each_test(line, "test"), of_each_test(line, "fingerprint"))

fn offer(pairs: [(String, String)]) : String =
  "[#{join(pairs | (p => "{\"test\":\"#{p.fst}\",\"fingerprint\":\"#{p.snd}\"}"), ",")}]"

const ALSO : String = "tests/also_test.kai:total of nothing is nothing"

test "a green baseline gives each test module a fingerprint of its own" {
  let prints = of_each_test(baseline_with("#{reni()}/reuse-green", "[]"), "fingerprint")

  assert length(prints) == 5
  assert length(uniq(sort(prints))) == 2
  assert all(prints, p => length(p) == 24)
}

test "a suite whose every module is offered with the fingerprint it has now runs none of it" {
  let at = "#{reni()}/reuse-whole"
  let first = baseline_with(at, "[]")
  let line = baseline_with(at, offer(offered(first)))

  assert field(line, "status") == "green"
  assert has(line, "\"tests\":[]")
  assert length(reused_of(line)) == 5
}

# A test missing from the offer may be one that failed last time: its module
# runs again, and the others are reused.
test "a module offered in part runs again, and the rest is reused" {
  let at = "#{reni()}/reuse-part"
  let first = baseline_with(at, "[]")
  let line = baseline_with(at, offer(offered(first) |? (p => p.fst != ALSO)))

  assert of_each_test(line, "test") == [ALSO]
  assert length(reused_of(line)) == 4
  assert not contains(reused_of(line), ALSO)
}

test "a suite offered with another fingerprint runs whole" {
  let at = "#{reni()}/reuse-stale"
  let first = baseline_with(at, "[]")
  let line = baseline_with(at, offer(offered(first) | (p => (p.fst, "000000000000000000000000"))))

  assert length(of_each_test(line, "test")) == 5
  assert not has(line, "\"reused\"")
}

# Nothing the reuse needs is kept in the reni, which is one checkout's: a
# fresh one reuses what another measured.
test "a suite measured in one reni is reused from another" {
  let first = baseline_with("#{reni()}/reuse-one", "[]")
  let line = baseline_with("#{reni()}/reuse-other", offer(offered(first)))

  assert has(line, "\"tests\":[]")
  assert length(reused_of(line)) == 5
}

# Each test module of `split` builds from a source of its own.
test "a change to a source runs again only the module built from it" {
  let root = "#{reni()}/split-changed"
  let _ = proc.wait(proc.start("/bin/rm", ["-rf", root]))
  let _ = proc.wait(proc.start("/bin/mkdir", ["-p", reni()]))
  let _ = proc.wait(proc.start("/bin/cp", ["-R", "fixtures/split", root]))
  let first = baseline_of_package(root, "#{reni()}/split-reni", "[]")
  file.write("#{root}/split/alpha.kai", "pub fn next(n: Int) : Int = 1 + n\n")
  let line = baseline_of_package(root, "#{reni()}/split-reni", offer(offered(first)))

  assert of_each_test(line, "test") == ["tests/alpha_test.kai:next counts up"]
  assert reused_of(line)
    == ["tests/beta_test.kai:twice doubles", "tests/beta_test.kai:twice keeps zero"]
}

# ---- reload --------------------------------------------------------------

# Everything the kalku says, with `edit` made once it has prepared: what a
# developer does between two runs of a watch.
fn told_around(
  first: [String],
  edit: () -> Result[Unit, String] / File,
  then: [String]
) : [String] / Process + File = match proc.start_piped(KALKU, []) {
  Err(e) -> ["cannot start the kalku: #{e}"]
  Ok(child) -> {
    let _ = proc.write_stdin(child, join(first, "\n") ++ "\n")
    let before = until_prepared(child, "")
    let edited = edit()
    let rest = then ++ ["{\"type\":\"shutdown\",\"id\":99}"]
    let _ = proc.write_stdin(child, join(rest, "\n") ++ "\n")
    let _ = proc.close_stdin(child)
    let out = drain(child, before)
    let _ = proc.wait(child)
    match edited {
      Ok(_) -> lines(out)
      Err(why) -> ["cannot edit the package: #{why}"]
    }
  }
}

fn until_prepared(child: Child, so_far: String) : String / Process =
  if has(so_far, "\"prepared\"") {
    so_far
  } else {
    match proc.read_stdout(child) {
      Err(_) -> so_far
      Ok(chunk) -> if is_empty(chunk) { so_far } else { until_prepared(child, so_far ++ chunk) }
    }
  }

# The copy in the reni is what a cast builds. A package that no longer
# compiles after the edit, reloaded, makes the wekufe that was a kill a
# compile error: the cast built the edited file, not the one copied at
# `prepare`.
test "a reloaded file is the one the next cast builds" {
  let root = "#{reni()}/reload-pkg"
  let _ = proc.wait(proc.start("/bin/rm", ["-rf", root]))
  let _ = proc.wait(proc.start("/bin/mkdir", ["-p", reni()]))
  let _ = proc.wait(proc.start("/bin/cp", ["-R", TINY, root]))
  let said = told_around(
    [reuse_hello(root, "#{reni()}/reload-reni"), "{\"type\":\"prepare\",\"id\":2}"],
    () => file.append("#{root}/tiny.kai", "\nfn broken( : Int = 0\n"),
    ["{\"type\":\"reload\",\"id\":3,\"files\":[\"tiny.kai\"]}", cast(4, "covered", 305, 307, ">")]
  )

  assert any(said, l => field(l, "type") == "reloaded")
  assert outcome_of(said, "covered") == "compile_error"
}

# An oracle is a command, and what it reads is not known to be inside the
# package.
test "under an oracle nothing is fingerprinted" {
  let oracle = hello_with("{\"oracle\":\"kai test .\"}")
  let said = told([oracle, "{\"type\":\"prepare\",\"id\":2}", "{\"type\":\"baseline\",\"id\":3}"])

  assert not has(head(said) |> unwrap_or(""), "partial_baseline")
  assert field(baseline_line(said), "status") == "green"
  assert not has(baseline_line(said), "fingerprint")
}
