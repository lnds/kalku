import os.process as proc
import fs.file
import encoding.json

# The kalku is driven as the kaikai side drives it: a real binary, a real
# pipe, a real package to measure. Nothing smaller proves it works.
const KALKU : String = "./bin/kalku-kaikai"

const TINY : String = "fixtures/tiny"

# Outside the package, deliberately: a reni inside it would be copied
# into itself, which the kalku now refuses (and there is a test for that).
fn reni() : String = "fixtures/reni"

fn hello() : String =
  "{\"type\":\"hello\",\"id\":1,\"protocol\":1,\"root\":\"#{TINY}\",\"reni\":\"#{reni()}\",\"worker\":0,\"inline_limit_bytes\":65536,\"env\":{}}"

fn cast(id: Int, wekufe: String, from: Int, to: Int, replacement: String) : String =
  "{\"type\":\"cast\",\"id\":#{id},\"wekufe\":\"#{wekufe}\",\"site\":{\"site_id\":\"s#{id}\",\"file\":\"tiny.kai\",\"span\":{\"start\":{\"line\":1,\"col\":1,\"byte\":#{from}},\"end\":{\"line\":1,\"col\":1,\"byte\":#{to}}},\"spell\":\"compare\",\"replacement\":\"#{replacement}\",\"reload\":\"module\"},\"tests\":[]}"

# Everything the kalku says, given everything it is asked.
fn told(requests: [String]) : [String] / Process + File {
  let asked = join(requests ++ ["{\"type\":\"shutdown\",\"id\":99}"], "\n") ++ "\n"
  match proc.start_piped(KALKU, []) {
    Err(e) -> ["cannot start the kalku: #{e}"]
    Ok(child) -> {
      let _ = proc.write_stdin(child, asked)
      let _ = proc.close_stdin(child)
      let out = drain(child, "")
      let _ = proc.wait(child)
      lines(out)
    }
  }
}

fn drain(child: Child, so_far: String) : String / Process = match proc.read_stdout(child) {
  Err(_) -> so_far
  Ok(chunk) -> if is_empty(chunk) { so_far } else { drain(child, so_far ++ chunk) }
}

fn outcome_of(said: [String], wekufe: String) : String = match find(
  said,
  l => is_some(index_of(l, "\"wekufe\":\"#{wekufe}\""))
) {
  Some(line) -> field(line, "outcome")
  None -> "nothing said about #{wekufe}"
}

fn field(line: String, name: String) : String = match json_decode(line) {
  Some(v) -> as_string(get(v, name)).unwrap_or("")
  None -> ""
}

fn has(text: String, needle: String) : Bool = is_some(index_of(text, needle))

# `above/2` shifts `>=` to `>` at byte 305, and a test covers the
# boundary. `clamp/1` shifts `>` to `>=` at byte 523, and no test goes
# near zero — the hole planted on purpose. Both spans sit after a dash in
# the fixture, so a splice that counted codepoints would land two bytes
# along and measure something else.
test "the three outcomes a cast can have, against a real package" {
  let said = told([
    hello(),
    "{\"type\":\"prepare\",\"id\":2}",
    cast(3, "covered", 305, 307, ">"),
    cast(4, "uncovered", 523, 524, ">="),
    cast(5, "broken", 523, 524, "@")
  ])

  assert outcome_of(said, "covered") == "killed"
  assert outcome_of(said, "uncovered") == "survived"
  assert outcome_of(said, "broken") == "compile_error"
}

# A kill names the test that noticed, so a report can point at it.
test "a kill names the test that noticed" {
  let said = told([hello(), "{\"type\":\"prepare\",\"id\":2}", cast(3, "covered", 305, 307, ">")])
  let line = find(said, l => has(l, "\"wekufe\":\"covered\"")).unwrap_or("")

  assert has(field(line, "killed_by"), "tests/tiny_test.kai")
}

test "it greets as a kaikai kalku and claims only what it can do" {
  let ready = head(told([hello()])).unwrap_or("")

  assert field(ready, "type") == "ready"
  assert field(ready, "language") == "kaikai"
  # No warm runtime to reload into, no per-test coverage from kaikai, and
  # nothing shared to dirty: a capability is claimed only once it is true.
  assert has(ready, "\"cast\"")
  assert has(ready, "\"abort\"")
  assert not has(ready, "hot_load")
  assert not has(ready, "per_test_coverage")
  assert not has(ready, "reset")
}

test "sites come from kaikai's own parser, with the span and text to match" {
  let said = told([
    hello(),
    "{\"type\":\"prepare\",\"id\":2}",
    "{\"type\":\"sites\",\"id\":3,\"files\":[\"tiny.kai\"],\"spells\":[\"compare\"],\"exclude_calls\":[]}"
  ])
  let found = find(said, l => has(l, "sites_found")).unwrap_or("")

  assert has(found, "\"enclosing\":\"tiny.above/2\"")
  assert has(found, "\"original\":\">=\"")
  assert has(found, "\"byte\":305")
}

# A reni inside the package would be copied into itself until the path
# ran out of room, filling a disk with copies of someone's project on the
# way. Refused before anything is copied.
test "a reni inside the package is refused rather than nested" {
  let nested =
    "{\"type\":\"hello\",\"id\":1,\"protocol\":1,\"root\":\"#{TINY}\",\"reni\":\"#{TINY}/inner\",\"worker\":0,\"inline_limit_bytes\":65536,\"env\":{}}"
  let said = told([nested, "{\"type\":\"prepare\",\"id\":2}"])
  let answer = find(said, l => has(l, "\"id\":2")).unwrap_or("")

  assert field(answer, "type") == "error"
  assert field(answer, "code") == "prepare_failed"
  assert has(field(answer, "message"), "inside the package")
  assert not file.exists("#{TINY}/inner")
}

# Tier 1: the package being measured is left exactly as it was found.
test "the package under test is never written to" {
  let before = file.read("#{TINY}/tiny.kai")

  let _ = told([
    hello(),
    "{\"type\":\"prepare\",\"id\":2}",
    cast(3, "covered", 305, 307, ">")
  ])

  assert file.read("#{TINY}/tiny.kai") == before
  assert not file.exists("#{TINY}/.kai-cache")
}

# A wekufe can take the runtime down with it: `n % 0` traps, and the tests
# that would have judged it never run. Their silence is not the suite
# failing to notice — it is the kalku failing to measure, and saying
# `survived` here would be the loudest possible lie.
test "a wekufe that stops the run is not a wekufe that survived" {
  let said = told([
    hello(),
    "{\"type\":\"prepare\",\"id\":2}",
    cast(3, "trapping", 794, 796, "0")
  ])

  assert outcome_of(said, "trapping") == "crashed"
}
