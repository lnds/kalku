#[doc("""
What each test module of a package runs, as one fingerprint per module.

`kai test --json --list --deps` says, without building anything, which
tests each test file holds and which package files its build reads. A
module's fingerprint is taken over those files, over every file of the
package that no module builds from — the data a test reads as it runs,
`kai.lock` among them — and over the module's own test ids, with the
kaikai that builds it and this kalku. A change to a source re-runs the
modules that build from it, and a change to anything else re-runs them all.

A module is reused only when every test it holds is offered with the
fingerprint it has now: one that failed last time is not offered, and the
whole module runs again.

A package whose dependencies could change without its tree changing has
no fingerprint: one that names a path outside itself, or names any
dependency with no `kai.lock` to pin it.
""")]

import fs.file
import encoding.toml
import encoding.hex
import encoding.json
import encoding.json_bind
import crypto.hash
import kalku.version
import kalku.wire.kalku_msg.{Reuse}
import kaikai_kalku.work
import kalku.core.lookup
import kalku.core.distinct

#[doc("One test file: the package files its build reads, and the ids of its tests.")]
#[derive(Eq, Show)]
pub type Module = { file: String, sources: [String], ids: [String] }

#[doc("A test module's tests, and the fingerprint they share.")]
#[derive(Eq, Show)]
pub type Print = { ids: [String], print: String }

#[doc("""
The fingerprint of every test module of the package, or `None` when the
package cannot be fingerprinted.
""")]
pub fn of_package(w: Work) : Option[[Print]] / Process + File = if not pinned(w.root) {
  None
} else {
  match (kaikai_version(), modules_of(w), sums_of(w.root)) {
    (Some(kaikai), Some(modules), Some(sums)) ->
      Some(printed("#{kaikai}\nkalku #{version.VERSION}", sums, modules))
    _ -> None
  }
}

#[doc("""
Each module's fingerprint, from what builds the tests (`head`), the digest
of every file of the package by its path, and the modules. A module that
names a file the package does not hold has none.
""")]
pub fn printed(head: String, sums: [(String, String)], modules: [Module]) : [Print] {
  let built = lookup.member_of(flat_map(modules, .sources))
  let shared =
    digest(join(sums |? (s => not built(s.fst)) | (s => "#{s.fst} #{s.snd}"), "\n"))
  let sums_at = lookup.finder(lookup.grouped(sums, s => s.fst), g => g.fst)
  flat_map(modules, m => print_of(head, shared, sums_at, m))
}

fn print_of(
  head: String,
  shared: String,
  sums_at: (String) -> Option[(String, [(String, String)])],
  m: Module
) : [Print] {
  let found = flat_map(m.sources, f => (sums_at(f) |> option.map(.snd)) ?? [])
  if is_empty(m.ids) or length(found) != length(distinct.distinct(m.sources)) {
    []
  } else {
    let sources = join(found | (s => "#{s.fst} #{s.snd}"), "\n")
    let ids = join(distinct.distinct(sort(m.ids)), "\n")
    [Print { ids: m.ids, print: slice(digest("#{head}\n#{shared}\n#{sources}\n#{ids}"), 0, 24) }]
  }
}

fn digest(text: String) : String = hex.encode(hash.sha256(bytes(text) | byte_to_int))

#[doc("""
The tests to leave out of a baseline: those of every module offered whole
with the fingerprint it has now.
""")]
pub fn reusable(offered: [Reuse], prints: Option[[Print]]) : [String] = match prints {
  None -> []
  Some(ps) -> {
    let is_offered = lookup.member_of(offered | (o => offer_key(o.test_id, o.fingerprint)))
    let whole = p => all(p.ids, id => is_offered(offer_key(id, p.print)))
    distinct.distinct(sort(flat_map(ps, p => if whole(p) { p.ids } else { [] })))
  }
}

fn offer_key(id: String, print: String) : String = "#{id}\u{0}#{print}"

#[doc("""
The fingerprint each test gets, by its id: its module's, when it has one
and none of the module's tests failed. Built once for a whole run.
""")]
pub fn fingerprints(prints: Option[[Print]], failed: [String]) : (String) -> Option[String] {
  let failing = lookup.member_of(failed)
  let by_id = flat_map(
    prints ?? [],
    p => {
      let print = if any(p.ids, failing) { None } else { Some(p.print) }
      p.ids | (id => (id, print))
    }
  )
  let at = lookup.finder(by_id, t => t.fst)
  id => (at(id) |> option.and_then(.snd))
}

# ---- what kaikai says ---------------------------------------------------

# Asked of the copy: `kai` keeps a cache where it runs, and the user's tree
# is not the place for one.
fn modules_of(w: Work) : Option[[Module]] / Process =
  match work.run([
    "/bin/sh", "-c", "cd #{work.quoted(w.copy)} && kai test --json --list --deps . 2>/dev/null"
  ]) {
    Ok(came) -> match came.exit {
      Exited(0) -> Some(modules_in(lines(came.said)))
      _ -> None
    }
    Err(_) -> None
  }

#[doc("The test modules `kai test --json --list --deps` describes, in its order.")]
pub fn modules_in(said: [String]) : [Module] {
  let records = flat_map(said, l => (json_decode(l) |> map(v => [v]) |> unwrap_or([])))
  let tests = records |? (v => (get(v, "type") || as_string) == Some("test"))
  flat_map(
    records |? (v => (get(v, "type") || as_string) == Some("deps")),
    v => match get(v, "file") || as_string {
      None -> []
      Some(f) -> [
        Module {
          file: f,
          sources: strings_of(get(v, "sources") ?? JNull),
          ids: flat_map(
            tests |? (t => (get(t, "file") || as_string) == Some(f)),
            t => (get(t, "id") || as_string |> option.map(id => [id])) ?? []
          )
        }
      ]
    }
  )
}

fn strings_of(v: JsonValue) : [String] = match v {
  JArr(items) -> flat_map(items, i => (as_string(i) | (s => [s])) ?? [])
  _ -> []
}

# A path dependency lives outside the tree and is not in the fingerprint;
# a dependency without a lock is whatever its source holds today.
fn pinned(root: String) : Bool / File = match file.read("#{root}/kai.toml") {
  Err(_) -> true
  Ok(text) -> match toml.decode(text) {
    None -> false
    Some(TTbl(top)) -> match toml.pairs_get(top, "dependencies") {
      None -> true
      Some(TTbl([])) -> true
      Some(TTbl(deps)) -> (not any(deps, d => by_path(d.snd))) and file.exists("#{root}/kai.lock")
      Some(_) -> false
    }
    Some(_) -> false
  }
}

fn by_path(dep: TomlValue) : Bool = match dep {
  TTbl(fields) -> is_some(toml.pairs_get(fields, "path"))
  _ -> false
}

fn kaikai_version() : Option[String] / Process = match work.run(["kai", "--version"]) {
  Ok(came) -> match came.exit {
    Exited(0) -> head(lines(came.said))
    _ -> None
  }
  Err(_) -> None
}

# Hashed by `sha256sum` rather than in kaikai: a package with a build
# directory in it is gigabytes. A file that cannot be read fails the run,
# and the package has no fingerprint.
fn sums_of(root: String) : Option[[(String, String)]] / Process + File {
  let entries = work.package_entries(root)
  let script =
    "set -e; cd #{work.quoted(root)}; find #{join(entries | work.quoted, " ")} \\( -type f -o -type l \\) -print0 | LC_ALL=C sort -z | xargs -0 sha256sum"
  if is_empty(entries) {
    None
  } else {
    match work.run(["/bin/sh", "-c", script]) {
      Ok(came) -> match came.exit {
        Exited(0) -> Some(flat_map(lines(came.said), sum_of))
        _ -> None
      }
      Err(_) -> None
    }
  }
}

# `<64 hex>  <path>`, the path as `find` named it.
fn sum_of(line: String) : [(String, String)] = if length(line) > 66 {
  [(slice(line, 66, length(line)), slice(line, 0, 64))]
} else {
  []
}
