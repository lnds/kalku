#[doc("""
The kaikai kalku: the one kalku measures itself with.

It speaks the kalku protocol on stdio like any other kalku, and it is
thin on purpose — kaikai's own `kai mutate` finds the sites and `kai
test` judges them. What this adds is the protocol, the workspace in the
reni, and the honesty about what it cannot know.

It claims `per_test_coverage` from `kai test --coverage`, unless the
project names an oracle of its own, which judges the package as one test
and says nothing of lines. It claims neither `hot_load` nor `reset`: every
cast rebuilds, and there is no shared runtime to dirty. It claims `cast_after_baseline`: nothing lives in
the process between requests, so the kalku that ran the baseline casts as
one that was only prepared would. A capability is claimed only once it is
true.
""")]

import fs.file
import encoding.json
import encoding.json_bind
import actor
import spawn
import kalku.wire.enums
import kalku.wire.envelope
import kalku.wire.shapes
import kalku.wire.kalku_msg
import kalku.wire.kalku_codec
import kalku.wire.version
import kaikai_kalku.work

type Serving = {
  root: String,
  reni: String,
  worker: Int,
  inline_limit: Int,
  oracle: Option[String],
  work: Option[Work]
}

# Requests are read here and served on a fiber of its own, so that the input
# ending is heard while a request is under way. After a `shutdown` it is a
# driver that said all it had to say, and every request before it is
# answered. With none it is a run that is gone: nobody is left to read an
# answer, so the request under way is cancelled, which ends what it started.
fn main() : Int / Stdin + Stdout + Stderr + File + Process + Env + Spawn = with_mailbox {
  nursery { n ->
    let here = Actor.self()
    let serving = n.spawn(
      () => with_mailbox {
        Actor.send(here, Actor.self())
        serve(Serving { root: ".", reni: "", worker: 0, inline_limit: 0, oracle: None, work: None })
      }
    )
    let server = Actor.receive()
    if told_to_leave(server) {
      n.await(serving)
    } else {
      n.cancel(serving)
      0
    }
  }
}

# Pass each line on until the input ends, and say whether a `shutdown` was
# what ended it.
fn told_to_leave(
  server: Pid[String]
) : Bool / Stdin + Actor[Pid[String]] = match Stdin.read_line() {
  None -> false
  Some(line) -> {
    Actor.send(server, line)
    if is_shutdown(line) { true } else { told_to_leave(server) }
  }
}

fn is_shutdown(line: String) : Bool = match decode_request(trim_right(line)) {
  Ok(m) -> match m.body {
    Shutdown -> true
    _ -> false
  }
  Err(_) -> false
}

# The mailbox holds the lines of the input in order. An input that ends
# with no `shutdown` on it sends nothing: the fiber is cancelled where it
# waits or where it works.
fn serve(state: Serving) : Int / Actor[String] + Stdout + Stderr + File + Process =
  match decode_request(trim_right(Actor.receive())) {
    Err(e) -> {
      say(encode_reply(0, refusal("bad_request", "#{kind_name(e.kind)}: #{e.detail}", false)))
      serve(state)
    }
    Ok(m) -> answer(m.id, m.body, state)
  }

fn answer(
  id: Int,
  request: KalkuRequest,
  state: Serving
) : Int / Actor[String] + Stdout + Stderr + File + Process = match request {
  Hello(m) -> {
    say(encode_reply(id, greeting(m)))
    serve(Serving {
      root: m.root,
      reni: m.reni,
      worker: m.worker,
      inline_limit: m.inline_limit_bytes,
      oracle: oracle_of(m.options).unwrap_or(None),
      work: None
    })
  }
  Prepare -> prepared(id, state)
  Baseline(_) -> {
    say(encode_reply(id, baseline_of(state)))
    serve(state)
  }
  Sites(m) -> {
    say(encode_reply(id, found(m, state)))
    serve(state)
  }
  Cast(m) -> {
    say(encode_reply(id, cast_one(m, state)))
    serve(state)
  }
  Shutdown -> {
    say(encode_reply(id, Bye))
    0
  }
  other -> {
    say(encode_reply(id, refusal("bad_request", "`#{other}` is not served by this kalku", false)))
    serve(state)
  }
}

# ---- hello ---------------------------------------------------------------

fn greeting(m: HelloMsg) : KalkuReply = if not compatible(m.version) {
  refusal(
    "protocol_mismatch",
    "this kalku speaks protocol #{PROTOCOL_VERSION}, the kaikai side speaks #{m.version}",
    true
  )
} else {
  match oracle_of(m.options) {
    Err(why) -> refusal("bad_options", why, true)
    Ok(oracle) -> Ready(ReadyMsg {
      version: PROTOCOL_VERSION,
      language: "kaikai",
      adapter: "kalku_kaikai 0.0.0",
      runtime: "kaikai",
      spells: mutate_spells(),
      capabilities: if is_some(oracle) {
        [CastCap, AbortCap, CastAfterBaseline]
      } else {
        [CastCap, PerTestCoverage, AbortCap, CastAfterBaseline]
      }
    })
  }
}

# What this kalku takes from the project's `[kaikai]` table. A setting it
# does not know is refused, not ignored: a misspelt `oracle` would measure
# with `kai test` and say nothing of it.
fn oracle_of(options: Option[Options]) : Result[Option[String], String] = match options {
  None -> Ok(None)
  Some(o) -> match find(o.entries, e => e.fst != "oracle") {
    Some(e) -> Err("kaikai.#{e.fst}: no such setting; this kalku takes `oracle`")
    None -> match find(o.entries, e => e.fst == "oracle") {
      None -> Ok(None)
      Some(e) -> command_of(e.snd)
    }
  }
}

fn command_of(v: JsonValue) : Result[Option[String], String] = match v {
  JStr(command) -> if is_blank(command) {
    Err("kaikai.oracle: expected a command, got an empty one")
  } else {
    Ok(Some(command))
  }
  other -> Err("kaikai.oracle: expected a command, got #{json_encode(other)}")
}

# What `kai mutate` applies, in its own order. `foreign` is a driver's
# and has no meaning here.
fn mutate_spells() : [Spell] = [Arm, Compare, Connect, Negate, Literal, Call]

# ---- prepare -------------------------------------------------------------

fn prepared(
  id: Int,
  state: Serving
) : Int / Actor[String] + Stdout + Stderr + File + Process {
  let started = 0
  match work.prepare(state.root, state.reni, state.worker, state.oracle) {
    Err(why) -> {
      say(encode_reply(id, refusal("prepare_failed", why, true)))
      serve(state)
    }
    Ok(w) -> {
      say(encode_reply(id, Prepared(PreparedMsg { duration_ms: started, modules: 0 })))
      serve(Serving { ...state, work: Some(w) })
    }
  }
}

# ---- baseline ------------------------------------------------------------

# What a test can tell of where it ran, said with every baseline: it is
# what a reader needs when a suite fails here and not in their tree.
const IN_A_COPY : String =
  "it ran in a copy of the package kept in the reni: what the copy leaves out, `.git` for one, is not there"

fn baseline_of(state: Serving) : KalkuReply / Process + File = match state.work {
  None -> refusal("not_prepared", "`prepare` has to copy the package into the reni first", false)
  Some(w) -> {
    let r = test_all(w)
    match r.mishap {
      Some(_) -> report_of(r, (None, None))
      None -> report_of(r, spoken(covered(r), state))
    }
  }
}

# Which tests ran each line, one entry a line. Only the tests the run
# reported count: a record about anything else names nothing a cast can
# select.
fn covered(r: Ran) : [CoverageEntry] {
  let known = r.tests | .test_id
  let reached = r.reached |? (x => contains(known, x.test_id))
  let places = uniq(sort(flat_map(reached, x => (x.lines | (l => "#{x.file}\u{0}#{pad(l)}")))))
  places | (p => entry_at(p, reached))
}

# Lines sort as numbers once they are all the same width.
fn pad(n: Int) : String {
  let s = "#{n}"
  "#{repeat("0", 9 - length(s))}#{s}"
}

fn entry_at(place: String, reached: [Reach]) : CoverageEntry {
  let parts = split(place, "\u{0}")
  let file = head(parts).unwrap_or("")
  let line = to_int(last(parts).unwrap_or("0")).unwrap_or(0)
  CoverageEntry {
    file: file,
    line: line,
    tests: reached |? (x => x.file == file and contains(x.lines, line)) | .test_id
  }
}

# Inline when it fits under the limit `hello` set, and in a file in the
# reni when it does not.
fn spoken(
  entries: [CoverageEntry],
  state: Serving
) : (Option[[CoverageEntry]], Option[String]) / File {
  let text = "[#{join(entries | (e => json_encode(to_json(e))), ",")}]"
  if length(text) <= state.inline_limit {
    (Some(entries), None)
  } else {
    let path = "#{state.reni}/coverage-#{state.worker}.json"
    file.write(path, text)
    (None, Some(path))
  }
}

# Coverage is absent rather than faked where there is none: under an
# oracle the kaikai side runs it for every wekufe and knows that it does.
fn report_of(r: Ran, coverage: (Option[[CoverageEntry]], Option[String])) : KalkuReply =
  match r.mishap {
    Some(NoBuild(why)) -> refusal("baseline_failed", why, true)
    Some(CutShort(why)) -> refusal("baseline_failed", why, true)
    None -> BaselineDone(BaselineDoneMsg {
      status: if r.failed == 0 { Green } else { Red },
      duration_ms: 0,
      tests: r.tests,
      coverage: if is_some(coverage.fst) and r.reached != [] { coverage.fst } else { None },
      coverage_path: coverage.snd,
      coverage_packed_path: None,
      coverage_withheld: None,
      coverage_doubted: None,
      failures: failures_of(r),
      differences: Some([IN_A_COPY]),
      reused: None
    })
  }

fn failures_of(r: Ran) : [Failure] = match r.first_failure {
  Some(id) -> [Failure { test_id: id, message: "the test failed" }]
  None -> []
}

# ---- sites ---------------------------------------------------------------

fn found(m: SitesMsg, state: Serving) : KalkuReply / Process = match state.work {
  None -> refusal("not_prepared", "`prepare` has to copy the package into the reni first", false)
  Some(w) -> gather(w, m, [], [])
}

fn gather(w: Work, m: SitesMsg, sites: [Site], skipped: [Skipped]) : KalkuReply / Process =
  match m.files {
    [] -> SitesFound(SitesFoundMsg { sites: sites, skipped: skipped })
    [file, ...rest] -> match sites_in(w, file, m.spells) {
      Ok(found_here) -> gather(w, SitesMsg { ...m, files: rest }, sites ++ found_here, skipped)
      Err(why) -> gather(
        w,
        SitesMsg { ...m, files: rest },
        sites,
        skipped ++ [Skipped { file: file, reason: "unreadable", message: why }]
      )
    }
  }

# ---- cast ----------------------------------------------------------------

fn cast_one(m: CastMsg, state: Serving) : KalkuReply / File + Process = match state.work {
  None -> refusal("not_prepared", "`prepare` has to copy the package into the reni first", false)
  Some(w) -> match splice(w, m.site) {
    Err(why) -> done(m.wekufe, CompileError, None, Some(why))
    Ok(spliced) -> {
      let was = splice_in(w, m.site.file, spliced)
      let ran = judge(w, m.site.file, m.tests)
      restore(w, m.site.file, was)
      outcome_of(m.wekufe, ran)
    }
  }
}

# A run that stopped is not a wekufe that survived: the wekufe took the
# runtime down with it, and nothing judged it.
fn outcome_of(wekufe: String, r: Ran) : KalkuReply = match r.mishap {
  Some(NoBuild(why)) -> done(wekufe, CompileError, None, Some(why))
  Some(CutShort(why)) -> done(wekufe, Crashed, None, Some(why))
  None -> if r.failed > 0 {
    done(wekufe, Killed, r.first_failure, None)
  } else {
    done(wekufe, Survived, None, None)
  }
}

# The span is in bytes, and it is cut in bytes: `slice` counts codepoints,
# so a single accented character or dash anywhere earlier in the file
# would move the splice off the site and mutate whatever sits two bytes
# along. That is a wekufe with more than one defect in it, which is the
# one thing a wekufe may not be.
fn splice(w: Work, site: Site) : Result[String, String] / File {
  let source = source_of(w, site.file)
  let from = site.span.start.byte
  let to = match site.span.end {
    Some(e) -> e.byte
    None -> from
  }
  if to < from or to > length(source) {
    Err("the site's span is not inside #{site.file}")
  } else {
    spliced(source, from, to, site)
  }
}

fn spliced(source: String, from: Int, to: Int, site: Site) : Result[String, String] =
  match (byte_slice(source, 0, from), byte_slice(source, to, length(source) - to)) {
    (Some(before), Some(after)) -> Ok(before ++ site.replacement ++ after)
    _ -> Err("the site's span does not fall on character boundaries in #{site.file}")
  }

fn done(wekufe: String, outcome: Outcome, by: Option[String], why: Option[String]) : KalkuReply =
  CastDone(CastDoneMsg {
    wekufe: wekufe,
    outcome: outcome,
    killed_by: by,
    message: why,
    code_hash: None,
    duration_ms: 0,
    dirty: false
  })

# ---- the wire -----------------------------------------------------------

fn refusal(code: String, message: String, fatal: Bool) : KalkuReply =
  KalkuError(ErrorMsg { code: code, message: message, fatal: fatal })

fn say(line: String) : Unit / Stdout = Stdout.print(line)
