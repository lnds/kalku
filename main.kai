import kalku.cli

fn main() : Int / Stdin + Stdout + Stderr + Env + File + Process + Spawn + Clock + NetUnix + Signal {
  match cli.parse_args(args.argv()) {
    ShowVersion -> {
      Stdout.print(cli.version_line())
      0
    }
    ShowHelp -> {
      Stdout.print(cli.help_text())
      0
    }
    Initialise(setup) -> settle(setup.root, setup.language, setup.assume_yes)
    Inform(asked) -> told_about(asked)
    Display(wekufe, shape) -> shown(wekufe, shape)
    Recast(wanted) -> recast_here(wanted)
    Propose(wekufe, reason) -> proposed(wekufe, reason)
    Answer(wekufe, yes, why) -> answered_by_hand(wekufe, yes, why)
    Serve -> serving_here()
    Mcp -> tooling()
    Measure(wanted) -> run_here(wanted)
    Misused(why) -> {
      Stderr.eprint("kalku: #{why}\n#{cli.usage_line()}")
      2
    }
    Pending(cmd) -> {
      Stderr.eprint("kalku: `#{cmd}` is not implemented yet")
      2
    }
    Unknown(cmd) -> {
      Stderr.eprint("kalku: unknown command `#{cmd}`\n#{cli.usage_line()}")
      2
    }
  }
}

# What kalku knows about itself, for whoever asks: a person who wonders
# what `survived` means, or an agent that would otherwise guess.
fn told_about(asked: Asked) : Int / Stdout + Stderr = if asked.snippet_only {
  {
    Stdout.print(snippet())
    0
  }
} else {
  match asked.topic {
    None -> {
      Stdout.print(listing())
      0
    }
    Some(name) -> match page(name) {
      None -> {
        Stderr.eprint("kalku: no such topic `#{name}`\n#{listing()}")
        2
      }
      Some(t) -> {
        Stdout.print(if asked.as_json { as_json(t) } else { as_text(t) })
        0
      }
    }
  }
}

# A run measures the project one is standing in, with the kalku that
# project's `.kalku.toml` names. Without that file there is nothing to
# summon, so the way out is `kalku init` rather than a guess.
# Reading the project's settings is the first thing both `run` and `cast`
# do, and failing to is the same answer from either: say why, and stop.
fn with_settings[e](
  body: (Config) -> Int / Stderr + e
) : Int / Stderr + Env + File + Process + e = match settings() {
  Err(why) -> {
    Stderr.eprint("kalku: #{why}")
    2
  }
  Ok(c) -> body(c)
}

fn run_here(
  wanted: Wanted
) : Int / Stdout + Stderr + Env + File + Process + Spawn + Clock + Signal = with_settings(
  c => match changes_asked(wanted) {
    Err(why) -> {
      Stderr.eprint("kalku: could not measure: #{why}")
      2
    }
    Ok(touched) -> match language_of(c) {
      Err(why) -> {
        Stderr.eprint("kalku: #{why}")
        2
      }
      Ok(known) -> match files_for(wanted, touched, known) {
        [] -> if is_some(touched) {
          {
            Stderr.eprint(
              "kalku: this change touches no source file, so there is nothing to measure"
            )
            0
          }
        } else {
          {
            Stderr.eprint("kalku: name the files to measure, as in `kalku run lib/thing.ex`")
            2
          }
        }
        files -> with_declared(
          ".",
          declared => measured(asking_for(c, wanted, files, touched, declared), wanted, c.policy)
        )
      }
    }
  }
)

# A run that was asked about a change reads the change first, and a change
# that cannot be read stops the run. Treating "git could not tell me" as
# "nothing changed" would pass every pull request it could not read.
fn changes_asked(wanted: Wanted) : Result[Option[[FileChange]], String] / Process =
  match wanted.since {
    None -> Ok(None)
    Some(ref) -> Ok(Some(diffing.since(".", ref)!))
  }

# The files a run is about: the ones named, or — when a change was asked
# about and none were named — the source files that change touched.
fn files_for(wanted: Wanted, touched: Option[[FileChange]], known: setting_up.Known) : [String] =
  if not is_empty(wanted.files) {
    wanted.files
  } else {
    match touched {
      Some(changes) ->
        filter(changed_lines.files(changes), f => is_source_of(known, f))
      None -> []
    }
  }

# The language a project says it is written in, which is what tells its sources
# from its tests and from what a build leaves.
fn language_of(c: Config) : Result[setting_up.Known, String] = match c.language {
  None -> Err("no language in #{CONFIG_PATH}; run `kalku init` there")
  Some(name) -> match named(name) {
    Ok(known) -> Ok(known)
    Err(puzzle) -> Err(explain(puzzle))
  }
}

fn measured(
  asking: Asking,
  wanted: Wanted,
  policy: Policy
) : Int / Stdout + Stderr + Env + File + Process + Spawn + Clock + Signal = with_mailbox {
  let shape = wanted.shape
  let found = alone(() => telling(wanted.aloud, () => measure(asking)))
  remember(found.cast)
  match found.failure {
    Some(why) -> {
      Stderr.eprint("kalku: #{why}")
      2
    }
    None -> match found.report {
      None -> {
        Stderr.eprint("kalku: nothing measured")
        2
      }
      Some(whole) -> {
        # The report is what was measured; the blockers are what the
        # project asked to be held to. Judging here rather than in the run
        # keeps the same measurement answerable to a different policy in
        # CI than on a laptop.
        let r = judged_by(whole, policy, asking.touched)
        Stdout.print(printed(r, shape))
        exit_code(r.blockers)
      }
    }
  }
}

# Each format is a different reader: a person, an agent, a program, a
# pull request. The survivors are the same in all of them.
fn printed(r: Report, shape: Shape) : String / File {
  case r, AsHuman -> human(r)
  case r, AsAgent -> agent(r, of_files(sources_of(r)))
  case r, AsJson -> json(r, exit_code(r.blockers))
  case r, AsGithub -> "#{annotations(r)}\n#{step_summary(r)}"
}

# The lines around a survivor travel with it in the agent format, so an
# agent does not have to open a file to see what it is looking at. The
# files are read here and looked up purely, because the format reads
# nothing itself — which is what makes it testable without a filesystem.
fn sources_of(r: Report) : [(String, [String])] / File =
  uniq(r.survivors | (s => s.site.file)) | (path => (path, read_lines(path)))

fn read_lines(path: String) : [String] / File =
  if file.exists(path) { lines(file.read(path)) } else { [] }

fn of_files(sources: [(String, [String])]) : (String) -> [String] =
  path => match find(sources, s => s.fst == path) {
    Some(s) -> s.snd
    None -> []
  }

# ---- what a run was asked for -------------------------------------------

fn settings() : Result[Config, String] / Stderr + File + Env + Process = settings_in(".")

# A summoning is written into the project once and kept for as long as the
# project lives, so a fix to it reaches nobody who already ran `init`. The
# script says which contract it was written against, and a run that cannot
# use it says so here — where the reason can be given — rather than deep in
# a `prepare` that only knows the build path came out wrong.
fn usable(c: Config, root: String) : Result[Config, String] / File {
  let path = "#{root}/#{c.summon.unwrap_or("")}"
  if is_none(c.summon) or (not file.exists(path)) {
    Ok(c)
  } else if summon_is_current(file.read(path)) {
    Ok(c)
  } else {
    Err(
      "#{c.summon.unwrap_or("")} was written for an older kalku and this one"
        ++ " cannot use it. Run `kalku init` to renew it."
    )
  }
}

fn read_settings(text: String) : Result[Config, String] = match config.parse(text) {
  Err(problems) -> Err(join(problems | (p => "#{CONFIG_PATH}: #{p.key}: #{p.message}"), "\n"))
  Ok(c) -> if is_some(c.summon) {
    Ok(c)
  } else {
    Err("#{CONFIG_PATH} names no kalku to summon; `kalku init` writes one")
  }
}

# The kalku a project summons and the workspace it works in: the kalku
# from what `kalku init` wrote down, the workspace from this machine,
# unless the project insists on one.
#
# Never one fixed path. A reni shared between projects is two projects
# compiling over each other's build, and the first symptom is a
# measurement that cannot be reproduced.
fn pool_of(c: Config) : PoolSpec / Env = summoning_in(c, ".", reni_of(c, "."))

# Where a run's artefacts go: what the project asked for, or this machine's
# own place for the project at that root.
fn reni_of(c: Config, root: String) : String / Env = c.reni.unwrap_or(reni_here(root))

# The reni reaches the summoning as its first argument, because the run is
# what decides where it is. A script that was told at `kalku init` was told
# on one machine, in one directory, and then committed.
fn summoning_in(c: Config, root: String, reni: String) : PoolSpec = PoolSpec {
  command: c.summon.unwrap_or(""),
  args: [reni],
  workers: c.workers.unwrap_or(1),
  root: root,
  reni: reni,
  inline_limit_bytes: 65536,
  env: StrMap { entries: [] },
  greeting_ms: 60000,
  summons_allowed: 2,
  memory_mb: c.memory_limit_mb.unwrap_or(0 - 1)
}

fn asking_for(
  c: Config,
  wanted: Wanted,
  files: [String],
  touched: Option[[FileChange]],
  declared: [equivalent.Entry]
) : Asking / Env = Asking {
  ...asking_of(c, pool_of(c), files, declared),
  limit: 
  # A change is already bounded by the diff, and a gate that answered for a
  # slice of one would pass a pull request over lines nobody looked at, so
  # a run asked about a change casts all of it unless told otherwise.
  wanted.limit.unwrap_or(if is_some(touched) { 0 } else { DEFAULT_LIMIT }),
  touched: touched
}

# What every run is asked, whoever asks it: the project's spells and
# exclusions, and what it declared equivalent. The caller says which
# kalku to summon and which files to measure.
#[doc("""
How many wekufe a run casts when nobody said.

A first run on a real project plans thousands, and an agent asks for
everything because that is what agents do: the issue that opened this had
one measuring a single Phoenix file for five minutes with nothing but a
spinner. A hundred is enough to find real survivors and short enough to
end, and `--limit 0` is how a caller asks for all of it.

A count rather than a time budget, because a time budget makes the
measured set depend on the machine, and two runs of one commit would
score differently.
""")]
const DEFAULT_LIMIT : Int = 100

fn asking_of(
  c: Config,
  spec: PoolSpec,
  files: [String],
  declared: [equivalent.Entry]
) : Asking = Asking {
  spec: spec,
  files: files,
  only: [],
  spells: c.spells,
  exclude_calls: c.exclude_calls,
  exclude: c.exclude,
  equivalents: declared,
  limit: 0,
  timeout_floor_ms: c.timeout_floor_ms,
  touched: None
}

#[doc("Where a project writes down what it has decided cannot be told apart.")]
const EQUIVALENT_PATH : String = ".kalku/equivalent"

# Read once, refused once: a suppression file nobody can parse stops the
# command rather than being measured around.
fn with_declared[e](
  root: String,
  go: ([equivalent.Entry]) -> Int / e
) : Int / Stderr + File + e = match declared_equivalents(root) {
  Err(why) -> {
    Stderr.eprint("kalku: #{why}")
    2
  }
  Ok(declared) -> go(declared)
}

# Suppressions are input, not an invariant: a file somebody typed is read
# into a Result whose error names the line, never into a panic. A run
# with an unreadable suppression file does not start, because measuring
# while ignoring what a project declared is measuring something else.
fn declared_equivalents(root: String) : Result[[equivalent.Entry], String] / File {
  let path = if root == "." { EQUIVALENT_PATH } else { "#{root}/#{EQUIVALENT_PATH}" }
  if file.exists(path) {
    match eqfile.parse(file.read(path)) {
      Ok(entries) -> Ok(entries)
      Err(problems) -> Err(
        join(["#{path}:"] ++ (problems | (p => "  line #{p.at}: #{p.message}")), "\n")
      )
    }
  } else {
    Ok([])
  }
}

# ---- the agent loop -----------------------------------------------------

# One wekufe in full: what it is, what came of it, and what came of it
# before. A wekufe nobody has cast is not a wekufe kalku knows.
fn not_kept(root: String) : Int / Stderr {
  Stderr.eprint("kalku: #{why_not_kept(root)}")
  2
}

# A wekufe nobody has cast is a name kalku cannot place, and saying so is
# the only honest answer to a question about it.
fn unheard_of(wekufe: String) : Int / Stderr {
  Stderr.eprint("kalku: nothing known about `#{wekufe}`; run `kalku run <files>` first")
  2
}

fn shown(wekufe: String, shape: Shape) : Int / Stdout + Stderr + File + Env {
  let all = ledger()
  match latest(all, wekufe) {
    None -> unheard_of(wekufe)
    Some(r) -> {
      let before = history(all, wekufe)
      Stdout.print(if shape == AsHuman {
        showing.as_text(r, before)
      } else {
        showing.as_json(r, before)
      })
      0
    }
  }
}

# Re-casting names wekufe, and a name becomes a site through the ledger:
# a wekufe kalku has never cast is a name it cannot place, which is said
# rather than guessed at.
fn recast_here(
  wanted: Wanted
) : Int / Stdout + Stderr + Env + File + Process + Spawn + Clock + Signal = with_settings(
  c => {
    let all = ledger()
    let unknown = strangers(all, wanted.files)
    if not is_empty(unknown) {
      {
        Stderr.eprint("kalku: never cast: #{join(unknown, ", ")}")
        2
      }
    } else {
      with_declared(
        ".",
        declared => measured(
          asking_again(c, sites_for(all, wanted.files), wanted, declared),
          wanted,
          c.policy
        )
      )
    }
  }
)

# The files those sites live in, because a kalku is asked for sites by
# file and the plan is narrowed to the wekufe that were named.
fn asking_again(
  c: Config,
  sites: [Site],
  wanted: Wanted,
  declared: [equivalent.Entry]
) : Asking / Env = Asking {
  ...asking_of(c, pool_of(c), uniq(sites | (.file)), declared),
  only: sites | (.site_id)
}

# Proposed, never applied: an agent may say why a wekufe cannot be told
# apart, and a person decides whether that is true. `.kalku/equivalent`
# is not written here, ever.
fn proposed(wekufe: String, reason: String) : Int / Stdout + Stderr + File + Env {
  let all = ledger()
  match latest(all, wekufe) {
    None -> unheard_of(wekufe)
    Some(_) if not set_up(".") -> not_kept(".")
    Some(r) -> if r.outcome != Survived {
      {
        Stderr.eprint(
          "kalku: `#{wekufe}` is #{outcome_name(r.outcome)}, not survived; only a survivor can be equivalent"
        )
        2
      }
    } else {
      {
        append_proposal(r, reason)
        Stdout.print("kalku: proposed, for review in #{PROPOSED_PATH}")
        0
      }
    }
  }
}

# A person answers one proposal, by name. Accepting moves the argument
# into the record every run reads; rejecting keeps it somewhere else, so
# that a case argued twice is visible and the wekufe goes back to being a
# survivor that wants a test.
fn answered_by_hand(wekufe: String, yes: Bool, why: String) : Int / Stdout + Stderr + File + Env {
  let all = ledger()
  match latest(all, wekufe) {
    None -> unheard_of(wekufe)
    Some(_) if not set_up(".") -> not_kept(".")
    Some(r) -> {
      let queue = read_or_empty(PROPOSED_PATH)
      match if yes { accepted(queue, r.site, why) } else { rejected(queue, r.site, why) } {
        Err(u) -> {
          Stderr.eprint("kalku: #{why_not(u)}")
          2
        }
        Ok(a) -> {
          file.write(PROPOSED_PATH, a.queue)
          append_line(if yes { EQUIVALENT_PATH } else { REJECTED_PATH }, a.moved)
          Stdout.print(
            if yes {
              "kalku: accepted into #{EQUIVALENT_PATH}; every run reads it from now on"
            } else {
              "kalku: turned down, written to #{REJECTED_PATH}; the wekufe wants a test again"
            }
          )
          0
        }
      }
    }
  }
}

fn append_line(path: String, line: String) : Unit / File {
  let was = read_or_empty(path)
  let sep = if is_empty(trim(was)) { "" } else { "\n" }
  file.write(path, "#{trim_right(was)}#{sep}#{line}\n")
}

fn trim_right(s: String) : String = if ends_with(s, "\n") {
  trim_right(slice(s, 0, length(s) - 1))
} else {
  s
}

#[doc("Where proposals wait for a person. Never `.kalku/equivalent` itself.")]
const PROPOSED_PATH : String = ".kalku/equivalent.proposed"

#[doc("""
Arguments that were made and turned down.

A survivor that has been argued for and refused is a different thing from
one nobody has looked at, and making the same case a second time should be
something anyone can see.
""")]
const REJECTED_PATH : String = ".kalku/equivalent.rejected"

fn append_proposal(r: Remembered, reason: String) : Unit / File {
  let was = if file.exists(PROPOSED_PATH) { file.read(PROPOSED_PATH) } else { "" }
  file.write(PROPOSED_PATH, was ++ proposal_of(r, reason))
}

# The syntax `.kalku/equivalent` uses, so accepting one is a move between
# files rather than a rewrite: the semantic key, then the reason.
fn proposal_of(r: Remembered, reason: String) : String = join(
  [
    "# #{where_of(r.site)}",
    "#{r.site.file} #{r.site.enclosing.unwrap_or("?")} #{r.site.ordinal.unwrap_or(1)} #{spell_name(r.site.spell)}: #{trim(reason)}",
    ""
  ],
  "\n"
)

# ---- the server ---------------------------------------------------------

# A server that casts wekufe on request is remote code execution by
# definition, so the socket is a file only its owner can open, under a
# directory the system already keeps private.
fn serving_here() : Int / Stdout + Stderr + Env + File + Process + Spawn + Clock + NetUnix + Signal {
  let mine = my_uid()
  let path = socket_path(Env.get("XDG_RUNTIME_DIR"), asked_temp(), mine)
  # The mailbox and the ward belong to the server, not to a run: the
  # kalku a run leaves warm keep talking to this mailbox, and whatever is
  # still alive when the server ends is killed by this ward.
  # A ward now reports a kalku that would not die, and for the server that
  # belongs on stderr with everything else it says about itself. A run's own
  # notes still go to its client, through `streamed`.
  let ending = told(
    () => with_mailbox {
      warded(() => serve_at(path, mine, (p, asked, say) => run_for(p, asked, say)))
    }
  )
  match ending {
    Err(why) -> {
      Stderr.eprint("kalku: #{why}")
      2
    }
    Ok(_) -> 0
  }
}

# A run over a project's own kalku: the warm ones when they were compiled
# from exactly this project, a fresh pool when they were not.
fn run_for(
  p: Project,
  asked: RunMsg,
  say: (ServerEvent) -> Unit / Actor[OrchMsg]
) : (Project, [ServerEvent]) / Stderr + Env + File + Process + Spawn + Clock + Actor[OrchMsg] + Ward + NetUnix =
  match settings_in(p.root) {
    Err(why) -> (p, [ErrorEv(ErrorMsg { code: "no_config", message: why, fatal: false })])
    Ok(c) -> match language_of(c) {
      Err(why) -> (p, [ErrorEv(ErrorMsg { code: "no_config", message: why, fatal: false })])
      Ok(known) -> match measurable(p.root, asked, every_source(p.root, known)) {
        Err(no) -> (p, [no])
        Ok(files) -> measured_over(p, c, known, files, say)
      }
    }
  }

fn asked_temp() : String / Env = Env.get("TMPDIR").unwrap_or("/tmp")

# kaikai's stdlib cannot say what uid this process runs as
# (lnds/kaikai#2232), so it is asked of the system. Read once, at the
# start: it is what every later connection is checked against.
fn my_uid() : Int / Process = match proc.start_piped("/usr/bin/id", ["-u"]) {
  Err(_) -> 0 - 1
  Ok(child) -> {
    let said = drain_all(child, "")
    let _ = proc.wait(child)
    to_int(trim(said)).unwrap_or(0 - 1)
  }
}

fn drain_all(child: Child, so_far: String) : String / Process = match proc.read_stdout(child) {
  Err(_) -> so_far
  Ok(chunk) -> if is_empty(chunk) { so_far } else { drain_all(child, so_far ++ chunk) }
}

# What a client gets back for a `run`. The events arrive together rather
# The run says what it is doing as it does it, and a client hears it then
# rather than at the end: the notes the orchestrator already makes become
# the events the protocol has for them.
fn streamed[a, e](
  say: (ServerEvent) -> Unit / Actor[OrchMsg],
  body: () -> a / Telling + e
) : a / Actor[OrchMsg] + e = handle {
  body()
} with Telling {
  tell_of(_line, resume) -> resume(())
  entered(phase, resume) -> {
    say(PhaseEv(PhaseMsg { phase: phase }))
    resume(())
  }
  got_through(done, total, resume) -> {
    say(ProgressEv(RunProgressMsg { done: done, total: total, estimate_ms: None }))
    resume(())
  }
  # A client with no terminal hears the cost as the run's first progress:
  # nothing cast yet, this many to cast, and this long at the rate the
  # baseline ran.
  will_cost(casts, estimate_ms, resume) -> {
    say(ProgressEv(RunProgressMsg { done: 0, total: casts, estimate_ms: Some(estimate_ms) }))
    resume(())
  }
  return(x) -> x
}

# A server is asked about a root rather than standing in one: the config
# comes from there, the kalku is summoned there, and the paths a run
# reports stay the project's own.
fn asking_at(
  c: Config,
  root: String,
  files: [String],
  declared: [equivalent.Entry]
) : Asking / Env = Asking {
  ...asking_of(c, pool_at(c, root), files | (f => shortened(f, root)), declared)
}

# The pool for a project: the same kalku the CLI would summon, started
# where the project is.
# The reni belongs to the project being measured, not to wherever the
# server happens to be standing: a server measures projects that are not
# its own, and two of them sharing a reni is two of them compiling over
# each other's build.
fn pool_at(c: Config, root: String) : PoolSpec / Env {
  let reni = reni_of(c, root)
  PoolSpec { ...summoning_in(c, root, reni), command: "/bin/sh", args: elsewhere(c, root, reni) }
}

# `sh -c` takes the arguments after the command, and `$0` is the name, so
# the reni lands on `$@` exactly as it does when the script is run direct.
fn elsewhere(c: Config, root: String, reni: String) : [String] =
  ["-c", summoning(c, root), "kalku", reni]

# The summoning script is the project's, and it expects to be run from
# the project: a kalku that builds elsewhere measures elsewhere.
fn summoning(c: Config, root: String) : String =
  "cd '#{root}' && exec '#{c.summon.unwrap_or("")}' \"$@\""

fn shortened(path: String, root: String) : String =
  if starts_with(path, "#{root}/") { slice(path, length(root) + 1, length(path)) } else { path }

# A server is asked about a root rather than standing in one, so the
# config is read from there.
fn settings_in(root: String) : Result[Config, String] / Stderr + File + Env + Process {
  let path = "#{root}/#{CONFIG_PATH}"
  if file.exists(path) {
    usable(read_settings(file.read(path))!, root)
  } else {
    unsettled(root)
  }
}

fn found_events(found: Found) : [ServerEvent] = match found.report {
  None -> [
    ErrorEv(ErrorMsg {
      code: "not_measured",
      message: found.failure.unwrap_or("nothing measured"),
      fatal: false
    })
  ]
  Some(r) -> [report_event(r)]
}

fn report_event(r: Report) : ServerEvent = ReportEv(ReportMsg {
  score: score(r.counts),
  counts: r.counts,
  survivors_on_changed_lines: r.on_changed_lines,
  suppression_changes: r.suppressions,
  left_out: if is_empty(r.left_out.tests) { None } else { Some(r.left_out.tests | (.test_id)) },
  exit: exit_code(r.blockers)
})

# ---- the agent host -----------------------------------------------------

# MCP over stdio is JSON-RPC, one message per line, and a host holds the
# pipe open for as long as it wants the tools.
fn tooling() : Int / Stdin + Stdout + Stderr + Env + File + Process + Spawn + Clock + Signal =
  match Stdin.read_line() {
    None -> 0
    Some(line) -> {
      let asked = asked_of(trim_right(line))
      answer_host(asked.fst, asked.snd)
      tooling()
    }
  }

fn answer_host(
  id: Option[Int],
  heard: Heard
) : Unit / Stdout + Stderr + Env + File + Process + Spawn + Clock + Signal = match heard {
  Initialise -> Stdout.print(greeting(id))
  ListTools -> Stdout.print(tools(id))
  CallTool(c) -> Stdout.print(tool_ran(id, c))
  Notice -> ()
  Garbled(why) -> Stdout.print(protocol_error(id, why))
}

# The tools are the CLI's, and what they answer is what it prints. A tool
# that could not run says so as a result: the host shows that to the
# agent, which is who needs to know.
fn tool_ran(
  id: Option[Int],
  c: Call
) : String / Stderr + Env + File + Process + Spawn + Clock + Signal = match c.tool {
  "kalku_run" -> measured_for(id, c)
  "kalku_cast" -> recast_for(id, c)
  "kalku_show" -> shown_for(id, c)
  "kalku_propose_equivalent" -> proposal_for(id, c)
  other -> refused(id, "no such tool `#{other}`")
}

# A root the host named, or the one it is standing in.
fn root_of(c: Call) : String = c.root.unwrap_or(".")

fn measured_for(
  id: Option[Int],
  c: Call
) : String / Stderr + Env + File + Process + Spawn + Clock + Signal = if is_empty(c.wekufe) {
  refused(id, "`kalku_run` needs the files to measure")
} else {
  match settings_in(root_of(c)) {
    Err(why) -> refused(id, why)
    Ok(cfg) -> match declared_equivalents(root_of(c)) {
      Err(why) -> refused(id, why)
      Ok(declared) -> as_agent(
        root_of(c),
        id,
        with_mailbox {
          alone(() => untold(() => measure(asking_at(cfg, root_of(c), c.wekufe, declared))))
        }
      )
    }
  }
}

fn recast_for(
  id: Option[Int],
  c: Call
) : String / Stderr + Env + File + Process + Spawn + Clock + Signal = if is_empty(c.wekufe) {
  refused(id, "`kalku_cast` needs the wekufe to re-cast")
} else {
  match settings_in(root_of(c)) {
    Err(why) -> refused(id, why)
    Ok(cfg) -> {
      let all = ledger_in(root_of(c))
      let unknown = strangers(all, c.wekufe)
      if not is_empty(unknown) {
        refused(id, "never cast: #{join(unknown, ", ")}")
      } else {
        match declared_equivalents(root_of(c)) {
          Err(why) -> refused(id, why)
          Ok(declared) -> as_agent(
            root_of(c),
            id,
            with_mailbox {
              alone(
                () => untold(
                  () => measure(narrowed(cfg, root_of(c), sites_for(all, c.wekufe), declared))
                )
              )
            }
          )
        }
      }
    }
  }
}

fn shown_for(id: Option[Int], c: Call) : String / File + Env = match head(c.wekufe) {
  None -> refused(id, "`kalku_show` needs a wekufe")
  Some(w) -> {
    let all = ledger_in(root_of(c))
    match latest(all, w) {
      None -> refused(id, "nothing known about `#{w}`; run `kalku_run` first")
      Some(r) -> answered(id, showing.as_json(r, history(all, w)))
    }
  }
}

fn proposal_for(id: Option[Int], c: Call) : String / File + Env = match head(c.wekufe) {
  None -> refused(id, "`kalku_propose_equivalent` needs a wekufe")
  Some(w) -> if is_empty(trim(c.reason)) {
    refused(id, "`kalku_propose_equivalent` needs a reason a person can weigh")
  } else {
    proposal_written(id, root_of(c), w, c.reason)
  }
}

fn proposal_written(
  id: Option[Int],
  root: String,
  wekufe: String,
  reason: String
) : String / File + Env {
  let all = ledger_in(root)
  match latest(all, wekufe) {
    None -> refused(id, "nothing known about `#{wekufe}`; run `kalku_run` first")
    Some(_) if not set_up(root) -> refused(id, why_not_kept(root))
    Some(r) -> if r.outcome != Survived {
      refused(
        id,
        "`#{wekufe}` is #{outcome_name(r.outcome)}, not survived; only a survivor can be equivalent"
      )
    } else {
      {
        append_proposal_in(root, r, reason)
        answered(id, "proposed, for review in #{root}/#{PROPOSED_PATH}:\n#{proposal_of(r, reason)}")
      }
    }
  }
}

# The agent format is what a host hands an agent: one line per survivor,
# everything needed to act on it, and a summary.
fn as_agent(root: String, id: Option[Int], found: Found) : String / File + Env {
  remember_in(root, found.cast)
  match found.report {
    None -> refused(id, found.failure.unwrap_or("nothing measured"))
    Some(r) -> answered(id, agent(r, of_files(sources_of(r))))
  }
}

fn narrowed(
  cfg: Config,
  root: String,
  sites: [Site],
  declared: [equivalent.Entry]
) : Asking / Env = Asking {
  ...asking_at(cfg, root, uniq(sites | (.file)), declared),
  only: sites | (.site_id)
}

fn append_proposal_in(root: String, r: Remembered, reason: String) : Unit / File {
  let path = "#{root}/#{PROPOSED_PATH}"
  let was = if file.exists(path) { file.read(path) } else { "" }
  file.write(path, was ++ proposal_of(r, reason))
}

# ---- measuring over a warm pool -----------------------------------------

# The kalku a project keeps are only worth keeping while they hold a copy
# of exactly that project. The fingerprint is what says so, and it covers
# A client that speaks while this project is being measured. Status is
# answered from what this fiber knows, a cancellation is left for the run
# itself, and a second run is refused: one set of warm kalku measures one
# thing at a time.
fn answered_mid_run(p: Project, m: OrchMsg) : Unit / Actor[OrchMsg] = match m {
  Aside(_who, back, line) -> match heard_mid_run(line, [p]) {
    Reply(id, e) -> Actor.send(back, Aside(0, back, said(id, e)))
    StopTheRun(_id) -> Actor.send(Actor.self(), Cancel)
    SayNothing -> ()
  }
  _ -> ()
}

# what a measurement depends on: the sources and the tests.
fn measured_over(
  p: Project,
  c: Config,
  known: setting_up.Known,
  files: [String],
  say: (ServerEvent) -> Unit / Actor[OrchMsg]
) : (Project, [ServerEvent]) / Stderr + Env + File + Process + Spawn + Clock + Actor[OrchMsg] + Ward + NetUnix {
  # The fingerprint covers the project, not the request: warm kalku hold a
  # copy of all of it, and a file this run does not measure can still be
  # the one that made them stale.
  let now = fingerprint(read_hashes(every_source(p.root, known) ++ every_test(p.root, known)))
  # A run that cannot read what the project declared does not start: the
  # alternative is measuring while ignoring a suppression, and reporting
  # a hole somebody already decided was not one.
  let asking = asking_at(c, p.root, files, declared_equivalents(p.root).unwrap_or([]))
  # Asked before the pool is opened, and never while it is being opened:
  # a kalku greeting its way to `ready` talks into the same mailbox this
  # is waiting on, and two conversations in one mailbox is how a run
  # waits forever for a reply it has already discarded.
  # Around the whole of it, not only the discovery: a client can speak at
  # any moment of a run, and the moments that take longest — opening a
  # pool, casting — are exactly the ones it will ask about.
  attended(
    m => answered_mid_run(p, m),
    () => match streamed(say, () => discover(asking)) {
      Err(why) -> (p, [ErrorEv(ErrorMsg { code: "not_measured", message: why, fatal: false })])
      Ok(known) -> cast_it(warm_pool(p, c, now, say), asking, known, say)
    }
  )
}

fn cast_it(
  p: Project,
  asking: Asking,
  known: measure.Known,
  say: (ServerEvent) -> Unit / Actor[OrchMsg]
) : (Project, [ServerEvent]) / Process + Spawn + Clock + Attending + Actor[OrchMsg] + Ward + NetUnix {
  let plan_of_it = plan(inputs_for(asking, known), _id => None)
  let casts = repeated(plan_of_it.to_cast)
  let done = streamed(say, () => cast_over(asking.spec, p.slots, casts, p.next_id))
  let report = report_of(plan_of_it, agreed(done.fst), known)
  (
    Project { ...p, slots: done.snd, next_id: done.trd },
    [report_event(report)]
  )
}

# A pool is opened when there is none, and replaced when the project it
# was compiled from is not the project on disk any more. Measuring with a
# kalku that holds last week's code is measuring last week's code.
fn warm_pool(
  p: Project,
  c: Config,
  now: String,
  say: (ServerEvent) -> Unit / Actor[OrchMsg]
) : Project / Stderr + Process + Spawn + Clock + Env + Actor[OrchMsg] + Ward + NetUnix =
  if still_warm(
    p,
    now
  ) {
    p
  } else {
    {
      each(p.slots, s => banish(s))
      say(PhaseEv(PhaseMsg { phase: PhasePreparing }))
      Project { ...p, slots: open_pool(pool_at(c, p.root)), fingerprint: now, next_id: 1 }
    }
  }

# The paths a walk gives back are absolute, and joining them to the root
# again names a file that does not exist — which hashes to the same
# nothing every time, and a fingerprint that never changes is a warm pool
# that is never renewed.
fn read_hashes(files: [String]) : [FileHash] / File =
  files | (f => FileHash { file: f, hash: hash_of(read_or_empty(f)) })

fn read_or_empty(path: String) : String / File =
  if file.exists(path) { file.read(path) } else { "" }
