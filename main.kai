#[doc("kalku's entry point: parse the arguments, print, and return the exit code.")]

import actor
import os.args
import fs.file
import fs.dir
import os.process as proc
import kalku.wire.enums
import kalku.core.report
import kalku.core.score
import kalku.core.report_agent
import kalku.core.report_json
import kalku.core.report_github
import kalku.core.config
import kalku.core.setting_up
import kalku.core.info
import kalku.core.remembering
import kalku.core.showing
import kalku.orchestrator.kalku_proc
import kalku.orchestrator.pool
import kalku.orchestrator.measure
import kalku.orchestrator.telling
import kalku.settling
import kalku.serving
import kalku.orchestrator.server
import kalku.cli

fn main() : Int / Stdin + Stdout + Stderr + Env + File + Process + Spawn + Clock + NetUnix {
  match cli.parse_args(args.argv()) {
    ShowVersion -> {
      Stdout.print(cli.version_line())
      0
    }
    ShowHelp -> {
      Stdout.print(cli.help_text())
      0
    }
    Initialise(setup) -> settle(setup.root, setup.language, setup.assume_yes)
    Inform(asked) -> told_about(asked)
    Display(wekufe, shape) -> shown(wekufe, shape)
    Recast(wanted) -> recast_here(wanted)
    Propose(wekufe, reason) -> proposed(wekufe, reason)
    Serve -> serving_here()
    Measure(wanted) -> run_here(wanted)
    Misused(why) -> {
      Stderr.eprint("kalku: #{why}\n#{cli.usage_line()}")
      2
    }
    Pending(cmd) -> {
      Stderr.eprint("kalku: `#{cmd}` is not implemented yet")
      2
    }
    Unknown(cmd) -> {
      Stderr.eprint("kalku: unknown command `#{cmd}`\n#{cli.usage_line()}")
      2
    }
  }
}

# What kalku knows about itself, for whoever asks: a person who wonders
# what `survived` means, or an agent that would otherwise guess.
fn told_about(asked: Asked) : Int / Stdout + Stderr = if asked.snippet_only {
  {
    Stdout.print(snippet())
    0
  }
} else {
  match asked.topic {
    None -> {
      Stdout.print(listing())
      0
    }
    Some(name) -> match page(name) {
      None -> {
        Stderr.eprint("kalku: no such topic `#{name}`\n#{listing()}")
        2
      }
      Some(t) -> {
        Stdout.print(if asked.as_json { as_json(t) } else { as_text(t) })
        0
      }
    }
  }
}

# A run measures the project one is standing in, with the kalku that
# project's `.kalku.toml` names. Without that file there is nothing to
# summon, so the way out is `kalku init` rather than a guess.
fn run_here(wanted: Wanted) : Int / Stdout + Stderr + Env + File + Process + Spawn + Clock =
  match settings() {
    Err(why) -> {
      Stderr.eprint("kalku: #{why}")
      2
    }
    Ok(c) -> if is_empty(wanted.files) {
      {
        Stderr.eprint("kalku: name the files to measure, as in `kalku run lib/thing.ex`")
        2
      }
    } else {
      measured(asking_for(c, wanted), wanted)
    }
  }

fn measured(
  asking: Asking,
  wanted: Wanted
) : Int / Stdout + Stderr + File + Process + Spawn + Clock = with_mailbox {
  let shape = wanted.shape
  let found = telling(wanted.aloud, () => measure(asking))
  match found.failure {
    Some(why) -> {
      Stderr.eprint("kalku: #{why}")
      2
    }
    None -> match found.report {
      None -> {
        Stderr.eprint("kalku: nothing measured")
        2
      }
      Some(r) -> {
        remember(found.cast)
        Stdout.print(printed(r, shape))
        exit_code(r.blockers)
      }
    }
  }
}

# Each format is a different reader: a person, an agent, a program, a
# pull request. The survivors are the same in all of them.
fn printed(r: Report, shape: Shape) : String / File {
  case r, AsHuman -> human(r)
  case r, AsAgent -> agent(r, of_files(sources_of(r)))
  case r, AsJson -> json(r, exit_code(r.blockers))
  case r, AsGithub -> "#{annotations(r)}\n#{step_summary(r)}"
}

# The lines around a survivor travel with it in the agent format, so an
# agent does not have to open a file to see what it is looking at. The
# files are read here and looked up purely, because the format reads
# nothing itself — which is what makes it testable without a filesystem.
fn sources_of(r: Report) : [(String, [String])] / File =
  uniq(r.survivors | (s => s.site.file)) | (path => (path, read_lines(path)))

fn read_lines(path: String) : [String] / File =
  if file.exists(path) { lines(file.read(path)) } else { [] }

fn of_files(sources: [(String, [String])]) : (String) -> [String] =
  path => match find(sources, s => s.fst == path) {
    Some(s) -> s.snd
    None -> []
  }

# ---- what a run was asked for -------------------------------------------

fn settings() : Result[Config, String] / File = if file.exists(CONFIG_PATH) {
  read_settings(file.read(CONFIG_PATH))
} else {
  Err("no #{CONFIG_PATH} here; run `kalku init` to set this project up")
}

fn read_settings(text: String) : Result[Config, String] = match config.parse(text) {
  Err(problems) -> Err(join(problems | (p => "#{CONFIG_PATH}: #{p.key}: #{p.message}"), "\n"))
  Ok(c) -> if is_some(c.summon) {
    Ok(c)
  } else {
    Err("#{CONFIG_PATH} names no kalku to summon; `kalku init` writes one")
  }
}

# The kalku a project summons and the workspace it works in, both from
# what `kalku init` wrote down.
fn pool_of(c: Config) : PoolSpec = PoolSpec {
  command: c.summon.unwrap_or(""),
  args: [],
  workers: c.workers.unwrap_or(1),
  root: ".",
  reni: c.reni.unwrap_or("/tmp/kalku/reni"),
  inline_limit_bytes: 65536,
  env: StrMap { entries: [] },
  greeting_ms: 60000,
  summons_allowed: 2
}

fn asking_for(c: Config, wanted: Wanted) : Asking = Asking {
  spec: pool_of(c),
  files: wanted.files,
  only: [],
  spells: c.spells,
  exclude_calls: c.exclude_calls,
  limit: wanted.limit.unwrap_or(0),
  timeout_floor_ms: c.timeout_floor_ms
}

# ---- the agent loop -----------------------------------------------------

# What a run wrote down about this project, or nothing when none has run.
fn ledger() : [Remembered] / File =
  if file.exists(LEDGER_PATH) { read_all(file.read(LEDGER_PATH)) } else { [] }

fn remember(rs: [Remembered]) : Unit / File {
  let was = if file.exists(LEDGER_PATH) { file.read(LEDGER_PATH) } else { "" }
  file.write(LEDGER_PATH, was ++ join(rs | line_of, "\n") ++ "\n")
}

# One wekufe in full: what it is, what came of it, and what came of it
# before. A wekufe nobody has cast is not a wekufe kalku knows.
# A wekufe nobody has cast is a name kalku cannot place, and saying so is
# the only honest answer to a question about it.
fn unheard_of(wekufe: String) : Int / Stderr {
  Stderr.eprint("kalku: nothing known about `#{wekufe}`; run `kalku run <files>` first")
  2
}

fn shown(wekufe: String, shape: Shape) : Int / Stdout + Stderr + File {
  let all = ledger()
  match latest(all, wekufe) {
    None -> unheard_of(wekufe)
    Some(r) -> {
      let before = history(all, wekufe)
      Stdout.print(if shape == AsHuman {
        showing.as_text(r, before)
      } else {
        showing.as_json(r, before)
      })
      0
    }
  }
}

# Re-casting names wekufe, and a name becomes a site through the ledger:
# a wekufe kalku has never cast is a name it cannot place, which is said
# rather than guessed at.
fn recast_here(wanted: Wanted) : Int / Stdout + Stderr + Env + File + Process + Spawn + Clock =
  match settings() {
    Err(why) -> {
      Stderr.eprint("kalku: #{why}")
      2
    }
    Ok(c) -> {
      let all = ledger()
      let unknown = strangers(all, wanted.files)
      if not is_empty(unknown) {
        {
          Stderr.eprint("kalku: never cast: #{join(unknown, ", ")}")
          2
        }
      } else {
        measured(asking_again(c, sites_for(all, wanted.files), wanted), wanted)
      }
    }
  }

# The files those sites live in, because a kalku is asked for sites by
# file and the plan is narrowed to the wekufe that were named.
fn asking_again(c: Config, sites: [Site], wanted: Wanted) : Asking = Asking {
  spec: pool_of(c),
  files: uniq(sites | (.file)),
  only: sites | (.site_id),
  spells: c.spells,
  exclude_calls: c.exclude_calls,
  limit: 0,
  timeout_floor_ms: c.timeout_floor_ms
}

# Proposed, never applied: an agent may say why a wekufe cannot be told
# apart, and a person decides whether that is true. `.kalku/equivalent`
# is not written here, ever.
fn proposed(wekufe: String, reason: String) : Int / Stdout + Stderr + File {
  let all = ledger()
  match latest(all, wekufe) {
    None -> unheard_of(wekufe)
    Some(r) -> if r.outcome != Survived {
      {
        Stderr.eprint(
          "kalku: `#{wekufe}` is #{outcome_name(r.outcome)}, not survived; only a survivor can be equivalent"
        )
        2
      }
    } else {
      {
        append_proposal(r, reason)
        Stdout.print("kalku: proposed, for review in #{PROPOSED_PATH}")
        0
      }
    }
  }
}

#[doc("Where proposals wait for a person. Never `.kalku/equivalent` itself.")]
const PROPOSED_PATH : String = ".kalku/equivalent.proposed"

fn append_proposal(r: Remembered, reason: String) : Unit / File {
  let was = if file.exists(PROPOSED_PATH) { file.read(PROPOSED_PATH) } else { "" }
  file.write(PROPOSED_PATH, was ++ proposal_of(r, reason))
}

# The syntax `.kalku/equivalent` uses, so accepting one is a move between
# files rather than a rewrite: the semantic key, then the reason.
fn proposal_of(r: Remembered, reason: String) : String = join(
  [
    "# #{where_of(r.site)}",
    "#{r.site.file} #{r.site.enclosing.unwrap_or("?")} #{r.site.ordinal.unwrap_or(1)} #{spell_name(r.site.spell)}: #{trim(reason)}",
    ""
  ],
  "\n"
)

# ---- the server ---------------------------------------------------------

# A server that casts wekufe on request is remote code execution by
# definition, so the socket is a file only its owner can open, under a
# directory the system already keeps private.
fn serving_here() : Int / Stdout + Stderr + Env + File + Process + Spawn + Clock + NetUnix {
  let mine = my_uid()
  let path = socket_path(Env.get("XDG_RUNTIME_DIR"), asked_temp(), mine)
  match serve_at(path, mine, root => run_for(root)) {
    Err(why) -> {
      Stderr.eprint("kalku: #{why}")
      2
    }
    Ok(_) -> 0
  }
}

fn asked_temp() : String / Env = Env.get("TMPDIR").unwrap_or("/tmp")

# kaikai's stdlib cannot say what uid this process runs as
# (lnds/kaikai#2232), so it is asked of the system. Read once, at the
# start: it is what every later connection is checked against.
fn my_uid() : Int / Process = match proc.start_piped("/usr/bin/id", ["-u"]) {
  Err(_) -> 0 - 1
  Ok(child) -> {
    let said = drain_all(child, "")
    let _ = proc.wait(child)
    to_int(trim(said)).unwrap_or(0 - 1)
  }
}

fn drain_all(child: Child, so_far: String) : String / Process = match proc.read_stdout(child) {
  Err(_) -> so_far
  Ok(chunk) -> if is_empty(chunk) { so_far } else { drain_all(child, so_far ++ chunk) }
}

# What a client gets back for a `run`. The events arrive together rather
# than as the run makes them: streaming them needs the run and the socket
# to be different fibers, which is what warm sessions bring.
#
# Cold every time, for now: the project is prepared, measured and let go
# of. What a server saves today is the client having to be kalku itself.
fn run_for(root: String) : [ServerEvent] / Stdout + Stderr + Env + File + Process + Spawn + Clock {
  let at = Wanted { files: [], limit: None, aloud: false, shape: AsHuman }
  match settings_in(root) {
    Err(why) -> [ErrorEv(ErrorMsg { code: "no_config", message: why, fatal: false })]
    Ok(c) -> found_events(
      with_mailbox {
        untold(() => measure(asking_at(c, root, every_source(root))))
      }
    )
  }
}

# A server is asked about a root rather than standing in one: the config
# comes from there, the kalku is summoned there, and the paths a run
# reports stay the project's own.
fn asking_at(c: Config, root: String, files: [String]) : Asking = Asking {
  spec: PoolSpec {
    ...pool_of(c),
    command: "/bin/sh",
    args: ["-c", summoning(c, root)],
    root: root
  },
  files: files | (f => shortened(f, root)),
  only: [],
  spells: c.spells,
  exclude_calls: c.exclude_calls,
  limit: 0,
  timeout_floor_ms: c.timeout_floor_ms
}

# The summoning script is the project's, and it expects to be run from
# the project: a kalku that builds elsewhere measures elsewhere.
fn summoning(c: Config, root: String) : String =
  "cd '#{root}' && exec '#{c.summon.unwrap_or("")}'"

fn shortened(path: String, root: String) : String =
  if starts_with(path, "#{root}/") { slice(path, length(root) + 1, length(path)) } else { path }

# A server is asked about a root rather than standing in one, so the
# config is read from there.
fn settings_in(root: String) : Result[Config, String] / File {
  let path = "#{root}/#{CONFIG_PATH}"
  if file.exists(path) {
    read_settings(file.read(path))
  } else {
    Err("no #{CONFIG_PATH} in #{root}; run `kalku init` there")
  }
}

# Every source file the project has, which is what `scope: all` means. A
# kalku is asked for sites by file, and this is the list it is asked for.
fn every_source(root: String) : [String] / File =
  filter(dir.walk("#{root}/lib"), f => ends_with(f, ".ex") or ends_with(f, ".kai"))

fn found_events(found: Found) : [ServerEvent] = match found.report {
  None -> [
    ErrorEv(ErrorMsg {
      code: "not_measured",
      message: found.failure.unwrap_or("nothing measured"),
      fatal: false
    })
  ]
  Some(r) -> [PhaseEv(PhaseMsg { phase: PhaseReporting }), report_event(r)]
}

fn report_event(r: Report) : ServerEvent = ReportEv(ReportMsg {
  score: score(r.counts),
  counts: r.counts,
  survivors_on_changed_lines: r.on_changed_lines,
  suppression_changes: r.suppressions,
  exit: exit_code(r.blockers)
})
