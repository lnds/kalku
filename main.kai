#[doc("kalku's entry point: parse the arguments, print, and return the exit code.")]

import actor
import os.args
import fs.file
import os.process as proc
import kalku.wire.enums
import kalku.core.report
import kalku.core.score
import kalku.core.cache
import kalku.core.planner
import kalku.orchestrator.scheduler
import kalku.orchestrator.attending
import kalku.orchestrator.attending_to
import kalku.core.report_agent
import kalku.core.report_json
import kalku.core.report_github
import kalku.core.config
import kalku.core.equivalent
import kalku.core.answering
import kalku.core.equivalent_parse as eqfile
import kalku.core.setting_up
import kalku.sources
import kalku.core.info
import kalku.core.mcp
import kalku.core.remembering
import kalku.ledgering
import kalku.core.showing
import kalku.orchestrator.kalku_proc
import kalku.orchestrator.pool
