#[doc("kalku's entry point: parse the arguments, print, and return the exit code.")]

import actor
import os.args
import fs.file
import kalku.wire.enums
import kalku.core.report
import kalku.core.report_agent
import kalku.core.report_json
import kalku.core.report_github
import kalku.core.config
import kalku.core.setting_up
import kalku.core.info
import kalku.orchestrator.kalku_proc
import kalku.orchestrator.pool
import kalku.orchestrator.measure
import kalku.orchestrator.telling
import kalku.settling
import kalku.cli

fn main() : Int / Stdin + Stdout + Stderr + Env + File + Process + Spawn + Clock {
  match cli.parse_args(args.argv()) {
    ShowVersion -> {
      Stdout.print(cli.version_line())
      0
    }
    ShowHelp -> {
      Stdout.print(cli.help_text())
      0
    }
    Initialise(setup) -> settle(setup.root, setup.language, setup.assume_yes)
    Inform(asked) -> told_about(asked)
    Measure(wanted) -> run_here(wanted)
    Misused(why) -> {
      Stderr.eprint("kalku: #{why}\n#{cli.usage_line()}")
      2
    }
    Pending(cmd) -> {
      Stderr.eprint("kalku: `#{cmd}` is not implemented yet")
      2
    }
    Unknown(cmd) -> {
      Stderr.eprint("kalku: unknown command `#{cmd}`\n#{cli.usage_line()}")
      2
    }
  }
}

# What kalku knows about itself, for whoever asks: a person who wonders
# what `survived` means, or an agent that would otherwise guess.
fn told_about(asked: Asked) : Int / Stdout + Stderr = if asked.snippet_only {
  {
    Stdout.print(snippet())
    0
  }
} else {
  match asked.topic {
    None -> {
      Stdout.print(listing())
      0
    }
    Some(name) -> match page(name) {
      None -> {
        Stderr.eprint("kalku: no such topic `#{name}`\n#{listing()}")
        2
      }
      Some(t) -> {
        Stdout.print(if asked.as_json { as_json(t) } else { as_text(t) })
        0
      }
    }
  }
}

# A run measures the project one is standing in, with the kalku that
# project's `.kalku.toml` names. Without that file there is nothing to
# summon, so the way out is `kalku init` rather than a guess.
fn run_here(wanted: Wanted) : Int / Stdout + Stderr + Env + File + Process + Spawn + Clock =
  match settings() {
    Err(why) -> {
      Stderr.eprint("kalku: #{why}")
      2
    }
    Ok(c) -> if is_empty(wanted.files) {
      {
        Stderr.eprint("kalku: name the files to measure, as in `kalku run lib/thing.ex`")
        2
      }
    } else {
      measured(asking_for(c, wanted), wanted)
    }
  }

fn measured(
  asking: Asking,
  wanted: Wanted
) : Int / Stdout + Stderr + File + Process + Spawn + Clock = with_mailbox {
  let shape = wanted.shape
  let found = telling(wanted.aloud, () => measure(asking))
  match found.failure {
    Some(why) -> {
      Stderr.eprint("kalku: #{why}")
      2
    }
    None -> match found.report {
      None -> {
        Stderr.eprint("kalku: nothing measured")
        2
      }
      Some(r) -> {
        Stdout.print(printed(r, shape))
        exit_code(r.blockers)
      }
    }
  }
}

# Each format is a different reader: a person, an agent, a program, a
# pull request. The survivors are the same in all of them.
fn printed(r: Report, shape: Shape) : String / File {
  case r, AsHuman -> human(r)
  case r, AsAgent -> agent(r, of_files(sources_of(r)))
  case r, AsJson -> json(r, exit_code(r.blockers))
  case r, AsGithub -> "#{annotations(r)}\n#{step_summary(r)}"
}

# The lines around a survivor travel with it in the agent format, so an
# agent does not have to open a file to see what it is looking at. The
# files are read here and looked up purely, because the format reads
# nothing itself — which is what makes it testable without a filesystem.
fn sources_of(r: Report) : [(String, [String])] / File =
  uniq(r.survivors | (s => s.site.file)) | (path => (path, read_lines(path)))

fn read_lines(path: String) : [String] / File =
  if file.exists(path) { lines(file.read(path)) } else { [] }

fn of_files(sources: [(String, [String])]) : (String) -> [String] =
  path => match find(sources, s => s.fst == path) {
    Some(s) -> s.snd
    None -> []
  }

# ---- what a run was asked for -------------------------------------------

fn settings() : Result[Config, String] / File = if file.exists(CONFIG_PATH) {
  read_settings(file.read(CONFIG_PATH))
} else {
  Err("no #{CONFIG_PATH} here; run `kalku init` to set this project up")
}

fn read_settings(text: String) : Result[Config, String] = match config.parse(text) {
  Err(problems) -> Err(join(problems | (p => "#{CONFIG_PATH}: #{p.key}: #{p.message}"), "\n"))
  Ok(c) -> if is_some(c.summon) {
    Ok(c)
  } else {
    Err("#{CONFIG_PATH} names no kalku to summon; `kalku init` writes one")
  }
}

fn asking_for(c: Config, wanted: Wanted) : Asking = Asking {
  spec: PoolSpec {
    command: c.summon.unwrap_or(""),
    args: [],
    workers: c.workers.unwrap_or(1),
    root: ".",
    reni: c.reni.unwrap_or("/tmp/kalku/reni"),
    inline_limit_bytes: 65536,
    env: StrMap { entries: [] },
    greeting_ms: 60000,
    summons_allowed: 2
  },
  files: wanted.files,
  spells: c.spells,
  exclude_calls: c.exclude_calls,
  limit: wanted.limit.unwrap_or(0),
  timeout_floor_ms: c.timeout_floor_ms
}
