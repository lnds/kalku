#[doc("""
Command-line parsing and the text kalku prints about itself. Pure: `main`
owns the I/O and the exit code.
""")]

import kalku.version
import kalku.core.shard

#[doc("What the command line asks for.")]
#[derive(Eq, Show)]
pub type Command
  = ShowVersion
  | ShowHelp
  | Initialise(Setup)
  | Measure(Wanted)
  | Inform(Asked)
  | Recast(Wanted)
  | Display(String, Shape)
  | Propose(String, String)
  | Answer(String, Bool, String)
  | Serve
  | Mcp
  | Pending(String)
  | Unknown(String)
  | Misused(String)

#[doc("What `init` was asked to set up: where, in which language, and whether to ask first.")]
#[derive(Eq, Show)]
pub type Setup = { root: String, language: Option[String], assume_yes: Bool }

#[doc("What `run` was asked to measure: which files, and how much of them.")]
#[derive(Eq, Show)]
pub type Wanted = {
  files: [String],
  limit: Option[Int],
  aloud: Bool,
  shape: Shape,
  since: Option[String],
  all: Bool,
  shard: Option[Shard],
  store: Bool
}

#[doc("How a run prints what it found.")]
#[derive(Eq, Show)]
pub type Shape = AsHuman | AsAgent | AsJson | AsGithub

#[doc("What `info` was asked for: a topic, and how to print it.")]
#[derive(Eq, Show)]
pub type Asked = { topic: Option[String], as_json: Bool, snippet_only: Bool }

# Commands that are part of the design but not built yet.
const PENDING : [String] = ["serve", "cast", "show", "merge"]

#[doc("Read the arguments (program name excluded) into a `Command`.")]
pub fn parse_args(argv: [String]) : Command {
  case [] -> ShowHelp
  case ["help", ...] -> ShowHelp
  case ["-h", ...] -> ShowHelp
  case ["--help", ...] -> ShowHelp
  case ["--version", ...] -> ShowVersion
  case ["-V", ...] -> ShowVersion
  case ["init", ...rest] -> initialising(rest)
  case ["run", ...rest] -> measuring(rest)
  case ["info", ...rest] -> informing(rest)
  case ["cast", ...rest] -> recasting(rest)
  case ["show", ...rest] -> displaying(rest)
  case ["propose-equivalent", ...rest] -> proposing(rest, "", "")
  case ["accept", ...rest] -> answering(rest, "accept", true, "", "")
  case ["reject", ...rest] -> answering(rest, "reject", false, "", "")
  case ["serve", ...] -> Serve
  case ["mcp", ...] -> Mcp
  case [cmd, ...] -> if contains(PENDING, cmd) { Pending(cmd) } else { Unknown(cmd) }
}

# ---- init ---------------------------------------------------------------

# The directory is optional because `kalku init` in the project one is
# standing in is the whole point; `--lang` is optional because a project
# says what it is written in, and being told is only needed when the
# guess would be wrong.
fn initialising(args: [String]) : Command = read_setup(
  args,
  Setup { root: ".", language: None, assume_yes: false }
)

fn read_setup(args: [String], so_far: Setup) : Command = match args {
  [] -> Initialise(so_far)
  ["--lang"] -> Misused("`--lang` needs a language")
  ["--lang", lang, ...rest] -> read_setup(rest, Setup { ...so_far, language: Some(lang) })
  ["--yes", ...rest] -> read_setup(rest, Setup { ...so_far, assume_yes: true })
  ["-y", ...rest] -> read_setup(rest, Setup { ...so_far, assume_yes: true })
  [other, ...rest] -> if starts_with(other, "-") {
    Misused("`kalku init` does not take #{other}")
  } else {
    read_setup(rest, Setup { ...so_far, root: other })
  }
}

# ---- run ----------------------------------------------------------------

fn measuring(args: [String]) : Command = read_wanted(
  args,
  nothing_wanted()
)

#[doc("A run nobody has said anything about yet.")]
pub fn nothing_wanted() : Wanted = Wanted {
  files: [],
  limit: None,
  aloud: false,
  shape: AsHuman,
  since: None,
  all: false,
  shard: None,
  store: false
}

fn read_wanted(args: [String], so_far: Wanted) : Command = match args {
  [] -> whole_or_named(so_far)
  ["--all", ...rest] -> read_wanted(rest, Wanted { ...so_far, all: true })
  ["--store-baseline", ...rest] -> read_wanted(rest, Wanted { ...so_far, store: true })
  ["--shard"] -> Misused("`--shard` needs a part, as in `--shard 2/4`")
  ["--shard", part, ...rest] -> match shard_named(part) {
    None -> Misused("`--shard` takes a part of a count, as in `2/4`, not `#{part}`")
    Some(shard) -> read_wanted(rest, Wanted { ...so_far, shard: Some(shard) })
  }
  ["--limit"] -> Misused("`--limit` needs a number")
  ["--limit", n, ...rest] -> match to_int(n) {
    None -> Misused("`--limit` takes a number, not `#{n}`")
    Some(limit) -> read_wanted(rest, Wanted { ...so_far, limit: Some(limit) })
  }
  ["--format"] -> Misused("`--format` needs a name: human, agent, json or github")
  ["--format", name, ...rest] -> match shape_of(name) {
    None -> Misused("`--format` takes human, agent, json or github, not `#{name}`")
    Some(shape) -> read_wanted(rest, Wanted { ...so_far, shape: shape })
  }
  ["--since"] -> Misused("`--since` needs a ref, such as `origin/main`")
  ["--since", ref, ...rest] -> if starts_with(ref, "-") {
    Misused("`--since` takes a ref, not the option `#{ref}`")
  } else {
    read_wanted(rest, Wanted { ...so_far, since: Some(ref) })
  }
  ["--verbose", ...rest] -> read_wanted(rest, Wanted { ...so_far, aloud: true })
  ["-v", ...rest] -> read_wanted(rest, Wanted { ...so_far, aloud: true })
  [other, ...rest] -> if starts_with(other, "-") {
    Misused("`kalku run` does not take #{other}")
  } else {
    read_wanted(rest, Wanted { ...so_far, files: so_far.files ++ [other] })
  }
}

# `--all` is the whole project, and files beside it would be a second
# answer to the same question. A change has its own files too.
fn whole_or_named(w: Wanted) : Command = if w.all and (not is_empty(w.files)) {
  Misused("`--all` measures every source file; name files or say `--all`, not both")
} else if w.all and is_some(w.since) {
  Misused("`--all` measures the whole project and `--since` a change; say one")
} else if w.store and ((not w.all) or is_some(w.shard) or w.limit.unwrap_or(0) != 0) {
  Misused(
    "`--store-baseline` stores the score of the whole project: it goes with `--all`, and with neither `--shard` nor `--limit`"
  )
} else {
  Measure(w)
}

# ---- the agent loop -----------------------------------------------------

# `cast` names wekufe where `run` names files; everything else about them
# is the same, so they are read into the same shape.
fn recasting(args: [String]) : Command = match read_wanted(
  args,
  nothing_wanted()
) {
  Measure(w) -> if is_some(w.since) {
    Misused("`kalku cast` names wekufe; `--since` is for `kalku run`")
  } else if is_empty(w.files) {
    Misused("`kalku cast` needs a wekufe to re-cast")
  } else {
    Recast(w)
  }
  other -> other
}

fn displaying(args: [String]) : Command = read_shown(args, "", AsHuman)

fn read_shown(args: [String], wekufe: String, shape: Shape) : Command = match args {
  [] -> if is_empty(wekufe) {
    Misused("`kalku show` needs a wekufe to show")
  } else {
    Display(wekufe, shape)
  }
  ["--format"] -> Misused("`--format` needs a name: human, agent, json or github")
  ["--format", name, ...rest] -> match shape_of(name) {
    None -> Misused("`--format` takes human, agent, json or github, not `#{name}`")
    Some(asked) -> read_shown(rest, wekufe, asked)
  }
  [other, ...rest] -> if starts_with(other, "-") {
    Misused("`kalku show` does not take #{other}")
  } else {
    read_shown(rest, other, shape)
  }
}

# A reason is the whole point: an equivalent without one is a hole
# somebody talked themselves out of.
fn proposing(args: [String], wekufe: String, reason: String) : Command = match args {
  [] -> if is_empty(wekufe) {
    Misused("`kalku propose-equivalent` needs a wekufe")
  } else if is_empty(trim(reason)) {
    Misused("`kalku propose-equivalent` needs a `--reason`")
  } else {
    Propose(wekufe, reason)
  }
  ["--reason"] -> Misused("`--reason` needs the reason itself")
  ["--reason", why, ...rest] -> proposing(rest, wekufe, why)
  [other, ...rest] -> if starts_with(other, "-") {
    Misused("`kalku propose-equivalent` does not take #{other}")
  } else {
    proposing(rest, other, reason)
  }
}

# A person answers one proposal at a time, and says so by name. There is
# deliberately no way to answer them all: the point of an agent proposing
# and a person accepting is that each suppression was read by someone, and
# a flag that took fourteen arguments in one keystroke would be the agent
# accepting its own, with a step in front that fools nobody.
fn answering(
  args: [String],
  verb: String,
  yes: Bool,
  wekufe: String,
  why: String
) : Command = match args {
  [] -> if is_empty(wekufe) {
    Misused("`kalku #{verb}` needs a wekufe")
  } else {
    Answer(wekufe, yes, why)
  }
  ["--reason"] -> Misused("`--reason` needs the reason itself")
  ["--reason", w, ...rest] -> answering(rest, verb, yes, wekufe, w)
  [other, ...rest] -> if other == "--all" {
    Misused(
      "`kalku #{verb}` takes one wekufe. Each suppression is read by someone,"
        ++ " which is the whole of why an agent proposes and a person answers"
    )
  } else if starts_with(other, "-") {
    Misused("`kalku #{verb}` does not take #{other}")
  } else {
    answering(rest, verb, yes, other, why)
  }
}

fn shape_of(name: String) : Option[Shape] = match name {
  "human" -> Some(AsHuman)
  "agent" -> Some(AsAgent)
  "json" -> Some(AsJson)
  "github" -> Some(AsGithub)
  _ -> None
}

# ---- info ---------------------------------------------------------------

fn informing(args: [String]) : Command =
  read_asked(args, Asked { topic: None, as_json: false, snippet_only: false })

fn read_asked(args: [String], so_far: Asked) : Command = match args {
  [] -> Inform(so_far)
  ["--json", ...rest] -> read_asked(rest, Asked { ...so_far, as_json: true })
  ["--snippet", ...rest] -> read_asked(rest, Asked { ...so_far, snippet_only: true })
  [other, ...rest] -> if starts_with(other, "-") {
    Misused("`kalku info` does not take #{other}")
  } else {
    read_asked(rest, Asked { ...so_far, topic: Some(other) })
  }
}

#[doc("The `--version` line.")]
pub fn version_line() : String = "kalku #{version.VERSION}"

#[doc("The one-line usage shown on errors.")]
pub fn usage_line() : String = "usage: kalku <command> [options]  (kalku help for the list)"

#[doc("The full `help` text.")]
pub fn help_text() : String = """
kalku — mutation testing for humans, CI, and coding agents.

usage: kalku <command> [options]

commands:
  init [dir]       set a project up: detect its language, write `.kalku.toml`
  run [files...]   cast wekufe over those files and report survivors
  cast <wekufe>    re-cast these, after a test was written
  show <wekufe>    one wekufe in full: site, diff, tests, hint, history
  propose-equivalent <wekufe> --reason <why>
  accept <wekufe> [--reason <why>]   take a proposed equivalent into `.kalku/equivalent`
  reject <wekufe> [--reason <why>]   turn one down; the wekufe wants a test again
  info [topic]     what kalku knows about spells, outcomes, formats, agents

  serve            answer the client protocol on a local socket
  mcp              serve the agent tools to an MCP host, over stdio

not implemented yet:
  merge    combine sharded reports

options:
  --lang <name>    the project's language, when init should not guess
  -y, --yes        do not ask before writing
  --limit <n>      cast at most n wekufe: 100 by default, 0 for all of them
                   (a run with --since casts the whole change unless told otherwise)
  --since <ref>    measure only the lines changed since that ref, and block
                   when a wekufe survives on one of them
  --all            measure every source file of the project, all of its wekufe
  --shard <i/n>    cast only part i of n: the same part on every machine, so
                   n jobs cover a project between them
  --store-baseline store this run's score as the baseline `ratchet = true`
                   holds later runs of the whole project to
  --format <name>  human (the default), agent, json, or github
  --json           print an info topic as JSON
  --snippet        print only the lines an agent pastes into CLAUDE.md
  --reason <why>   why a wekufe cannot be told apart from the original
  -v, --verbose    say what the run is doing while it does it
  -h, --help       show this help
  -V, --version    show the version
"""
