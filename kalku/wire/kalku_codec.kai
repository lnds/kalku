#[doc("""
Encoding and decoding of the kalku protocol, both directions, plus the
rules a well-formed message must still satisfy (`invalid` errors).
""")]

import encoding.json
import kalku.wire.enums
import kalku.wire.shapes
import kalku.wire.envelope
import kalku.wire.kalku_msg
import kalku.wire.kalku_rules

# ---- requests: kaikai side -> kalku -------------------------------------

#[doc("Encode a request to a kalku as one canonical line (no trailing newline).")]
pub fn encode_request(id: Int, r: KalkuRequest) : String {
  case id, Hello(m) -> envelope("hello", id, to_json(m))
  case id, Prepare -> envelope("prepare", id, no_fields())
  case id, Baseline -> envelope("baseline", id, no_fields())
  case id, Sites(m) -> envelope("sites", id, to_json(m))
  case id, Cast(m) -> envelope("cast", id, to_json(m))
  case id, Abort(m) -> envelope("abort", id, to_json(m))
  case id, Reset -> envelope("reset", id, no_fields())
  case id, Reload(m) -> envelope("reload", id, to_json(m))
  case id, Delegate(m) -> envelope("delegate", id, to_json(m))
  case id, Shutdown -> envelope("shutdown", id, no_fields())
}

#[doc("Decode one line as a request to a kalku.")]
pub fn decode_request(line: String) : Result[Msg[KalkuRequest], ProtocolError] {
  let h = parse_head(line)!
  let r = request_body(h.kind, h.value)!
  Ok(Msg { id: h.id, body: r })
}

fn request_body(kind: String, v: JsonValue) : Result[KalkuRequest, ProtocolError] = match kind {
  "hello" -> body(hellomsg_of_json(v, ""), m => Hello(m))
  "prepare" -> Ok(Prepare)
  "baseline" -> Ok(Baseline)
  "sites" -> body(sitesmsg_of_json(v, ""), m => Sites(m))
  "cast" -> body(castmsg_of_json(v, ""), m => Cast(m))
  "abort" -> body(abortmsg_of_json(v, ""), m => Abort(m))
  "reset" -> Ok(Reset)
  "reload" -> body(reloadmsg_of_json(v, ""), m => Reload(m))
  "delegate" -> body(delegatemsg_of_json(v, ""), m => Delegate(m))
  "shutdown" -> Ok(Shutdown)
  _ -> unknown(kind)
}

# ---- replies: kalku -> kaikai side --------------------------------------

#[doc("Encode a kalku's reply as one canonical line (no trailing newline).")]
pub fn encode_reply(id: Int, r: KalkuReply) : String {
  case id, Ready(m) -> envelope("ready", id, to_json(m))
  case id, Prepared(m) -> envelope("prepared", id, to_json(m))
  case id, BaselineDone(m) -> envelope("baseline_done", id, to_json(m))
  case id, Progress(m) -> envelope("progress", id, to_json(m))
  case id, SitesFound(m) -> envelope("sites_found", id, to_json(m))
  case id, CastDone(m) -> envelope("cast_done", id, to_json(m))
  case id, Aborted(m) -> envelope("aborted", id, to_json(m))
  case id, ResetDone(m) -> envelope("reset_done", id, to_json(m))
  case id, Reloaded(m) -> envelope("reloaded", id, to_json(m))
  case id, Delegated(m) -> envelope("delegated", id, to_json(m))
  case id, Bye -> envelope("bye", id, no_fields())
  case id, KalkuError(m) -> envelope("error", id, to_json(m))
}

#[doc("Decode one line as a kalku's reply, checking the rules a reply must satisfy.")]
pub fn decode_reply(line: String) : Result[Msg[KalkuReply], ProtocolError] {
  let h = parse_head(line)!
  let r = reply_body(h.kind, h.value)!
  check_reply(r)!
  Ok(Msg { id: h.id, body: r })
}

fn reply_body(kind: String, v: JsonValue) : Result[KalkuReply, ProtocolError] = match kind {
  "ready" -> body(readymsg_of_json(v, ""), m => Ready(m))
  "prepared" -> body(preparedmsg_of_json(v, ""), m => Prepared(m))
  "baseline_done" -> body(baselinedonemsg_of_json(v, ""), m => BaselineDone(m))
  "progress" -> body(progressmsg_of_json(v, ""), m => Progress(m))
  "sites_found" -> body(sitesfoundmsg_of_json(v, ""), m => SitesFound(m))
  "cast_done" -> body(castdonemsg_of_json(v, ""), m => CastDone(m))
  "aborted" -> body(abortedmsg_of_json(v, ""), m => Aborted(m))
  "reset_done" -> body(resetdonemsg_of_json(v, ""), m => ResetDone(m))
  "reloaded" -> body(reloadedmsg_of_json(v, ""), m => Reloaded(m))
  "delegated" -> body(delegatedmsg_of_json(v, ""), m => Delegated(m))
  "bye" -> Ok(Bye)
  "error" -> body(errormsg_of_json(v, ""), m => KalkuError(m))
  _ -> unknown(kind)
}

#[doc("""
Decode a spilled coverage file: the same entries a `baseline_done` would
have carried inline, as a JSON array.

A kalku hands coverage over in one of two ways — inline when it is
small, in a file when it is not — and the two say the same thing. A
reader that understands only the inline form silently loses the coverage
of every project big enough to need the file, which is every project
worth measuring.
""")]
pub fn decode_coverage(text: String) : Result[[CoverageEntry], ProtocolError] = match json_decode(
  text
) {
  None -> fail(NotJson, "the coverage file is not valid JSON")
  Some(JArr(items)) -> all_entries(items, 0, [])
  Some(other) -> fail(NotObject, "coverage: expected an array, got #{json_shape_name(other)}")
}

fn all_entries(
  items: [JsonValue],
  at: Int,
  so_far: [CoverageEntry]
) : Result[[CoverageEntry], ProtocolError] = match items {
  [] -> Ok(so_far)
  [first, ...rest] -> match body(coverageentry_of_json(first, "coverage[#{at}]"), e => e) {
    Err(e) -> Err(e)
    Ok(entry) -> all_entries(rest, at + 1, so_far ++ [entry])
  }
}
