#[doc("""
Encoding and decoding of the client protocol, both directions, plus the
rules a well-formed message must still satisfy (`invalid` errors).
""")]

import kalku.wire.enums
import kalku.wire.shapes
import kalku.wire.envelope
import kalku.wire.client_msg

# ---- requests: client -> server -----------------------------------------

#[doc("Encode a client request as one canonical line (no trailing newline).")]
pub fn encode_client_request(id: Int, r: ClientRequest) : String {
  case id, RunReq(m) -> envelope("run", id, to_json(m))
  case id, RecastReq(m) -> envelope("cast", id, to_json(m))
  case id, ShowReq(m) -> envelope("show", id, to_json(m))
  case id, ProposeReq(m) -> envelope("propose_equivalent", id, to_json(m))
  case id, StatusReq -> envelope("status", id, no_fields())
  case id, CancelReq(m) -> envelope("cancel", id, to_json(m))
}

#[doc("Decode one line as a client request, checking the rules a request must satisfy.")]
pub fn decode_client_request(line: String) : Result[Msg[ClientRequest], ProtocolError] {
  let h = parse_head(line)!
  let r = client_request_body(h.kind, h.value)!
  check_client_request(r)!
  Ok(Msg { id: h.id, body: r })
}

fn client_request_body(kind: String, v: JsonValue) : Result[ClientRequest, ProtocolError] =
  match kind {
    "run" -> body(runmsg_of_json(v, ""), m => RunReq(m))
    "cast" -> body(recastmsg_of_json(v, ""), m => RecastReq(m))
    "show" -> body(showmsg_of_json(v, ""), m => ShowReq(m))
    "propose_equivalent" -> body(proposemsg_of_json(v, ""), m => ProposeReq(m))
    "status" -> Ok(StatusReq)
    "cancel" -> body(cancelmsg_of_json(v, ""), m => CancelReq(m))
    _ -> unknown(kind)
  }

fn check_client_request(r: ClientRequest) : Result[Unit, ProtocolError] = match r {
  RunReq(m) -> match m.shard {
    Some(s) ->
      require(s.index >= 1 and s.index <= s.count, "run: shard index must be within 1..count")
    None -> Ok(())
  }
  ProposeReq(m) -> require(
    not m.reason.trim().is_empty(),
    "propose_equivalent: reason must not be empty"
  )
  _ -> Ok(())
}

# ---- events: server -> client -------------------------------------------

#[doc("Encode a server event as one canonical line (no trailing newline).")]
pub fn encode_event(id: Int, e: ServerEvent) : String {
  case id, PhaseEv(m) -> envelope("phase", id, to_json(m))
  case id, ProgressEv(m) -> envelope("progress", id, to_json(m))
  case id, OutcomeEv(m) -> envelope("outcome", id, to_json(m))
  case id, TestRejectedEv(m) -> envelope("test_rejected", id, to_json(m))
  case id, ReportEv(m) -> envelope("report", id, to_json(m))
  case id, WekufeEv(m) -> envelope("wekufe", id, to_json(m))
  case id, ProposedEv(m) -> envelope("proposed", id, to_json(m))
  case id, SessionsEv(m) -> envelope("sessions", id, to_json(m))
  case id, CancelledEv(m) -> envelope("cancelled", id, to_json(m))
  case id, ErrorEv(m) -> envelope("error", id, to_json(m))
}

#[doc("Decode one line as a server event, checking the rules an event must satisfy.")]
pub fn decode_event(line: String) : Result[Msg[ServerEvent], ProtocolError] {
  let h = parse_head(line)!
  let e = event_body(h.kind, h.value)!
  check_event(e)!
  Ok(Msg { id: h.id, body: e })
}

fn event_body(kind: String, v: JsonValue) : Result[ServerEvent, ProtocolError] = match kind {
  "phase" -> body(phasemsg_of_json(v, ""), m => PhaseEv(m))
  "progress" -> body(progressmsg_of_json(v, ""), m => ProgressEv(m))
  "outcome" -> body(outcomemsg_of_json(v, ""), m => OutcomeEv(m))
  "test_rejected" -> body(testrejectedmsg_of_json(v, ""), m => TestRejectedEv(m))
  "report" -> body(reportmsg_of_json(v, ""), m => ReportEv(m))
  "wekufe" -> body(wekufemsg_of_json(v, ""), m => WekufeEv(m))
  "proposed" -> body(proposedmsg_of_json(v, ""), m => ProposedEv(m))
  "sessions" -> body(sessionsmsg_of_json(v, ""), m => SessionsEv(m))
  "cancelled" -> body(cancelledmsg_of_json(v, ""), m => CancelledEv(m))
  "error" -> body(errormsg_of_json(v, ""), m => ErrorEv(m))
  _ -> unknown(kind)
}

# A site is absent exactly when the wekufe is gone.
fn check_event(e: ServerEvent) : Result[Unit, ProtocolError] = match e {
  OutcomeEv(m) ->
    require(
      is_some(m.site) != (m.outcome == Gone),
      "outcome: site goes with every outcome but gone"
    )
  _ -> Ok(())
}
