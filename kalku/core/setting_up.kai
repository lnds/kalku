#[doc("""
What `kalku init` decides, worked out without touching a thing.

A project says what it is written in — `mix.exs` means Elixir, `Cargo.toml`
means Rust, `kai.toml` means kaikai — so being told is only needed when the
guess would be wrong. Everything here is a decision about files: what to look
for, what to write, and what to say. `main` performs it, and asks first.

The catalogue below is the one place the kaikai side knows a language by
name, and it is data rather than logic: a marker to look for, and the
summoning to write. What that summoning must do belongs to the kalku it
summons, which is why it is written into the project as a script the
owner can read and change.
""")]

#[doc("""
A language kalku can set a project up for.

`sources` are the extensions of the files that are the project's code. `also`
are other files that mean the same language as `marker`. `tests` are
directory names whose files are the suite, `test_prefixes` and `test_suffixes`
the beginnings and endings of the names of files that are, and `ignored`
directories that are neither (what a build
leaves, what a version control keeps). A change or a whole project is
read through these, so the core does not need to know a layout.
""")]
#[derive(Eq, Show)]
pub type Known = {
  language: String,
  marker: String,
  also: [String],
  summon: String,
  sources: [String],
  tests: [String],
  test_prefixes: [String],
  test_suffixes: [String],
  ignored: [String]
}

#[doc("What init found, and what it would write.")]
#[derive(Eq, Show)]
pub type Plan = { known: Known, config: String, summoner: String, dependency: Option[String] }

#[doc("Why init could not decide.")]
#[derive(Eq, Show)]
pub type Puzzle = Unknown(String) | Undetected | Ambiguous([String])

#[doc("Where the summoning script a project gets is written.")]
pub const SUMMONER_PATH : String = ".kalku/summon"

#[doc("""
What this kalku expects a summoning to do.

The script is written once, into the project, and a project set up a year
ago keeps the script it was given. Every fix to the summoning — what it
sends to stderr, what it is handed on the command line — reaches only the
projects that run `init` again, and nothing told them to. So the script
carries the contract it was written against, a run refuses one it does
not recognise, and `init` replaces an old one instead of keeping it.

Bumped when the script's obligations change, not when its wording does.
""")]
pub const SUMMON_CONTRACT : Int = 1

#[doc("The line that says which contract a summoning was written against.")]
pub fn contract_line(n: Int) : String = "# kalku-summon-contract: #{n}"

#[doc("Which contract a summoning claims, or `None` when it claims none.")]
pub fn contract_of(script: String) : Option[Int] = match find(
  lines(script),
  l => starts_with(trim(l), "# kalku-summon-contract:")
) {
  None -> None
  Some(l) -> to_int(trim(slice(trim(l), 25, length(trim(l)))))
}

#[doc("True when a summoning is one this kalku knows how to use.")]
pub fn summon_is_current(script: String) : Bool =
  contract_of(script) == Some(SUMMON_CONTRACT)

#[doc("Where a project's configuration is written.")]
pub const CONFIG_PATH : String = ".kalku.toml"

#[doc("Every language this kalku can set a project up for.")]
pub fn catalogue() : [Known] = [
  Known {
    language: "elixir",
    marker: "mix.exs",
    also: [],
    summon: elixir_summoner(),
    sources: [".ex"],
    tests: ["test"],
    test_prefixes: [],
    test_suffixes: ["_test.exs"],
    ignored: ["_build", "deps", ".git", "node_modules", "cover"]
  },
  Known {
    language: "kaikai",
    marker: "kai.toml",
    also: [],
    summon: kaikai_summoner(),
    sources: [".kai"],
    tests: ["tests"],
    test_prefixes: [],
    test_suffixes: ["_test.kai"],
    ignored: ["_build", ".kai-cache", ".git", "dist"]
  },
  Known {
    language: "rust",
    marker: "Cargo.toml",
    also: [],
    summon: rust_summoner(),
    sources: [".rs"],
    tests: ["tests", "benches", "examples"],
    test_prefixes: [],
    test_suffixes: [],
    ignored: ["target", ".git"]
  },
  Known {
    language: "python",
    marker: "pyproject.toml",
    also: ["setup.py", "setup.cfg", "requirements.txt"],
    summon: python_summoner(),
    sources: [".py"],
    tests: ["tests", "test"],
    test_prefixes: ["test_", "conftest"],
    test_suffixes: ["_test.py"],
    ignored: [
      ".venv",
      "venv",
      "env",
      "__pycache__",
      ".tox",
      ".nox",
      ".git",
      "build",
      "dist",
      "node_modules",
      "site-packages",
      ".mypy_cache",
      ".pytest_cache",
      ".eggs"
    ]
  }
]

#[doc("""
The language of a project whose markers are these, or why it cannot be
told.

Two markers mean two possible answers and no way to choose between them,
which is a question for the owner rather than a coin to flip.
""")]
pub fn detect(markers: [String]) : Result[Known, Puzzle] = match found_in(markers) {
  [] -> Err(Undetected)
  [only] -> Ok(only)
  several -> Err(Ambiguous(several | (.language)))
}

fn found_in(markers: [String]) : [Known] =
  filter(catalogue(), k => contains(markers, k.marker) or any(k.also, m => contains(markers, m)))

#[doc("The language by the name it was given, for a project that says so itself.")]
pub fn named(language: String) : Result[Known, Puzzle] = match find(
  catalogue(),
  k => k.language == to_lower(language)
) {
  Some(k) -> Ok(k)
  None -> Err(Unknown(language))
}

#[doc("What to say about a puzzle, in a line the owner can act on.")]
pub fn explain(p: Puzzle) : String {
  case Unknown(name) -> "kalku has no kalku for `#{name}`; it knows #{languages()}"
  case Undetected ->
    "no language detected here: no #{markers()} to go by. Say which with `--lang`."
  case Ambiguous(names) ->
    "this looks like more than one project (#{join(names, ", ")}); say which with `--lang`"
}

fn languages() : String = join(catalogue() | (.language), ", ")

fn markers() : String = join(catalogue() | (.marker), " or ")

#[doc("Everything init would write, given the language and where the reni goes.")]
pub fn plan_for(known: Known, reni: String) : Plan = Plan {
  known: known,
  config: config_text(known, reni),
  summoner: summoner_text(known),
  dependency: dependency_for(known)
}

# The reni is named after the project so two projects do not share one,
# and it sits outside the project because a run's artefacts are not the
# project's — and because a kalku that copies its tree would copy the
# reni into itself.
#[doc("Where a project's reni goes, given a temporary directory and the project's name.")]
pub fn reni_for(under: String, leaf: String) : String = "#{trim_right_slash(under)}/kalku/#{leaf}"

fn trim_right_slash(path: String) : String = if ends_with(path, "/") {
  slice(path, 0, length(path) - 1)
} else {
  path
}

# Written rather than remembered: a run reads this, and so does whoever
# wonders what kalku is doing to their project.
fn config_text(known: Known, reni: String) : String = trim_left("""
# Written by `kalku init`. Every key is optional; these are the ones that
# make a run work without arguments.
language = "#{known.language}"

# The executable that speaks the kalku protocol for this language. It is
# a script in this project so that whatever its toolchain needs — a build
# path, an environment — is written down where it can be read.
summon = "#{SUMMONER_PATH}"

# Where a run's artefacts go. Left to kalku, which puts them under this
# machine's temporary directory, outside the project — a run's artefacts
# are not the project's, and a kalku that copies the tree would otherwise
# copy them into itself. On this machine that is:
#   #{reni}
# Set it here only to override that, and remember this file is shared:
# a path from one machine means nothing on another.

[run]
# One worker while a kalku has a single build path to give.
workers = 1

# A cast that runs longer than this is a `timeout`, not a slow test.
timeout_floor_ms = 60000
""")

# A shebang is only a shebang on the first line: the kernel reads the
# first two bytes, and a leading newline makes the file something no
# `execve` will start.
fn summoner_text(known: Known) : String = trim_left(known.summon)

# stdout carries the protocol, so everything a build prints goes to
# stderr and nothing reads stdin. `exec` puts the kalku itself at the end
# of the pipe, with no shell left to outlive it.
fn elixir_summoner() : String = """
#!/bin/sh
# kalku-summon-contract: 1
# Summons the Elixir kalku for this project. Written by `kalku init`.
#
# stdout carries the kalku protocol, so the build's output goes to stderr
# and nothing here reads stdin. The build path is inside the reni, which
# is what keeps a run out of this project's own `_build`.
set -eu

# The reni is the first argument, handed over by the run that is starting
# this kalku. It is not written into this file on purpose: this file goes
# into the repository, and a path baked in here is a path from whatever
# machine and whatever directory `kalku init` happened to run in.
RENI="${1:?this script is summoned by kalku, which passes the reni as the first argument}"

MIX_ENV=test
MIX_BUILD_PATH="$RENI/build"
export MIX_ENV MIX_BUILD_PATH

mkdir -p "$MIX_BUILD_PATH"

# The path with every symlink resolved, because mix writes relative
# symlinks into it — a dependency's `priv` — and counts the levels from
# the path it was given. On macOS a temporary directory lives under
# `/var`, which is itself a link to `private/var`, so a path counted
# there comes out one level short and the links dangle.
MIX_BUILD_PATH="$(cd "$MIX_BUILD_PATH" && pwd -P)"
export MIX_BUILD_PATH

# Both, and in this order. `deps.compile` leaves a path dependency for
# the project's own build, and `mix kalku.serve` would then compile it
# while the protocol is already running — mix announces what it compiles
# on stdout, and stdout is the protocol.
mix deps.compile >&2 </dev/null
mix compile >&2 </dev/null

exec mix kalku.serve "$@"
"""

fn kaikai_summoner() : String = """
#!/bin/sh
# kalku-summon-contract: 1
# Summons the kaikai kalku for this project. Written by `kalku init`.
#
# stdout carries the kalku protocol, so anything the toolchain prints on
# the way up goes to stderr.
set -eu

# Every summoning is handed the reni first. This kalku is told where the
# reni is through `hello` and keeps no build path of its own, so the
# argument is taken off here rather than passed on.
: "${1:?this script is summoned by kalku, which passes the reni as the first argument}"
shift

exec kalku-kaikai "$@"
"""

# The Python kalku runs in the project's own interpreter, because the tests
# need the project's own packages: the environment that is active, then the
# project's own virtual environment, then whatever `python3` is. It builds
# nothing on the way up.
fn python_summoner() : String = """
#!/bin/sh
# kalku-summon-contract: 1
# Summons the Python kalku for this project. Written by `kalku init`.
#
# stdout carries the kalku protocol. The kalku runs in the project's own
# interpreter, which is the one that has the project's packages and pytest:
# set KALKU_PYTHON to choose another.
set -eu

# Every summoning is handed the reni first. This kalku is told where the
# reni is through `hello`, so the argument is taken off here rather than
# passed on.
: "${1:?this script is summoned by kalku, which passes the reni as the first argument}"
shift

if [ -n "${KALKU_PYTHON:-}" ]; then
  PY="$KALKU_PYTHON"
elif [ -n "${VIRTUAL_ENV:-}" ] && [ -x "$VIRTUAL_ENV/bin/python" ]; then
  PY="$VIRTUAL_ENV/bin/python"
elif [ -x .venv/bin/python ]; then
  PY=.venv/bin/python
elif [ -x venv/bin/python ]; then
  PY=venv/bin/python
else
  PY=python3
fi

exec "$PY" "$(command -v kalku-python)" "$@"
"""

# The Rust kalku is told where the reni is through `hello` and builds
# nothing on the way up — `prepare` is where cargo runs, and its output
# goes to stderr there — so the argument is taken off and the kalku is
# started as it is.
fn rust_summoner() : String = """
#!/bin/sh
# kalku-summon-contract: 1
# Summons the Rust kalku for this project. Written by `kalku init`.
#
# stdout carries the kalku protocol. Nothing is built here: cargo runs
# inside `prepare`, with its output on stderr.
set -eu

# Every summoning is handed the reni first. This kalku is told where the
# reni is through `hello`, so the argument is taken off here rather than
# passed on.
: "${1:?this script is summoned by kalku, which passes the reni as the first argument}"
shift

exec kalku-rust "$@"
"""

# A kalku runs inside the project's own runtime, so the project has to
# depend on it. One line, from the package registry: a project that
# depends on a checkout of this repository depends on wherever that
# checkout happened to be.
fn dependency_for(known: Known) : Option[String] = if known.language == "elixir" {
  Some("{:kalku_elixir, \"~> 0.1\", only: :test, runtime: false}")
} else {
  None
}

#[doc("True when this project already depends on the kalku it needs.")]
pub fn depends_already(known: Known, build_file: String) : Bool =
  known.language != "elixir" or is_some(index_of(build_file, "kalku_elixir"))

#[doc("""
The build file with the dependency declared in it, or why it was left
alone.

The insertion goes just inside the list a project's `deps` returns, which
is the one shape every Mix project shares. A build file that does not
have that shape is somebody's own code doing something else with it, and
guessing at it would be worse than saying so: the error is what init
prints instead, with the line to add by hand.

Byte offsets throughout, because `index_of` answers in bytes and a build
file with an accent in a comment would otherwise be cut mid-character.
""")]
pub fn with_dependency(build_file: String, line: String) : Result[String, String] =
  if is_some(index_of(build_file, "kalku_elixir")) {
    Err("it already depends on kalku_elixir")
  } else {
    inserted_after_deps(build_file, line)
  }

fn inserted_after_deps(build_file: String, line: String) : Result[String, String] =
  match opening_of_deps(build_file) {
    None -> Err("no `deps do` with a list in it")
    Some(at) -> spliced(build_file, at, entry_for(build_file, at, line))
  }

# The `[` that opens the list, as a byte offset one past it.
fn opening_of_deps(build_file: String) : Option[Int] {
  let from = index_of(build_file, "deps do")!
  let rest = byte_slice(build_file, from, byte_length(build_file) - from)!
  let bracket = index_of(rest, "[")!
  Some(from + bracket + 1)
}

# The entry keeps the shape the list already had: one line stays one
# and a list that was empty takes neither, so what comes out reads as
# though a hand had written it and `mix format` has nothing to say.
fn entry_for(build_file: String, at: Int, line: String) : String {
  let after = byte_slice(build_file, at, byte_length(build_file) - at).unwrap_or("")
  if starts_with(trim_left(after), "]") {
    line
  } else if on_one_line(after) {
    "#{line}, "
  } else {
    "\n      #{line},"
  }
}

# True when the list closes before its first line ends.
fn on_one_line(after: String) : Bool = match (index_of(after, "]"), index_of(after, "\n")) {
  (Some(close), Some(newline)) -> close < newline
  (Some(_), None) -> true
  _ -> false
}

fn spliced(build_file: String, at: Int, entry: String) : Result[String, String] =
  match (byte_slice(build_file, 0, at), byte_slice(build_file, at, byte_length(build_file) - at)) {
    (Some(before), Some(after)) -> Ok(before ++ entry ++ after)
    _ -> Err("its `deps` list does not fall on a character boundary")
  }

#[doc("""
True when a path is one of the language's own source files: the right
extension, outside the suite, and outside what a build or version control
leaves. A test is the oracle, so a wekufe is never cast on one.
""")]
pub fn is_source_of(known: Known, path: String) : Bool =
  any(known.sources, e => ends_with(path, e))
    and (not is_suite_file(known, path))
    and (not is_ignored(known, path))

#[doc("""
True when a path belongs to the suite: under one of the language's test
directories, or named like a test. What a warm kalku holds a copy of, and so
what makes it stale when it changes.
""")]
pub fn is_test_of(known: Known, path: String) : Bool =
  is_suite_file(known, path) and (not is_ignored(known, path))

fn is_suite_file(known: Known, path: String) : Bool =
  any(segments(path), s => contains(known.tests, s))
    or any(known.test_suffixes, e => ends_with(path, e))
    or any(known.test_prefixes, p => starts_with(file_name(path), p))

# The last part of a path.
fn file_name(path: String) : String = match reverse(split(path, "/")) {
  [name, ..._] -> name
  [] -> path
}

fn is_ignored(known: Known, path: String) : Bool =
  any(segments(path), s => contains(known.ignored, s))

# The directory names of a path, not its file name: `lib/test_utils.ex` is
# not under a directory called `test`.
fn segments(path: String) : [String] = match split(path, "/") {
  [] -> []
  parts -> take(parts, length(parts) - 1)
}
