#[doc("""
What a run produced, and how it reads to a person.

Survivors come first, each with a file, a line, and the diff that made it:
a survivor is something a reader can act on. The score follows as context
and trend, never as the headline, and what a change suppressed is listed
where nobody can miss it.
""")]

import kalku.wire.enums
import kalku.wire.shapes
import kalku.core.score
import kalku.core.gate
import kalku.core.hint

# Enough test ids to recognise the guard that ran, before the list stops
# being something a reader reads.
const SHOWN_TESTS : Int = 3

# Enough of a toolchain's diagnostic to name the file and the error.
const SAID_LINES : Int = 6

#[doc("A wekufe that lived, and the tests that ran without noticing.")]
#[derive(Eq, Show)]
pub type Survivor = { site: Site, tests: [String] }

#[doc("Everything a run has to say.")]
#[derive(Eq, Show)]
pub type Report = {
  counts: Counts,
  survivors: [Survivor],
  on_changed_lines: Int,
  suppressions: SuppressionChanges,
  troubles: [Trouble],
  uncovered: [Site],
  blockers: [Blocker]
}

#[doc("A wekufe that produced nothing to score, and what the kalku said about it.")]
#[derive(Eq, Show)]
pub type Trouble = { wekufe: String, at: Option[Site], outcome: Outcome, said: Option[String] }

#[doc("The whole report as a person reads it: survivors, then the summary, then what was suppressed.")]
pub fn human(r: Report) : String = join(
  survivor_blocks(r)
    ++ uncovered_block(r)
    ++ trouble_blocks(r)
    ++ [summary_line(r)]
    ++ suppression_block(r)
    ++ blocker_block(r),
  "\n"
)

#[doc("Where a survivor lives, which spell made it, and in which declaration.")]
pub fn location(s: Survivor) : String = where_of(s.site)

#[doc("Where a site is, which spell made it, and in which declaration.")]
pub fn where_of(site: Site) : String {
  let at = "#{site.file}:#{site.span.start.line}"
  match site.enclosing {
    Some(decl) -> "#{at}  #{spell_name(site.spell)}  #{decl}"
    None -> "#{at}  #{spell_name(site.spell)}"
  }
}

#[doc("The change that made a wekufe, as a two-line diff; a deletion shows only what it removed.")]
pub fn diff_of(site: Site) : [String] {
  let removed = match site.original {
    Some(text) -> ["- #{text}"]
    None -> []
  }
  let added = if is_empty(site.replacement) { [] } else { ["+ #{site.replacement}"] }
  removed ++ added
}

#[doc("The one line that carries the score and everything reported beside it.")]
pub fn summary_line(r: Report) : String {
  let c = r.counts
  join(
    ["score #{score_text(c)}", "#{c.killed} killed", "#{c.survived} survived"]
      ++ aside("timeout", c.timeout)
      ++ aside("no coverage", c.no_coverage)
      ++ aside("compile error", c.compile_error)
      ++ aside("crashed", c.crashed)
      ++ aside("nondeterministic", c.nondeterministic)
      ++ equivalents(c.equivalent),
    " · "
  )
}

# ---- blocks ------------------------------------------------------------

fn survivor_blocks(r: Report) : [String] =
  if is_empty(r.survivors) { [] } else { flat_map(r.survivors, block) ++ [""] }

# The hint goes with the survivor rather than in a legend at the end: a
# reader acts on one hole at a time, and the sentence belongs where the
# hole is.
fn block(s: Survivor) : [String] =
  [location(s)]
    ++ (diff_of(s.site) | (line => "  #{line}"))
    ++ [covered_by(s), "  #{hint_for(s.site)}", ""]

fn covered_by(s: Survivor) : String =
  if is_empty(s.tests) { "  no test covers it" } else { "  covered by #{counted(s.tests)}" }

# Named while the list is short enough to read, counted past that. Not
# the first few of a long list: without coverage to select by, the order
# is the suite's, and the three it would name have nothing to do with the
# site — which reads as an attribution kalku did not make.
fn counted(tests: [String]) : String = if length(tests) <= SHOWN_TESTS {
  join(tests, ", ")
} else {
  "#{length(tests)} tests"
}

# A line no test reaches is a hole too, and a larger one than a wekufe
# that survived: there was nothing to notice it. It is named rather than
# counted, because the fix is the same — write a test — and the reader
# needs to know where.
fn uncovered_block(r: Report) : [String] = if is_empty(r.uncovered) {
  []
} else {
  ["no test reaches these:"] ++ (r.uncovered | (s => "  #{where_of(s)}")) ++ [""]
}

# An outcome that never enters the score still has to be actionable: a
# compile error or a crash whose reason nobody printed is a number that
# leaves a reader with nothing to fix.
fn trouble_blocks(r: Report) : [String] = if is_empty(r.troubles) {
  []
} else {
  ["what could not be measured:"] ++ flat_map(r.troubles, trouble_lines) ++ [""]
}

fn trouble_lines(t: Trouble) : [String] =
  ["  #{named_at(t)}  #{outcome_name(t.outcome)}"] ++ (said_by(t) | (line => "    #{line}"))

# A wekufe id is a hash; where it was cast is a file and a line, and only
# one of those is something a reader can open.
fn named_at(t: Trouble) : String = match t.at {
  Some(site) -> where_of(site)
  None -> t.wekufe
}

# A toolchain's diagnostic can run to hundreds of lines; the first few
# name the file and the error, which is what a reader needs.
fn said_by(t: Trouble) : [String] = match t.said {
  None -> []
  Some(text) -> take(filter(lines(text), l => not is_empty(trim_right(l))), SAID_LINES)
}

# Suppressions a change adds are as loud as the holes it leaves.
fn suppression_block(r: Report) : [String] {
  let added = r.suppressions.equivalent_added
  let wider = r.suppressions.exclude_added ++ r.suppressions.exclude_calls_added
  if added == 0 and is_empty(wider) {
    []
  } else {
    ["", "Suppressions added in this change:"]
      ++ (if added > 0 { ["  #{added} declared equivalent"] } else { [] })
      ++ (wider | (p => "  wider exclusion: #{p}"))
  }
}

fn blocker_block(r: Report) : [String] =
  if is_empty(r.blockers) { [] } else { [""] ++ (r.blockers | (b => "blocked: #{explain(b)}")) }

fn aside(name: String, n: Int) : [String] = if n == 0 { [] } else { ["#{n} #{name}"] }

fn equivalents(e: EquivalentCounts) : [String] {
  let total = e.bytecode + e.declared
  if total == 0 {
    []
  } else {
    ["#{total} equivalent (#{e.bytecode} bytecode, #{e.declared} declared)"]
  }
}
