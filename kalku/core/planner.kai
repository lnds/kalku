#[doc("""
What to cast, in what order, and how long to wait for each.

The planner decides three things and nothing else: which sites are in
reach, which of those have a test that would notice, and the order that
finds holes soonest — fewest covering tests first, then the cheapest, then
the id, so the same inputs always yield the same plan.

A kalku that cannot report coverage per test gets the whole suite for
every wekufe; nothing is silently skipped for lack of knowing.
""")]

import kalku.wire.enums
import kalku.wire.shapes
import kalku.core.changed_lines
import kalku.core.told

#[doc("How far a run reaches: the whole project, the lines a change touched, or listed files.")]
#[derive(Eq, Show)]
pub type Reach = Everything | Touched([FileChange]) | Listed([String])

#[doc("One wekufe to cast: the site, the tests that would notice, and its timeout.")]
#[derive(Eq, Show)]
pub type Wekufe = { site: Site, tests: [String], timeout_ms: Int, casts: Int }

#[doc("A site whose outcome is already known, and the outcome.")]
#[derive(Eq, Show)]
pub type Known = { site: Site, outcome: Outcome }

#[doc("What a run will do, and what it will not: every site lands in exactly one bucket.")]
#[derive(Eq, Show)]
pub type Plan = { to_cast: [Wekufe], no_coverage: [Site], suppressed: [Site], cached: [Known] }

#[doc("""
What the planner needs. `coverage` is absent when the kalku cannot report
it, and then every wekufe runs `all_tests`.
""")]
pub type Inputs = {
  sites: [Site],
  coverage: Option[[CoverageEntry]],
  all_tests: [String],
  durations: [(String, Int)],
  suppressed_ids: [String],
  exclude: [String],
  reach: Reach,
  timeout_floor_ms: Int
}

#[doc("""
Which tests the plan chose for each wekufe, by its site id.

Asked of the planner rather than read off a `Cast` elsewhere: a module
that also knows the protocol has a `Cast` of its own, and taking a field
off the wrong one is a panic rather than a type error (lnds/kaikai#2200).
""")]
pub fn tests_by_wekufe(p: Plan) : [(String, [String])] =
  p.to_cast | (c => (c.site.site_id, c.tests))

#[doc("A site whose module others depend on at compile time pays for their rebuild too.")]
pub const DEPENDENTS_FACTOR : Int = 2

#[doc("""
How many times a wekufe is cast before its outcome is believed.

Once, for a defect that is the same on every run. A concurrency wekufe
can die on one run and live on the next, and one cast of one of those is
not evidence of anything: it is cast until it agrees with itself, and
reported as `nondeterministic` when it will not.
""")]
pub fn agreements_for(spell: Spell) : Int = if concurrent(spell) { AGREEMENTS } else { 1 }

#[doc("True for the spells whose outcome depends on how things were scheduled.")]
pub fn concurrent(spell: Spell) : Bool = spell == Await or spell == Supervise

#[doc("How many agreeing casts a concurrency wekufe needs before its outcome is believed.")]
pub const AGREEMENTS : Int = 3

#[doc("How many times a test's own duration a wekufe may take before it is a timeout.")]
pub const TIMEOUT_FACTOR : Int = 3

#[doc("Plan a run. `cached` answers with a wekufe's outcome when an earlier run already cast it.")]
pub fn plan(inputs: Inputs, cached: (String) -> Option[Outcome]) : Plan {
  let reachable =
    filter(inputs.sites, s => in_reach(s, inputs.reach) and (not excluded(s, inputs.exclude)))
  let suppressed = filter(reachable, s => contains(inputs.suppressed_ids, s.site_id))
  let live = filter(reachable, s => not contains(inputs.suppressed_ids, s.site_id))
  let known = flat_map(live, s => remembered(s, cached))
  let fresh = filter(live, s => is_empty(remembered(s, cached)))
  let said = Said {
    told: told_by(inputs.coverage, inputs.durations),
    whole_ms: cost_of(told_by(None, inputs.durations), inputs.all_tests)
  }
  Plan {
    to_cast: order(flat_map(fresh, s => castable(s, inputs, said))),
    no_coverage: filter(fresh, s => is_empty(judging(s, inputs, said))),
    suppressed: suppressed,
    cached: known
  }
}

#[doc("The tests that execute a site's line, or the whole suite when coverage is unknown.")]
pub fn covering(site: Site, inputs: Inputs) : [String] = match inputs.coverage {
  None -> inputs.all_tests
  Some(entries) ->
    concat(entries |? (e => e.file == site.file and e.line == site.span.start.line) | (.tests))
}

#[doc("How long a wekufe may run: a multiple of what its tests cost, never below the floor.")]
pub fn timeout_for(site: Site, tests: [String], inputs: Inputs) : Int
  ensures result >= inputs.timeout_floor_ms
{
  let budget = TIMEOUT_FACTOR * sum(tests | (t => duration_of(t, inputs.durations)))
  let floor = max_int(budget, inputs.timeout_floor_ms)
  match site.reload {
    Dependents -> floor * DEPENDENTS_FACTOR
    ModuleOnly -> floor
  }
}

# ---- buckets -----------------------------------------------------------

# The baseline, indexed once for the whole plan, and what the whole suite
# costs: the same for every site it judges, so summed once.
type Said = { told: Told, whole_ms: Int }

fn judging(site: Site, inputs: Inputs, said: Said) : [String] =
  reaching(said.told, site.file, site.span.start.line).unwrap_or(inputs.all_tests)

fn budget_for(site: Site, tests: [String], inputs: Inputs, said: Said) : Int {
  let spent = if is_none(inputs.coverage) { said.whole_ms } else { cost_of(said.told, tests) }
  let floor = max_int(TIMEOUT_FACTOR * spent, inputs.timeout_floor_ms)
  match site.reload {
    Dependents -> floor * DEPENDENTS_FACTOR
    ModuleOnly -> floor
  }
}

fn castable(site: Site, inputs: Inputs, said: Said) : [Wekufe] {
  let tests = judging(site, inputs, said)
  if is_empty(tests) {
    []
  } else {
    [
      Wekufe {
        site: site,
        tests: tests,
        timeout_ms: budget_for(site, tests, inputs, said),
        casts: agreements_for(site.spell)
      }
    ]
  }
}

fn remembered(site: Site, cached: (String) -> Option[Outcome]) : [Known] = match cached(
  site.site_id
) {
  Some(o) -> [Known { site: site, outcome: o }]
  None -> []
}

# ---- reach -------------------------------------------------------------

fn in_reach(site: Site, reach: Reach) : Bool {
  case _, Everything -> true
  case s, Touched(changes) -> changed_lines.touches(changes, s.file, s.span.start.line)
  case s, Listed(files) -> contains(files, s.file)
}

fn excluded(site: Site, patterns: [String]) : Bool = any(patterns, p => matches(site.file, p))

# `lib/**/*.ex`, `lib/my_app_web/telemetry.ex`: `*` stands for any run of
# characters, and the pieces between the stars must appear in order.
fn matches(path: String, pattern: String) : Bool {
  let parts = split(pattern, "*")
  if length(parts) == 1 {
    path == pattern
  } else {
    consume(path, parts, true)
  }
}

fn consume(rest: String, parts: [String], first: Bool) : Bool = match parts {
  [] -> true
  [part] -> if is_empty(part) { true } else { ends_with(rest, part) }
  [part, ...more] -> match index_of(rest, part) {
    None -> false
    Some(at) ->
      if first and at != 0 {
        false
      } else {
        consume(drop_bytes(rest, at + length(part)), more, false)
      }
  }
}

# ---- order -------------------------------------------------------------

# Fewest covering tests first, then the cheapest, then the id: a hole shows
# up sooner, and the same inputs always give the same plan.
# How many tests judge each is counted once, not at every comparison.
fn order(casts: [Wekufe]) : [Wekufe] =
  sort_by(casts | (c => (length(c.tests), c)), compare_casts) | (.snd)

fn compare_casts(left: (Int, Wekufe), right: (Int, Wekufe)) : Int {
  let a = left.snd
  let b = right.snd
  let by_tests = left.fst - right.fst
  let by_budget = a.timeout_ms - b.timeout_ms
  if by_tests != 0 {
    by_tests
  } else if by_budget != 0 {
    by_budget
  } else {
    compare_text(a.site.site_id, b.site.site_id)
  }
}

fn compare_text(a: String, b: String) : Int = if a == b { 0 } else if a < b { 0 - 1 } else { 1 }

fn duration_of(test_id: String, durations: [(String, Int)]) : Int =
  match find(durations, d => d.fst == test_id) {
    Some(d) -> d.snd
    None -> 0
  }

fn max_int(a: Int, b: Int) : Int = if a > b { a } else { b }

fn drop_bytes(s: String, n: Int) : String = byte_slice(s, n, length(s) - n).unwrap_or("")
