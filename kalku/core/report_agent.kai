#[doc("""
The report an agent reads: one survivor per line, then a summary.

An agent works one hole at a time — read a survivor, write a test,
re-cast — so each line has to carry everything that hole needs: where it
is, what changed, which tests already run that line, the few lines
around it, and what to do. Anything missing is a file the agent has to
open, and opening files is what this format exists to avoid.

It is NDJSON and it is terse on purpose. No pretty-printing, and a field
kalku does not know is left out rather than sent as null: an agent that
reads `"enclosing": null` learns nothing it did not already know from
the field's absence, and pays tokens for it.
""")]

import encoding.json
import kalku.wire.enums
import kalku.wire.shapes
import kalku.core.verdict
import kalku.core.score
import kalku.core.recurring
import kalku.core.gate
import kalku.core.report
import kalku.core.hint

#[doc("How many lines of context travel with a survivor, on each side.")]
pub const CONTEXT_LINES : Int = 2

#[doc("""
How many of the tests that cover a survivor travel with it.

A line that a whole suite reaches is covered by every test in it, and with
a thousand tests that is tens of kilobytes per survivor: a run of twenty
did not fit in what a host accepts as one tool result. An agent needs a
few of them to see where the nearest tests are, and the count to know there
are more; the full list is what `kalku show` answers.
""")]
pub const COVERING_SHOWN : Int = 5

#[doc("""
The whole report as NDJSON: a line per survivor, then the summary.

`source` is asked for the lines of a file, so this module reads nothing
itself. A file it cannot answer for simply travels without context.
""")]
pub fn agent(r: Report, source: (String) -> [String]) : String = join(
  (ordered(r.survivors) | (s => survivor_line(s, source)))
    ++ (r.skipped | skipped_json)
    ++ (r.troubles | trouble_line)
    ++ [summary_line(r)],
  "\n"
)

#[doc("""
One file the kalku would not search, and why. An agent that is told a score
and not told which files it leaves out will think the file is clean.
""")]
pub fn skipped_json(s: Skipped) : String = json_encode(
  JObj(
    [
      ("skipped", JStr(s.file)),
      ("reason", JStr(s.reason)),
      ("message", JStr(s.message))
    ]
  )
)

#[doc("""
One wekufe that produced nothing to score, and why.

An agent that cannot tell a hole from a wekufe that never compiled will
write a test for the second, so the reason travels here too.
""")]
pub fn trouble_line(t: Trouble) : String = json_encode(
  JObj(
    [("wekufe", JStr(t.wekufe)), ("outcome", JStr(outcome_name(t.outcome)))] ++ said_field(t.said)
  )
)

fn said_field(said: Option[String]) : [(String, JsonValue)] = match said {
  Some(text) -> [("message", JStr(text))]
  None -> []
}

#[doc("Survivors in the order a reader expects: by file, then line, then spell.")]
pub fn ordered(survivors: [Survivor]) : [Survivor] =
  sort_by(survivors, (a, b) => compare_text(sort_key(a), sort_key(b)))

fn sort_key(s: Survivor) : String =
  "#{s.site.file}:#{padded(s.site.span.start.line)}:#{spell_name(s.site.spell)}"

fn compare_text(a: String, b: String) : Int = if a == b {
  0
} else if a < b {
  0 - 1
} else {
  1
}

#[doc("One survivor, as the object an agent acts on.")]
pub fn survivor_line(s: Survivor, source: (String) -> [String]) : String = json_encode(
  JObj(
    [
      ("wekufe", JStr(s.site.site_id)),
      ("file", JStr(s.site.file)),
      ("line", JNum(s.site.span.start.line)),
      ("spell", JStr(spell_name(s.site.spell)))
    ]
      ++ optional("enclosing", s.site.enclosing)
      ++ optional("original", s.site.original)
      ++ [("replacement", JStr(s.site.replacement))]
      ++ strings("context", context(s.site, source))
      ++ strings("covering_tests", take(s.tests, COVERING_SHOWN))
      ++ counted("covering_count", length(s.tests))
      ++ [("hint", JStr(hint_for(s.site)))]
  )
)

#[doc("""
The lines around a site, with the indentation they share taken off.

Shared indentation is noise an agent pays for by the token, and every
line of a deeply nested clause carries the same amount of it.
""")]
pub fn context(site: Site, source: (String) -> [String]) : [String] {
  let lines = source(site.file)
  let at = site.span.start.line
  let from = max_of(1, at - CONTEXT_LINES)
  let to = min_of(length(lines), at + CONTEXT_LINES)
  if is_empty(lines) or at > length(lines) { [] } else { undent(window(lines, from, to)) }
}

# ---- the summary --------------------------------------------------------

fn summary_line(r: Report) : String = json_encode(
  JObj(
    [
      ("summary", JBool(true)),
      ("counts", counts_of(r.counts)),
      ("survivors_on_changed_lines", JNum(r.on_changed_lines))
    ]
      ++ score_field(r.counts)
      ++ repeated_field(r)
      ++ suppression_field(r.suppressions)
      ++ [("exit", JNum(exit_code(r.blockers)))]
  )
)

# A pattern travels only when there is one, and as a fact rather than as
# advice: the agent is told that five survivors share a call, and decides.
# It must not write the line itself — `exclude_calls` silences an operator
# over a whole run, which is a bigger claim than any single equivalent and
# belongs to whoever owns the project.
fn repeated_field(r: Report) : [(String, JsonValue)] {
  let groups = repeated_calls(r.survivors | (.site), WORTH_SAYING)
  if is_empty(groups) {
    []
  } else {
    [
      (
        "repeated_calls",
        JArr(groups | (g => JObj([("call", JStr(g.call)), ("survivors", JNum(g.count))])))
      )
    ]
  }
}

# A score that does not exist is absent, not zero: nothing could have
# been killed, and zero would read as everything survived.
fn score_field(c: Counts) : [(String, JsonValue)] = match score(c) {
  Some(s) -> [("score", JReal(s))]
  None -> []
}

fn counts_of(c: Counts) : JsonValue = JObj([
  ("killed", JNum(c.killed)),
  ("survived", JNum(c.survived)),
  ("timeout", JNum(c.timeout)),
  ("no_coverage", JNum(c.no_coverage)),
  ("compile_error", JNum(c.compile_error)),
  ("crashed", JNum(c.crashed)),
  ("equivalent", JNum(c.equivalent.bytecode + c.equivalent.declared))
])

# Suppressions travel only when there are some: a change that hid
# nothing should cost an agent no tokens to learn that.
fn suppression_field(s: SuppressionChanges) : [(String, JsonValue)] =
  if s.equivalent_added == 0 and is_empty(s.exclude_added) and is_empty(s.exclude_calls_added) {
    []
  } else {
    [
      (
        "suppression_changes",
        JObj(
          [("equivalent_added", JNum(s.equivalent_added))]
            ++ strings("exclude_added", s.exclude_added)
            ++ strings("exclude_calls_added", s.exclude_calls_added)
        )
      )
    ]
  }

# ---- pieces -------------------------------------------------------------

fn optional(name: String, value: Option[String]) : [(String, JsonValue)] = match value {
  Some(text) -> [(name, JStr(text))]
  None -> []
}

fn counted(name: String, n: Int) : [(String, JsonValue)] =
  if n > 0 { [(name, JNum(n))] } else { [] }

fn strings(name: String, values: [String]) : [(String, JsonValue)] =
  if is_empty(values) { [] } else { [(name, JArr(values | (v => JStr(v))))] }

fn window(lines: [String], from: Int, to: Int) : [String] =
  enumerate(lines) |? (l => l.fst + 1 >= from and l.fst + 1 <= to) | (.snd)

fn undent(lines: [String]) : [String] {
  let filled = filter(lines, l => not is_blank(l))
  let shared = foldl(filled, 1000, (least, l) => min_of(least, indent_of(l)))
  lines | (l => undented(l, shared))
}

# The indent is counted in bytes, so it is dropped in bytes: a line of
# source with an accent in it would otherwise lose characters instead of
# leading blanks.
fn undented(line: String, shared: Int) : String = if length(line) >= shared {
  byte_slice(line, shared, length(line) - shared).unwrap_or(trim_left(line))
} else {
  trim_left(line)
}

fn indent_of(line: String) : Int = length(line) - length(trim_left(line))

fn min_of(a: Int, b: Int) : Int = if a < b { a } else { b }

fn max_of(a: Int, b: Int) : Int = if a > b { a } else { b }

# Sorting by text, so a line number has to sort as a number would.
fn padded(n: Int) : String = pad_left("#{n}", 9, '0')
