#[doc("""
Carrying out what `init` decided: reading a directory, asking, writing.

Kept apart from `main` so the decisions stay in `kalku.core.setting_up`,
where they are tested, and the file-touching stays in one place, where it
can be read in full before anyone runs it against their project.

Nothing here writes over something that is already there: a project that
has been set up before is told so, and left as it is. The one file that
belongs to the owner rather than to kalku is the build file, and it is
changed only by adding the line that makes the kalku reachable — after
saying so, and never when its shape is not the one every project shares.
""")]

import fs.file
import fs.dir
import os.process as proc
import kalku.core.setting_up

#[doc("Set a project up, asking before anything is written.")]
pub fn settle(
  root: String,
  language: Option[String],
  assume_yes: Bool
) : Int / Stdin + Stdout + Stderr + File + Process + Env {
  match which_language(root, language) {
    Err(p) -> {
      Stderr.eprint("kalku: #{explain(p)}")
      2
    }
    Ok(known) -> {
      let plan = plan_for(known, reni_here(root))
      let wanted = dependency_wanted(root, plan)
      Stdout.print(intent(root, plan, wanted))
      if assume_yes or agreed() { write_it(root, plan, wanted) } else { declined() }
    }
  }
}

# Being told beats guessing, and guessing beats asking: `--lang` wins, a
# project's own markers answer for it, and only a project that says
# nothing is a question.
fn which_language(root: String, language: Option[String]) : Result[Known, Puzzle] / File =
  match language {
    Some(name) -> named(name)
    None -> detect(dir.list_dir(root))
  }

#[doc("""
Where this project's reni goes on this machine.

Derived rather than written down: a reni lives under the temporary
directory, which is one machine's answer and not a project's. `init`
writes a `.kalku.toml` that is shared through the repository, and a path
from the machine that ran it means nothing on anyone else's — worse, it
means something wrong on the machine it came from once the directory is
swept.
""")]
pub fn reni_here(root: String) : String / Env = reni_for(temp_dir(), named_after(root))

# The reni is named after the project, and a project named `.` is
# whatever directory one is standing in — which the shell knows and this
# process can only ask it for.
# Written as comparisons rather than as a `match` on `leaf`: an empty-string
# pattern matches a value that is not empty when what it matches came from
# a recursive function, which silently took the wrong branch here
# (lnds/kaikai#2224).
fn named_after(root: String) : String / Env {
  let leaf = last_segment(root)
  if is_empty(leaf) or leaf == "." { standing_in() } else { leaf }
}

fn standing_in() : String / Env = match Env.get("PWD") {
  Some(dir) -> {
    let leaf = last_segment(dir)
    if is_empty(leaf) { "project" } else { leaf }
  }
  None -> "project"
}

# `path.basename` would do, but importing that module brings a `join` of
# its own that shadows the list one this file also uses.
fn last_segment(p: String) : String {
  let cleaned = if ends_with(p, "/") { slice(p, 0, length(p) - 1) } else { p }
  match index_of(cleaned, "/") {
    None -> cleaned
    Some(i) -> last_segment(slice(cleaned, i + 1, length(cleaned)))
  }
}

fn temp_dir() : String / Env = Env.get("TMPDIR").unwrap_or("/tmp")

# ---- asking -------------------------------------------------------------

fn intent(root: String, plan: Plan, wanted: Option[String]) : String = join(
  [
    "kalku: this looks like #{plan.known.language} (#{plan.known.marker} is here)",
    "",
    "It will write:",
    "  #{root}/#{CONFIG_PATH}     how a run is set up",
    "  #{root}/#{SUMMONER_PATH}   how this project's kalku is summoned"
  ]
    ++ also_the_build_file(plan, wanted)
    ++ [""],
  "\n"
)

# The build file is named in the question, not after the answer: a kalku
# runs inside the project's runtime, so this line is what makes it
# reachable at all, and it is still the owner's file.
fn also_the_build_file(plan: Plan, wanted: Option[String]) : [String] = match wanted {
  None -> []
  Some(line) -> [
    "  #{plan.known.marker}            this line in `deps`, so the kalku can be summoned:",
    "                        #{line}"
  ]
}

fn agreed() : Bool / Stdin + Stdout {
  Stdout.print("Write them? [y/N] ")
  match Stdin.read_line() {
    None -> false
    Some(answer) -> contains(["y", "yes"], to_lower(trim(answer)))
  }
}

# Nothing written and why, because the common way to reach here is a
# script or an agent with no terminal to answer from: the prompt is read
# as end of input, which is not a no so much as a nobody.
fn declined() : Int / Stdout {
  Stdout.print("kalku: nothing written. Pass `-y` to write them without being asked.")
  0
}

# ---- writing ------------------------------------------------------------

fn write_it(
  root: String,
  plan: Plan,
  wanted: Option[String]
) : Int / Stdout + Stderr + File + Process {
  let config = "#{root}/#{CONFIG_PATH}"
  let summoner = "#{root}/#{SUMMONER_PATH}"
  keep(config, plan.config)
  let _ = dir.create_dir("#{root}/.kalku")
  refresh(summoner, plan.summoner)
  make_runnable(summoner)
  declare_dependency(root, plan, wanted)
  0
}

# The summoning is the one file `init` will write over, and only when the
# one that is there was written against a contract this kalku no longer
# speaks. Keeping it would mean a project set up a year ago never receives
# a fix to the summoning, which is how a fixed bug goes on being reported.
fn refresh(path: String, content: String) : Unit / Stdout + File =
  if not file.exists(path) {
    put(path, content, "wrote  ")
  } else if summon_is_current(file.read(path)) {
    told("kept   ", "#{path} (already there)")
  } else {
    put(path, content, "renewed")
  }

# A project already set up is left alone: whoever edited these files meant
# it, and overwriting them is not something an `init` should do twice.
fn keep(path: String, content: String) : Unit / Stdout + File = if file.exists(path) {
  told("kept   ", "#{path} (already there)")
} else {
  put(path, content, "wrote  ")
}

fn put(path: String, content: String, verb: String) : Unit / Stdout + File {
  file.write(path, content)
  told(verb, path)
}

fn told(verb: String, what: String) : Unit / Stdout = Stdout.print("  #{verb} #{what}")

# A summoner that is not executable is a worker that will not start, and
# the error it gives is about a pipe rather than about a mode bit.
fn make_runnable(path: String) : Unit / Process {
  let _ = proc.start_piped("/bin/chmod", ["+x", path])
  ()
}

# The line this project still needs, if it needs one: a language whose
# kalku is a dependency, and a build file that does not name it yet.
fn dependency_wanted(root: String, plan: Plan) : Option[String] / File = match plan.dependency {
  None -> None
  Some(line) -> if depends_already(plan.known, build_file_of(root, plan.known)) {
    None
  } else {
    Some(line)
  }
}

fn declare_dependency(
  root: String,
  plan: Plan,
  wanted: Option[String]
) : Unit / Stdout + File = match wanted {
  None -> Stdout.print("\nkalku: ready. Try `kalku run <file>`.")
  Some(line) -> {
    let path = "#{root}/#{plan.known.marker}"
    match with_dependency(build_file_of(root, plan.known), line) {
      Ok(declared) -> {
        file.write(path, declared)
        Stdout.print("  wrote   #{path} (the dependency, in `deps`)")
        Stdout.print("\nkalku: ready. Run `mix deps.get`, then `kalku run <file>`.")
      }
      Err(why) -> by_hand(plan, line, why)
    }
  }
}

# A build file kalku does not recognise is somebody's own code, and
# editing it on a guess is worse than asking for a line: the reason is
# printed too, so the ask does not look like a whim.
fn by_hand(plan: Plan, line: String, why: String) : Unit / Stdout = Stdout.print(
  join(
    [
      "",
      "One thing left, in #{plan.known.marker} — kalku left it alone because",
      "#{why}. This kalku runs inside your project's runtime, so your",
      "project has to depend on it. Add to `deps`:",
      "",
      "    #{line}",
      "",
      "Then `mix deps.get`, and `kalku run <file>`."
    ],
    "\n"
  )
)

fn build_file_of(root: String, known: Known) : String / File {
  let path = "#{root}/#{known.marker}"
  if file.exists(path) { file.read(path) } else { "" }
}
