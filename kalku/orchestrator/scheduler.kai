#[doc("""
Casting a plan across a pool: hand each wekufe to a kalku that is free,
collect what comes back, and hold every kalku to its deadline.

The scheduler owns the mailbox and is the only fiber that decides
anything; the reader actors only speak when spoken to by the child. What
to do about a slow or broken kalku is decided in `escalation`, so the
loop here is plumbing rather than judgement.

Every wekufe dispatched is accounted for: a kalku that dies takes its
outcome with it as `crashed`, and one that runs long ends as `timeout`.
Nothing is silently dropped, because a hole nobody hears about is worse
than a hole with a name.
""")]

import actor
import time
import kalku.wire.enums
import kalku.wire.shapes
import kalku.wire.kalku_msg
import kalku.core.planner
import kalku.orchestrator.kalku_proc
import kalku.orchestrator.pool
import kalku.orchestrator.escalation
import kalku.orchestrator.ward
import kalku.orchestrator.telling

#[doc("What one wekufe came to.")]
#[derive(Eq, Show)]
pub type Verdict = {
  wekufe: String,
  outcome: Outcome,
  tests: [String],
  said: Option[String]
}

#[doc("""
What a run produced: every wekufe that was dispatched, and why the run
stopped early if it did.

`failure` is for the run itself — no kalku left, or a kalku this side
cannot speak to. The verdicts collected before that are still reported:
they were measured.
""")]
#[derive(Eq, Show)]
pub type Casting = { verdicts: [Verdict], failure: Option[String], cancelled: Bool }

#[doc("How long a kalku is given to answer `abort` or `reset` before it is killed.")]
pub const GRACE_MS : Int = 2000

#[doc("""
Cast a plan and return what every wekufe came to.

Returns when the plan is done, when the run is cancelled, or when no
kalku is left to carry it.
""")]
pub fn cast_all(
  spec: PoolSpec,
  casts: [Wekufe]
) : Casting / Process + Spawn + Clock + Actor[OrchMsg] + Telling =
  warded(() => run_plan(spec, casts))

#[doc("""
Summon a pool and keep it, for a caller that will cast more than once.

The ward that outlives the run is the caller's: whoever opens a pool this
way is promising to be inside a `warded` scope for as long as the kalku
live, which is what keeps `kill -9` on the server from leaving children
behind.
""")]
pub fn open_pool(
  spec: PoolSpec
) : [Slot] / Process + Spawn + Clock + Actor[OrchMsg] + Ward = fill(spec)

#[doc("""
Cast over a pool that is already alive, and hand it back.

The kalku are not dismissed at the end: they are the point. What the
caller gets back is what the run left them as, so the next run can see
which ones were lost.
""")]
pub fn cast_over(
  spec: PoolSpec,
  slots: [Slot],
  casts: [Wekufe],
  from_id: Int
) : (Casting, [Slot], Int) / Process + Spawn + Clock + Actor[OrchMsg] + Ward + Telling {
  let done = turn(Run {
    spec: spec,
    slots: slots,
    queue: casts,
    verdicts: [],
    next_id: from_id,
    failure: no_kalku(slots, casts),
    cancelled: false
  })
  (
    Casting { verdicts: done.verdicts, failure: done.failure, cancelled: done.cancelled },
    done.slots,
    done.next_id
  )
}

fn run_plan(
  spec: PoolSpec,
  casts: [Wekufe]
) : Casting / Process + Spawn + Clock + Actor[OrchMsg] + Ward + Telling {
  let slots = fill(spec)
  let done = turn(Run {
    spec: spec,
    slots: slots,
    queue: casts,
    verdicts: [],
    next_id: 1,
    failure: no_kalku(slots, casts),
    cancelled: false
  })
  dismiss_all(done.slots, 0)
  banish_all(done.slots)
  let heard = hear_last_words(done.slots)
  Casting {
    verdicts: done.verdicts,
    failure: said_in_full(done, heard),
    cancelled: done.cancelled
  }
}

#[doc("How long the run waits for its readers to notice that their kalku is gone.")]
pub const LAST_WORDS_MS : Int = 2000

# A reader outlives the kalku it was reading: killing the child makes the
# read fail, and the reader says so once before it ends. The run waits for
# that word from each of them, so it leaves no fiber talking to a mailbox
# that is no longer there — and keeps what they were still carrying, which
# is what a kalku wrote about itself on the way down.
fn hear_last_words(slots: [Slot]) : [Slot] / Clock + Actor[OrchMsg] {
  let heard = wait_out(slots, living(slots), deadline_in(millis(LAST_WORDS_MS)))
  if any(heard, still_silent) {
    linger(heard, deadline_in(millis(LINGER_MS)))
  } else {
    heard
  }
}

#[doc("How long a run waits on a reader whose kalku it has already given up on.")]
pub const LINGER_MS : Int = 200

# A kalku that was given up on has no life left to wait for, and its last
# words may still be on their way: its reader wrote them as the kalku
# died, and by then nothing above was waiting. Paid for only when a slot
# was abandoned with nothing to show for it.
fn still_silent(s: Slot) : Bool = is_gone(s) and is_none(own_words(s))

fn linger(slots: [Slot], until: Instant) : [Slot] / Clock + Actor[OrchMsg] =
  if not instant_lt(monotonic(), until) {
    slots
  } else {
    match receive_timeout(elapsed_since(monotonic(), until)) {
      None -> slots
      Some(Cancel) -> linger(slots, until)
      Some(Wire(life, what)) -> linger(kept(slots, life, what), until)
    }
  }

fn wait_out(slots: [Slot], lives: [Life], until: Instant) : [Slot] / Clock + Actor[OrchMsg] =
  if is_empty(lives) or (not instant_lt(monotonic(), until)) {
    slots
  } else {
    match receive_timeout(elapsed_since(monotonic(), until)) {
      None -> slots
      Some(Cancel) -> wait_out(slots, lives, until)
      Some(Wire(life, what)) -> wait_out(
        kept(slots, life, what),
        if spoke_last(what) { filter(lives, l => l != life) } else { lives },
        until
      )
    }
  }

# A chunk of stderr that arrives while the run is winding down belongs to
# the slot that wrote it, wherever its epitaph is written later.
fn kept(slots: [Slot], life: Life, what: FromKalku) : [Slot] = match what {
  Wrote(chunk) -> match wrote_it(slots, life) {
    Some(slot) -> put(slots, noted(slot, chunk))
    None -> slots
  }
  _ -> slots
}

# The slot living that life, or the abandoned one that worker left
# behind. A worker given up on is never summoned again, so there is no
# later incarnation these words could belong to instead — and dropping
# them is how a run ends up quoting a silence that was not one.
fn wrote_it(slots: [Slot], life: Life) : Option[Slot] = match slot_living(slots, life) {
  Some(slot) -> Some(slot)
  None -> find(slots, s => s.worker == life.worker and is_gone(s))
}

# Composed here rather than where the slot was given up on: what a kalku
# wrote about itself arrives after its death is noticed, so a sentence
# written at that moment would quote a silence that was not one.
fn said_in_full(done: Run, heard: [Slot]) : Option[String] =
  if (not is_empty(heard)) and all_gone(heard) {
    Some(join(epitaphs(heard), "; "))
  } else {
    done.failure
  }

fn spoke_last(what: FromKalku) : Bool = match what {
  Closed -> true
  Unreadable(_) -> true
  _ -> false
}

fn living(slots: [Slot]) : [Life] =
  flat_map(
    slots,
    s => match s.kalku {
      Some(k) -> [k.life]
      None -> []
    }
  )

# A run with nothing to cast with does not wait to find that out: with no
# slot to answer and no deadline to expire, waiting would be forever.
fn no_kalku(slots: [Slot], casts: [Wekufe]) : Option[String] =
  if is_empty(casts) or (not all_gone(slots)) {
    None
  } else {
    Some(no_kalku_reason(slots))
  }

fn no_kalku_reason(slots: [Slot]) : String = if is_empty(slots) {
  "a run needs at least one kalku, and this pool was asked for none"
} else {
  join(epitaphs(slots), "; ")
}

# ---- the run ------------------------------------------------------------

type Run = {
  spec: PoolSpec,
  slots: [Slot],
  queue: [Wekufe],
  verdicts: [Verdict],
  next_id: Int,
  failure: Option[String],
  cancelled: Bool
}

fn turn(run: Run) : Run / Process + Spawn + Clock + Actor[OrchMsg] + Ward + Telling {
  let busy = dispatch(run)
  if over(busy) { busy } else { turn(listen(busy)) }
}

# A run is over when nothing is left to cast and nobody is still working,
# or when there is no kalku left to cast with.
fn over(run: Run) : Bool =
  is_some(run.failure) or waiting_on(run.slots) == 0 and (run.cancelled or is_empty(run.queue))

fn listen(run: Run) : Run / Process + Spawn + Clock + Actor[OrchMsg] + Ward + Telling =
  match receive_timeout(patience(run)) {
    None -> expire(run)
    Some(Cancel) -> Run { ...run, cancelled: true, queue: [] }
    Some(Wire(life, what)) -> match slot_living(run.slots, life) {
      None -> run
      Some(slot) -> heard_from(run, slot, what)
    }
  }

# ---- dispatch -----------------------------------------------------------

fn dispatch(run: Run) : Run / Process + Clock + Telling = match (run.queue, idle(run.slots)) {
  ([], _) -> run
  (_, []) -> run
  ([c, ...rest], [slot, ..._]) -> dispatch(hand(Run { ...run, queue: rest }, slot, c))
}

fn hand(run: Run, slot: Slot, c: Wekufe) : Run / Process + Clock + Telling {
  let id = run.next_id
  tell(slot, id, Cast(CastMsg { wekufe: c.site.site_id, site: c.site, tests: c.tests }))
  Telling.tell_of(
    "worker #{slot.worker} casts #{c.site.file}:#{c.site.span.start.line} #{spell_name(c.site.spell)} against #{length(c.tests)} test(s)"
  )
  let job = Job {
    id: id,
    wekufe: c.site.site_id,
    tests: c.tests,
    deadline: deadline_in(millis(c.timeout_ms)),
    awaiting: AwaitingCast
  }
  Run { ...run, slots: put(run.slots, Slot { ...slot, doing: Working(job) }), next_id: id + 1 }
}

# ---- what a kalku said --------------------------------------------------

fn heard_from(run: Run, slot: Slot, what: FromKalku) : Run / Process + Spawn + Clock + Actor[
  OrchMsg
] + Ward + Telling {
  case run, slot, Said(line) -> match heard(line) {
    Ok(m) -> said(run, slot, m.body)
    Err(e) -> react(run, slot, on_noise(awaiting_of(slot), kind_name(e.kind)))
  }
  case run, slot, Wrote(chunk) -> Run { ...run, slots: put(run.slots, noted(slot, chunk)) }
  case run, slot, Closed -> react(run, slot, on_death(awaiting_of(slot), "closed its pipe"))
  case run, slot, Unreadable(why) -> react(run, slot, on_death(awaiting_of(slot), why))
}

fn said(
  run: Run,
  slot: Slot,
  reply: KalkuReply
) : Run / Process + Spawn + Clock + Actor[OrchMsg] + Ward + Telling =
  match reply {
    Ready(m) -> greeted(run, slot, m)
    Prepared(_) -> ready_for_work(run, slot)
    other -> react(run, slot, on_reply(other, slot.caps))
  }

# A kalku whose protocol this side cannot speak ends the run rather than
# the kalku: a second one would say the same thing.
fn greeted(run: Run, slot: Slot, m: ReadyMsg) : Run / Process + Clock = match ready_refused(m) {
  Some(why) -> Run { ...run, failure: Some("worker #{slot.worker} #{why}") }
  None -> prepare_it(run, Slot { ...slot, caps: m.capabilities })
}

# A greeting is not readiness. Every kalku compiles the project into its
# own workspace before it is given a wekufe: one that was handed a cast
# straight after `ready` answers that it was never prepared, and a kalku
# that answers instead of working is a kalku that waits out its deadline.
fn prepare_it(run: Run, slot: Slot) : Run / Process + Clock {
  tell(slot, prepare_id(slot.worker), Prepare)
  Run {
    ...run,
    slots: put(run.slots, Slot { ...slot, doing: Readying(deadline_in(millis(READYING_MS))) })
  }
}

fn prepare_id(worker: Int) : Int = 0 - (worker + 1000)

fn ready_for_work(run: Run, slot: Slot) : Run =
  Run { ...run, slots: put(run.slots, Slot { ...slot, doing: Idle }) }

# ---- deadlines ----------------------------------------------------------

fn expire(run: Run) : Run / Process + Spawn + Clock + Actor[OrchMsg] + Ward + Telling =
  match overdue(run) {
    None -> run
    Some(slot) -> expire(react(run, slot, due_reaction(slot)))
  }

fn due_reaction(slot: Slot) : Reaction = on_deadline(awaiting_of(slot), slot.caps)

fn overdue(run: Run) : Option[Slot] / Clock {
  let now = monotonic()
  find(
    run.slots,
    s => match due_at(s) {
      Some(at) -> not instant_lt(now, at)
      None -> false
    }
  )
}

fn due_at(s: Slot) : Option[Instant] = match s.doing {
  Working(job) -> Some(job.deadline)
  Greeting(at) -> Some(at)
  Readying(at) -> Some(at)
  _ -> None
}

# How long to wait before looking at the clock again: until the nearest
# deadline, or a blink when something is already overdue.
fn patience(run: Run) : Duration / Clock {
  let now = monotonic()
  let waits = flat_map(
    run.slots,
    s => match due_at(s) {
      Some(at) -> if instant_lt(now, at) { [elapsed_since(now, at)] } else { [millis(0)] }
      None -> []
    }
  )
  foldl(waits, seconds(1), (shortest, d) => if duration_lt(d, shortest) { d } else { shortest })
}

# ---- carrying a decision out --------------------------------------------

fn react(
  run: Run,
  slot: Slot,
  r: Reaction
) : Run / Process + Spawn + Clock + Actor[OrchMsg] + Ward + Telling {
  let recorded = record(run, slot, r)
  match r.next {
    Keep -> recorded
    Free -> Run { ...recorded, slots: put(recorded.slots, Slot { ...slot, doing: Idle }) }
    AskAbort -> chase(recorded, slot, Abort(AbortMsg { cast: job_id(slot) }), AwaitingAbort)
    AskReset -> chase(recorded, slot, Reset, AwaitingReset)
    Recycle(why) -> recycle(recorded, slot, why)
  }
}

fn record(run: Run, slot: Slot, r: Reaction) : Run / Telling = match (r.outcome, slot.doing) {
  (Some(o), Working(job)) -> {
    Telling.tell_of(
      "worker #{slot.worker}: #{job.wekufe} #{outcome_name(o)} (#{length(run.verdicts) + 1} of #{cast_count(run)})"
    )
    Run {
      ...run,
      verdicts: run.verdicts
        ++ [
          Verdict { wekufe: job.wekufe, outcome: o, tests: job.tests, said: r.said }
        ]
    }
  }
  _ -> run
}

# What the run set out to cast: what is done, what is in flight, and what
# is still queued.
fn cast_count(run: Run) : Int = length(run.verdicts) + waiting_on(run.slots) + length(run.queue)

# Chasing keeps the job so the wekufe still has a name if the chase fails.
fn chase(run: Run, slot: Slot, request: KalkuRequest, awaiting: Awaiting) : Run / Process + Clock {
  tell(slot, next_chase_id(run), request)
  let waiting = match slot.doing {
    Working(job) ->
      Working(Job { ...job, deadline: deadline_in(millis(GRACE_MS)), awaiting: awaiting })
    other -> other
  }
  Run { ...run, slots: put(run.slots, Slot { ...slot, doing: waiting }), next_id: run.next_id + 1 }
}

fn recycle(
  run: Run,
  slot: Slot,
  why: String
) : Run / Process + Spawn + Clock + Actor[OrchMsg] + Ward + Telling {
  banish(slot)
  let fresh = refill(run.spec, slot, why)
  let slots = put(run.slots, fresh)
  if all_gone(slots) {
    Run { ...run, slots: slots, failure: Some(join(epitaphs(slots), "; ")) }
  } else {
    Run { ...run, slots: slots }
  }
}

# ---- reading a slot -----------------------------------------------------

fn awaiting_of(slot: Slot) : Awaiting = match slot.doing {
  Working(job) -> job.awaiting
  Greeting(_) -> AwaitingReady
  Readying(_) -> AwaitingReady
  _ -> AwaitingReset
}

fn job_id(slot: Slot) : Int = match slot.doing {
  Working(job) -> job.id
  _ -> 0
}

fn next_chase_id(run: Run) : Int = run.next_id

fn waiting_on(slots: [Slot]) : Int = length(filter(slots, s => is_some(due_at(s))))
