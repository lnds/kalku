#[doc("""
A run, end to end: ask a kalku what can be broken, break it, and say
what nobody noticed.

This is the path that makes the project's own claim true — kalku
measuring kalku — by putting the pieces that were built apart to work
together: a kalku for the language, the planner to decide what is worth
casting, the scheduler to cast it under deadlines, and the report to say
what survived.

Discovery talks to one kalku, because `prepare` and `baseline` are asked
once per project. Casting then hands the plan to a pool, which is where
the parallelism belongs.
""")]

import actor
import fs.file
import time
import kalku.wire.enums
import kalku.wire.shapes
import kalku.wire.kalku_msg
import kalku.core.verdict
import kalku.core.skipping
import kalku.core.planner
import kalku.core.equivalent
import kalku.core.costing
import kalku.core.gate
import kalku.core.changed_lines
import kalku.core.report
import kalku.core.remembering
import kalku.orchestrator.kalku_proc
import kalku.orchestrator.attending
import kalku.orchestrator.pool
import kalku.orchestrator.scheduler
import kalku.orchestrator.telling
import kalku.orchestrator.interrupting

#[doc("What to measure, and with what.")]
#[derive(Eq, Show)]
pub type Asking = {
  spec: PoolSpec,
  files: [String],
  only: [String],
  spells: [Spell],
  exclude_calls: [String],
  exclude: [String],
  equivalents: [equivalent.Entry],
  limit: Int,
  timeout_floor_ms: Int,
  touched: Option[[FileChange]]
}

# `durations` holds pairs, which have no `Eq`, so this record derives
# nothing.
#[doc("What the first kalku answered: what can be broken, and what judges it.")]
pub type Known = {
  sites: [Site],
  tests: [String],
  coverage: Option[[CoverageEntry]],
  durations: [(String, Int)],
  skipped: [Skipped]
}

#[doc("What a run found, or why it could not look.")]
#[derive(Eq, Show)]
pub type Found = { report: Option[Report], failure: Option[String], cast: [Remembered] }

#[doc("""
Measure a project and report what survived.

Every step can fail for a reason the caller has to hear: a kalku that
will not start, a project that will not compile, a suite that is already
red. None of them produce a score, because a score built on any of them
would be a number nobody should believe.
""")]
pub fn measure(
  asking: Asking
) : Found / Process + Spawn + Clock + File + Attending + Actor[OrchMsg] + Telling + Signal + Stderr {
  # A run arranges not to be orphaned before it summons anything: the
  # kalku it is about to start lead their own process groups, so an
  # interrupt reaches this fiber and nothing else.
  let _watching = spawn_actor(() => as_cancellation(Actor.self()))
  match discover(asking) {
    Err(why) -> Found { report: None, failure: Some(why), cast: [] }
    Ok(known) -> casting_them(asking, known)
  }
}

#[doc("""
What can be broken in this project, asked of one kalku.

`prepare` and `baseline` come first because they are about the project
rather than about any wekufe: a suite that cannot build, or that is
already failing, ends the run here.
""")]
pub fn discover(
  asking: Asking
) : Result[Known, String] / Process + Spawn + Clock + File + Attending + Actor[OrchMsg] + Telling {
  let life = Life { worker: 0, summons: 1 }
  match summon(KalkuSpec { life: life, command: asking.spec.command, args: asking.spec.args }) {
    Err(e) -> Err(e)
    Ok(k) -> {
      let me = Actor.self()
      let _reader = spawn_actor(() => read_loop(k, me))
      # And its stderr, in its own fiber: a kalku that dies on the way to
      # `ready` says why there, and a child filling one pipe while the
      # parent drains the other deadlocks.
      let _errs = spawn_actor(() => read_errs_loop(k, me))
      let answer = interview(k, asking)
      kill_now(k)
      answer
    }
  }
}

fn interview(
  k: Kalku,
  asking: Asking
) : Result[Known, String] / Process + Clock + File + Attending + Actor[OrchMsg] + Telling {
  greet(k, asking)!
  await_kind(k, "ready")!
  Telling.entered(PhasePreparing)
  Telling.tell_of("preparing #{asking.spec.root}; this builds the project and can take minutes")
  tell(k, 2, Prepare)!
  await_kind(k, "prepared")!
  Telling.entered(PhaseBaselining)
  Telling.tell_of("running the suite once, for a baseline")
  tell(k, 3, Baseline)!
  let baseline = await_kind(k, "baseline_done")!
  refuse_red(baseline)!
  let suite = suite_of(baseline)
  Telling.tell_of("the suite is green: #{length(suite)} test(s)")
  tell(
    k,
    4,
    Sites(SitesMsg {
      files: asking.files,
      spells: asking.spells,
      exclude_calls: asking.exclude_calls
    })
  )!
  let found = sites_found_of(await_kind(k, "sites_found")!)!
  each(found.skipped, s => Telling.tell_of("skipped #{skipped_line(s)}"))
  (match nothing_usable(length(found.sites), found.skipped) {
    Some(why) -> Err(why)
    None -> Ok(())
  })!
  (match gone(asking.only, found.sites) {
    [] -> Ok(())
    names -> Err(
      "no wekufe answers to #{join(names, ", ")} any more: a wekufe is named by the text it was cast in, and its file has changed since. Run `kalku run <file>` again to get new names"
    )
  })!
  Ok(Known {
    sites: found.sites,
    tests: suite,
    coverage: coverage_from(baseline)!,
    durations: durations_of(baseline),
    skipped: found.skipped
  })
}

# The suite as the kalku enumerated it. Which of those tests judge a
# given wekufe is the coverage's business; without coverage, all of them
# do — slow, and the only honest reading of "this kalku cannot say".
fn suite_of(reply: KalkuReply) : [String] = match reply {
  BaselineDone(m) -> m.tests | (.test_id)
  _ -> []
}

# Coverage arrives one of two ways: inline when it is small, and in a
# file in the reni when it is not, which is every project big enough to
# be worth measuring. Reading only the inline form loses the coverage of
# exactly those projects, silently, and a run then casts every wekufe
# against the whole suite while reporting that suite as the tests that
# cover it.
fn coverage_from(reply: KalkuReply) : Result[Option[[CoverageEntry]], String] / File = match reply {
  BaselineDone(m) -> match (m.coverage, m.coverage_path) {
    (Some(entries), _) -> Ok(Some(entries))
    (None, Some(path)) -> spilled_coverage(path)
    _ -> Ok(None)
  }
  _ -> Ok(None)
}

# A coverage file the kalku named and this side cannot read is a fault
# worth stopping for: carrying on would measure the whole suite and call
# it coverage.
fn spilled_coverage(path: String) : Result[Option[[CoverageEntry]], String] / File =
  if file.exists(path) {
    match decode_coverage(file.read(path)) {
      Ok(entries) -> Ok(Some(entries))
      Err(e) -> Err("the coverage file #{path} could not be read: #{e.detail}")
    }
  } else {
    Err("the kalku named a coverage file that is not there: #{path}")
  }

# What each test costs, which is what a wekufe's deadline is built from:
# a cast is given a few times the time the tests it runs took.
fn durations_of(reply: KalkuReply) : [(String, Int)] = match reply {
  BaselineDone(m) -> m.tests | (t => (t.test_id, t.duration_ms))
  _ -> []
}

# A red baseline ends the run: a wekufe on top of a failing test measures
# nothing, and pretending otherwise is the one thing a measuring tool
# must never do.
fn refuse_red(reply: KalkuReply) : Result[Unit, String] = match reply {
  BaselineDone(m) -> if m.status == Red {
    Err("the suite is already failing: #{failure_names(m.failures)}")
  } else {
    Ok(())
  }
  _ -> Ok(())
}

fn failure_names(failures: [Failure]) : String = if is_empty(failures) {
  "no test named"
} else {
  join(failures | (.test_id), ", ")
}

fn sites_found_of(reply: KalkuReply) : Result[SitesFoundMsg, String] = match reply {
  SitesFound(m) -> Ok(m)
  other -> Err("expected the sites, got #{other}")
}

fn greet(k: Kalku, asking: Asking) : Result[Unit, String] / Process =
  tell(k, 1, greeting(asking.spec, 0))

fn tell(k: Kalku, id: Int, request: KalkuRequest) : Result[Unit, String] / Process =
  ask(k, id, request)

# One reply of the kind asked for. Anything else the kalku says on the
# way — progress, a line that will not decode — is not the answer.
# Only this kalku's words are this kalku's answer. A mailbox is shared —
# a server keeps other kalku warm on it — and reading someone else's
# `ready` as the answer to your own `hello` is how a run waits forever
# for a reply it already threw away.
fn await_kind(
  k: Kalku,
  kind: String
) : Result[KalkuReply, String] / Clock + Attending + Actor[OrchMsg] + Telling =
  await_with(k, kind, [])

# A kalku that dies before it answers has usually said why on stderr: a
# stack trace, a missing module, a build that would not run. Dropping
# those lines leaves `the kalku closed its pipe` and nothing to act on,
# and the only way back to the reason is editing the summon script by
# hand. They are kept as they arrive and quoted with whatever went wrong.
#[doc("""
How long a wait may go quiet before the run says it is still waiting.

`prepare` can honestly take minutes, and a run that says so once and then
goes silent for ten of them is indistinguishable from one that has hung.
The commonest cause of the silence is a build lock held by a runtime
nobody killed — a wait at 0% CPU with nothing on the channel — and that
one is not a slow compile, it is a wait for something that will never
happen. The run cannot tell them apart, but it can stop the person having
to guess, and the kalku's own last words usually name the lock.
""")]
const QUIET_MS : Int = 20000

#[doc("How long a kalku is given to answer before the run gives up on it.")]
const PATIENCE_MS : Int = 600000

fn await_with(
  k: Kalku,
  kind: String,
  said: [String]
) : Result[KalkuReply, String] / Clock + Attending + Actor[OrchMsg] + Telling =
  waiting_for(k, kind, said, PATIENCE_MS)

fn waiting_for(
  k: Kalku,
  kind: String,
  said: [String],
  left: Int
) : Result[KalkuReply, String] / Clock + Attending + Actor[OrchMsg] + Telling =
  match receive_timeout(
    millis(min(QUIET_MS, left))
  ) {
    None -> if left > QUIET_MS {
      {
        Telling.tell_of(still_waiting(kind, PATIENCE_MS - left + QUIET_MS, said))
        waiting_for(k, kind, said, left - QUIET_MS)
      }
    } else {
      Err(with_last_words("the kalku said nothing while we waited for `#{kind}`", said))
    }
    Some(Cancel) -> Err("the run was cancelled")
    Some(Wire(life, what)) -> if life == k.life {
      from_ours(k, kind, what, said)
    } else {
      # Another kalku of this project's own pool, greeting a mailbox this
      # run shares with it. Its own business, and never anybody else's.
      waiting_for(k, kind, said, left)
    }
    Some(stray) -> {
      # A line from whoever is hosting the run, which this side does not
      # read. Dropping it leaves a client waiting on an answer that will
      # never come, and on a command line there is nobody to hand it to.
      Attending.not_mine(stray)
      waiting_for(k, kind, said, left)
    }
  }

#[doc("""
What a run says while a wait is still going.

The kalku's own last line is quoted because that is where a build lock
announces itself — a runtime waiting on one says so — and this side would
otherwise hold that line until the kalku died, which for a lock is never.
""")]
pub fn still_waiting(kind: String, waited_ms: Int, said: [String]) : String {
  let so_far = "still waiting for `#{kind}`; nothing heard for #{waited_ms / 1000}s"
  let tail = filter(enumerate(said), i => i.fst == length(said) - 1) | (.snd)
  match tail {
    [line, ..._] -> "#{so_far}. The kalku last said: #{trim(line)}"
    [] -> "#{so_far}. If this is a build, it is a slow one"
  }
}

#[doc("How many of a dying kalku's last lines are worth quoting.")]
const LAST_LINES : Int = 12

fn with_last_words(why: String, said: [String]) : String = if is_empty(said) {
  why
} else {
  join([why, "what it said before it went:"] ++ (kept(said) | (l => "  #{l}")), "\n")
}

# The last lines, because a stack trace ends where the reason is.
fn kept(said: [String]) : [String] {
  let worth = filter(said, l => not is_empty(trim(l)))
  if length(worth) <= LAST_LINES {
    worth
  } else {
    drop(worth, length(worth) - LAST_LINES)
  }
}

fn from_ours(
  k: Kalku,
  kind: String,
  what: FromKalku,
  said: [String]
) : Result[KalkuReply, String] / Clock + Attending + Actor[OrchMsg] + Telling = match what {
  Said(line) -> match heard(line) {
    Err(e) -> Err(
      with_last_words("the kalku wrote a line this side cannot read: #{e.detail}", said)
    )
    Ok(m) -> judge(k, kind, m.body, said)
  }
  Closed -> Err(with_last_words("the kalku closed its pipe before saying `#{kind}`", said))
  Unreadable(why) -> Err(with_last_words(why, said))
  Wrote(chunk) -> await_with(k, kind, said ++ lines(chunk))
}

fn judge(
  k: Kalku,
  kind: String,
  body: KalkuReply,
  said: [String]
) : Result[KalkuReply, String] / Clock + Attending + Actor[OrchMsg] + Telling = match body {
  KalkuError(e) -> Err("#{e.code}: #{e.message}")
  Progress(_) -> await_with(k, kind, said)
  answered -> if reply_kind(answered) == kind {
    Ok(answered)
  } else {
    Err("expected `#{kind}`, the kalku said `#{reply_kind(answered)}`")
  }
}

fn reply_kind(r: KalkuReply) : String {
  case Ready(_) -> "ready"
  case Prepared(_) -> "prepared"
  case BaselineDone(_) -> "baseline_done"
  case SitesFound(_) -> "sites_found"
  case CastDone(_) -> "cast_done"
  case Aborted(_) -> "aborted"
  case ResetDone(_) -> "reset_done"
  case Reloaded(_) -> "reloaded"
  case Delegated(_) -> "delegated"
  case Progress(_) -> "progress"
  case Bye -> "bye"
  case KalkuError(_) -> "error"
}

# ---- casting -------------------------------------------------------------

# A run measures every site it was given; a re-cast measures the ones it
# was named, and nothing else.
fn wanted_only(asking: Asking, known: Known) : Known = if is_empty(asking.only) {
  known
} else {
  Known {
    sites: filter(known.sites, s => contains(asking.only, s.site_id)),
    tests: known.tests,
    coverage: known.coverage,
    durations: known.durations,
    skipped: known.skipped
  }
}

fn casting_them(
  asking: Asking,
  all_known: Known
) : Found / Process + Spawn + Clock + Attending + Actor[OrchMsg] + Telling {
  let known = wanted_only(asking, all_known)
  let ready = plan(inputs_for(asking, known), _id => None)
  let casts = repeated(limited(ready.to_cast, asking.limit))
  Telling.entered(PhaseCasting)
  Telling.tell_of(
    "#{length(known.sites)} site(s) found; casting #{length(casts)} with #{asking.spec.workers} worker(s)"
  )
  Telling.will_cost(length(casts), estimate_ms(casts, known.durations, asking.spec.workers))
  let casting = agreed(cast_all(asking.spec, casts))
  Telling.entered(PhaseReporting)
  Found {
    report: Some(report_of(ready, casting, known)),
    failure: None,
    cast: written_down(casting, known)
  }
}

# What a run leaves for the next question: every wekufe it cast, where it
# was, what came of it, and which tests judged it.
fn written_down(casting: Casting, known: Known) : [Remembered] = flat_map(
  casting.verdicts,
  v => match find(known.sites, s => s.site_id == v.wekufe) {
    Some(cast_at) -> [
      Remembered {
        wekufe: v.wekufe,
        site: cast_at,
        outcome: v.outcome,
        tests: v.tests
      }
    ]
    None -> []
  }
)

# With coverage, the plan casts each wekufe against the tests that reach
# its line; without it, against all of them. Both are honest — guessing
# at coverage would be fast and wrong.
pub fn inputs_for(asking: Asking, known: Known) : Inputs = Inputs {
  sites: known.sites,
  coverage: known.coverage,
  all_tests: known.tests,
  durations: known.durations,
  suppressed_ids: suppressed_by(asking.equivalents, known.sites),
  exclude: asking.exclude,
  reach: 
  # A run asked about a change casts what the change touched and nothing
  # else: that is where the speed of checking a pull request comes from,
  # and where its question — did this introduce a hole — gets its answer.
  match asking.touched {
    Some(changes) -> Touched(changes)
    None -> Everything
  },
  timeout_floor_ms: asking.timeout_floor_ms
}

# What the project declared equivalent, as the sites it points at. An
# entry that names no site suppresses nothing — an orphan is reported
# rather than obeyed, because a suppression nobody can point at cannot be
# told from a hole somebody hid.
pub fn suppressed_by(entries: [equivalent.Entry], sites: [Site]) : [String] =
  match_sites(entries, sites).suppressed | (.site_id)

#[doc("Entries that point at no site in this run.")]
pub fn orphans_among(entries: [equivalent.Entry], sites: [Site]) : [equivalent.Entry] =
  match_sites(entries, sites).orphans

fn limited(casts: [Wekufe], limit: Int) : [Wekufe] = if limit <= 0 {
  casts
} else {
  enumerate(casts) |? (c => c.fst < limit) | (.snd)
}

# A wekufe with no verdict was never answered for, which is a crash as
# far as a report is concerned: it is counted, never quietly dropped.
pub fn report_of(ready: Plan, casting: Casting, known: Known) : Report {
  let verdicts = casting.verdicts | (v => of_outcome(v.outcome))
  let uncovered = ready.no_coverage | (_s => of_outcome(NoCoverage))
  # A site the project declared equivalent is counted and named, never
  # silently missing: a suppression that leaves no trace in the report
  # cannot be told from a hole somebody hid.
  let declared = ready.suppressed | (_s => EquivalentBy(Declared))
  Report {
    counts: tally(verdicts ++ uncovered ++ declared),
    planned: 
    # What the plan held before `--limit` cut it, so a run that measured
    # part of a file cannot report the part's score as the file's.
    length(ready.to_cast),
    survivors: survivors_of(casting, known),
    on_changed_lines: 0,
    suppressions: SuppressionChanges {
      equivalent_added: 0,
      exclude_added: [],
      exclude_calls_added: []
    },
    troubles: troubles_of(casting, known),
    skipped: known.skipped,
    uncovered: ready.no_coverage,
    blockers: []
  }
}

#[doc("""
The report, judged by what the project asked to be held to.

The judging is separate from the measuring because a report is a
measurement and a verdict is an opinion about one: the same counts answer
to a different policy in CI than on a laptop, and nothing about the run
changes between them.
""")]
pub fn judged_by(r: Report, policy: Policy, touched: Option[[FileChange]]) : Report {
  # A run that was not given a diff has no changed lines and counts none.
  # That zero is true because nobody asked, which is a different zero from
  # the one a gate used to be handed because the field was never filled in.
  let change = match touched {
    Some(changes) -> Change {
      survivors: on_lines(changes, r.survivors),
      uncovered: uncovered_on_lines(changes, r.uncovered)
    }
    None -> no_change()
  }
  # A run that could not measure at all never reaches here: that failure
  # is answered before a report exists. What can reach here is a run that
  # measured part of what it was asked, because some file would not be
  # searched, and the gate has to hear that.
  Report {
    ...r,
    on_changed_lines: change.survivors,
    blockers: blockers(
      r.counts,
      change,
      policy,
      trouble_of(r.skipped),
      was_partial(r),
      is_some(touched)
    )
  }
}

# A run that cast fewer wekufe than it planned measured part of the thing
# a floor is about.
fn was_partial(r: Report) : Bool = r.planned > 0 and cast_of(r) < r.planned

fn cast_of(r: Report) : Int = r.counts.killed
  + r.counts.survived
  + r.counts.timeout
  + r.counts.compile_error
  + r.counts.crashed
  + r.counts.nondeterministic

# An outcome outside the score is carried with whatever the kalku said
# about it: a `compile_error` a reader cannot explain is the one result
# that helps nobody.
fn troubles_of(casting: Casting, known: Known) : [Trouble] = flat_map(
  casting.verdicts,
  v => if scoring(v.outcome) {
    []
  } else {
    [
      Trouble {
        wekufe: v.wekufe,
        at: find(known.sites, s => s.site_id == v.wekufe),
        outcome: v.outcome,
        said: v.said
      }
    ]
  }
)

fn scoring(o: Outcome) : Bool = o == Killed or o == Survived or o == Equivalent

fn survivors_of(casting: Casting, known: Known) : [Survivor] = flat_map(
  casting.verdicts,
  v => if v.outcome == Survived { site_named(known, v.wekufe, v.tests) } else { [] }
)

# The tests that judged it are the ones the plan sent with it, which is
# what the coverage chose — or the whole suite, where there is none.
# Reporting none would read as "nothing looked", which is the opposite of
# what happened.
fn site_named(known: Known, wekufe: String, tests: [String]) : [Survivor] = match find(
  known.sites,
  s => s.site_id == wekufe
) {
  Some(s) -> [Survivor { site: s, tests: if is_empty(tests) { known.tests } else { tests } }]
  None -> []
}

# What judged a wekufe is what the verdict says judged it: the plan chose
# the tests, the scheduler sent them, and the verdict carries them back.
fn judged_for(casting: Casting, wekufe: String, known: Known) : [String] = match find(
  casting.verdicts,
  v => v.wekufe == wekufe
) {
  Some(v) -> v.tests
  None -> known.tests
}

# A wekufe whose outcome depends on how things were scheduled is cast
# more than once, and the queue is where that happens: the scheduler
# hands out casts and knows nothing about why two of them are the same.
pub fn repeated(casts: [Wekufe]) : [Wekufe] = flat_map(casts, again)

fn again(c: Wekufe) : [Wekufe] = repeat(c, max_casts(c.casts))

fn max_casts(n: Int) : Int = if n < 1 { 1 } else { n }

# One verdict per wekufe, from however many casts it took. A wekufe that
# came to the same thing every time is believed; one that did not is
# `nondeterministic`, which is a fact about the suite and not a
# measurement of it.
pub fn agreed(casting: Casting) : Casting = Casting {
  ...casting,
  verdicts: uniq(casting.verdicts | (.wekufe)) | (w => settled(casting.verdicts, w))
}

fn settled(verdicts: [scheduler.Verdict], wekufe: String) : scheduler.Verdict {
  let mine = filter(verdicts, v => v.wekufe == wekufe)
  let first = head(mine)
  match first {
    None -> scheduler.Verdict { wekufe: wekufe, outcome: Crashed, tests: [], said: None }
    Some(one) -> if all(mine, v => v.outcome == one.outcome) {
      one
    } else {
      scheduler.Verdict {
        ...one,
        outcome: Nondeterministic,
        said: Some(
          "cast #{length(mine)} times: #{join(uniq(mine | (v => outcome_name(v.outcome))), ", ")}"
        )
      }
    }
  }
}
