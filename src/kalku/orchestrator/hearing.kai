#[doc("""
Waiting for one kalku's answer: the reply of the kind asked for, or why
there will be none, with what the kalku wrote on the way.

A wait says when it has gone quiet, quotes a dying kalku's last lines, and
leaves alone whatever in a shared mailbox is somebody else's.
""")]

import actor
import time
import kalku.wire.kalku_msg
import kalku.orchestrator.escalation
import kalku.orchestrator.kalku_proc
import kalku.orchestrator.attending
import kalku.orchestrator.telling

#[doc("""
One reply of the kind asked for, from this kalku.

Anything else the kalku says on the way — progress, a line that will not
decode — is not the answer. Only this kalku's words are this kalku's
answer. A mailbox is shared — a server keeps other kalku warm on it — and
reading someone else's `ready` as the answer to your own `hello` is how a
run waits forever for a reply it already threw away.
""")]
pub fn await_kind(
  k: Kalku,
  kind: String
) : Result[KalkuReply, String] / Clock + Attending + Actor[OrchMsg] + Telling =
  await_with(k, kind, [])

# A kalku that dies before it answers has usually said why on stderr: a
# stack trace, a missing module, a build that would not run. Dropping
# those lines leaves `the kalku closed its pipe` and nothing to act on,
# and the only way back to the reason is editing the summon script by
# hand. They are kept as they arrive and quoted with whatever went wrong.
#[doc("""
How long a wait may go quiet before the run says it is still waiting.

`prepare` can honestly take minutes, and a run that says so once and then
goes silent for ten of them is indistinguishable from one that has hung.
The commonest cause of the silence is a build lock held by a runtime
nobody killed — a wait at 0% CPU with nothing on the channel — and that
one is not a slow compile, it is a wait for something that will never
happen. The run cannot tell them apart, but it can stop the person having
to guess, and the kalku's own last words usually name the lock.
""")]
const QUIET_MS : Int = 20000

#[doc("How long a kalku is given to answer before the run gives up on it.")]
const PATIENCE_MS : Int = 600000

fn await_with(
  k: Kalku,
  kind: String,
  said: [String]
) : Result[KalkuReply, String] / Clock + Attending + Actor[OrchMsg] + Telling =
  waiting_for(k, kind, said, PATIENCE_MS)

fn waiting_for(
  k: Kalku,
  kind: String,
  said: [String],
  left: Int
) : Result[KalkuReply, String] / Clock + Attending + Actor[OrchMsg] + Telling =
  match receive_timeout(
    millis(min(QUIET_MS, left))
  ) {
    None -> if left > QUIET_MS {
      {
        Telling.tell_of(still_waiting(kind, PATIENCE_MS - left + QUIET_MS, said))
        waiting_for(k, kind, said, left - QUIET_MS)
      }
    } else {
      Err(with_last_words("the kalku said nothing while we waited for `#{kind}`", said))
    }
    Some(Cancel) -> Err("the run was cancelled")
    Some(Wire(life, what)) -> if life == k.life {
      told_if_written(life, what)
      match from_ours(kind, what, said) {
        Over(answer) -> answer
        Longer(heard) -> waiting_for(k, kind, heard, PATIENCE_MS)
      }
    } else {
      # Another kalku of this project's own pool, greeting a mailbox this
      # run shares with it. Its own business, and never anybody else's.
      waiting_for(k, kind, said, left)
    }
    Some(stray) -> {
      # A line from whoever is hosting the run, which this side does not
      # read. Dropping it leaves a client waiting on an answer that will
      # never come, and on a command line there is nobody to hand it to.
      Attending.not_mine(stray)
      waiting_for(k, kind, said, left)
    }
  }

#[doc("""
What a run says while a wait is still going.

The kalku's own last line is quoted because that is where a build lock
announces itself — a runtime waiting on one says so — and this side would
otherwise hold that line until the kalku died, which for a lock is never.
""")]
pub fn still_waiting(kind: String, waited_ms: Int, said: [String]) : String {
  let so_far = "still waiting for `#{kind}`; nothing heard for #{waited_ms / 1000}s"
  let tail = filter(enumerate(said), i => i.fst == length(said) - 1) | .snd
  match tail {
    [line, ..._] -> "#{so_far}. The kalku last said: #{trim(line)}"
    [] -> "#{so_far}. If this is a build, it is a slow one"
  }
}

#[doc("How many of a dying kalku's last lines are worth quoting.")]
const LAST_LINES : Int = 12

fn with_last_words(why: String, said: [String]) : String = if is_empty(said) {
  why
} else {
  join([why, "what it wrote on stderr before that:", ...said | (l => "  #{l}")], "\n")
}

#[doc("""
What is worth keeping of a kalku's words once it has written some more.

Only the last lines, because a stack trace ends where the reason is — and
no more than those are held, because a build that logs through a long wait
writes a great deal, and a wait that kept all of it paid for every line
again each time another arrived.
""")]
pub fn heard_last(said: [String], chunk: String) : [String] {
  let worth = said ++ filter(lines(chunk), l => not is_empty(trim(l)))
  if length(worth) <= LAST_LINES {
    worth
  } else {
    drop(worth, length(worth) - LAST_LINES)
  }
}

# What one thing the kalku sent means for a wait: the end of it, or more
# waiting with what it has said so far.
type Turn = Over(Result[KalkuReply, String]) | Longer([String])

# Decided here and waited for in `waiting_for` itself: a wait takes a turn
# for every chunk a kalku writes, and only a call to itself runs in
# constant stack however many turns there are.
fn from_ours(kind: String, what: FromKalku, said: [String]) : Turn = match what {
  Said(line) -> match heard(line) {
    Err(e) -> Over(Err(with_last_words("the kalku #{noise(line, e.detail)}", said)))
    Ok(m) -> judge(kind, m.body, said)
  }
  Closed -> Over(Err(with_last_words("the kalku closed its pipe before saying `#{kind}`", said)))
  Unreadable(why) -> Over(Err(with_last_words(why, said)))
  Wrote(chunk) -> Longer(heard_last(said, chunk))
}

fn judge(kind: String, body: KalkuReply, said: [String]) : Turn = match body {
  KalkuError(e) -> Over(Err("#{e.code}: #{e.message}"))
  Progress(_) -> Longer(said)
  answered -> if reply_kind(answered) == kind {
    Over(Ok(answered))
  } else {
    Over(Err("expected `#{kind}`, the kalku said `#{reply_kind(answered)}`"))
  }
}

fn reply_kind(r: KalkuReply) : String {
  case Ready(_) -> "ready"
  case Prepared(_) -> "prepared"
  case BaselineDone(_) -> "baseline_done"
  case SitesFound(_) -> "sites_found"
  case CastDone(_) -> "cast_done"
  case Aborted(_) -> "aborted"
  case ResetDone(_) -> "reset_done"
  case Reloaded(_) -> "reloaded"
  case Delegated(_) -> "delegated"
  case Progress(_) -> "progress"
  case Bye -> "bye"
  case KalkuError(_) -> "error"
}
