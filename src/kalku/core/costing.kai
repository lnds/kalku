#[doc("""
What a run is about to cost, said before it is spent.

A run knows this by the time it starts casting: the baseline has told it
how long every test took, and the plan has told it which tests judge each
wekufe. Multiplying the two is arithmetic, not a guess — which is why the
number is worth printing and why it is phrased as what it is, the rate
the baseline ran at.

It counts the tests and nothing else. Loading a wekufe into a warm kalku
costs something too, and that is not a number this side can know without
measuring it, so the estimate is a floor rather than a promise and says
so in the words around it.

Where the baseline doubted its coverage, a wekufe its own tests do not
kill faces the rest of the suite as well, and which ones will is only
known by casting them. The run then has two numbers, what its covering
tests cost and what it costs if every wekufe needs the rest, and says
both: the first alone would be read as the likely duration and be off by
the size of the suite.
""")]

import collections.map
import kalku.core.planner
import kalku.core.told

#[doc("""
How long the tests of these wekufe took in the baseline, in milliseconds.

The work, before it is shared out: one wekufe costs what the tests that
judge it cost. A cast that fails stops at the first failing test, so this
is the most those tests can cost, not the least.
""")]
pub fn tests_ms(casts: [Wekufe], durations: [(String, Int)]) : Int {
  let told = told_by(None, durations)
  sum(casts | (c => cost_of(told, c.tests)))
}

#[doc("""
How long the tests of these wekufe took in the baseline, counting the rest
of the suite for each: what the work is if no wekufe is killed by its own
tests.
""")]
pub fn most_tests_ms(casts: [Wekufe], durations: [(String, Int)]) : Int {
  let told = told_by(None, durations)
  sum(casts | (c => cost_of(told, c.tests) + cost_of(told, c.rest)))
}

#[doc("""
How long a run is likely to take, in milliseconds.

Workers share the work, so they divide it; a run with none is a run that
casts nothing.
""")]
pub fn estimate_ms(casts: [Wekufe], durations: [(String, Int)], workers: Int) : Int
  requires workers >= 0
  ensures result >= 0
= if workers <= 0 { 0 } else { tests_ms(casts, durations) / workers }

#[doc("""
The longest a run can take, in milliseconds: the estimate when no cast
carries the rest of the suite, and more when the coverage was doubted.
""")]
pub fn most_ms(casts: [Wekufe], durations: [(String, Int)], workers: Int) : Int
  requires workers >= 0
  ensures result >= 0
= if workers <= 0 { 0 } else { most_tests_ms(casts, durations) / workers }

#[doc("""
That estimate in the words someone can act on.

Rounded to what the number deserves: nobody waits differently for eight
minutes than for eight and a half, and a figure with more precision than
the thing it estimates invites trust it has not earned.
""")]
pub fn how_long(ms: Int) : String = if ms < 1000 {
  "no time at all"
} else if ms < 60000 {
  "under a minute"
} else if ms < 5400000 {
  plural(rounded_div(ms, 60000), "minute")
} else {
  plural(rounded_div(ms, 3600000), "hour")
}

#[doc("""
The whole sentence a run prints before it starts casting.

It takes the estimates rather than computing them, so the numbers a
person reads and the numbers a client is sent are the same ones. When the
longest the run can take reads the same as the estimate, there is one
number to say; when it does not, the estimate is said as the floor it is.
""")]
pub fn what_it_costs(ms: Int, most: Int) : String = if most < 1000 {
  "this should be quick"
} else if how_long(most) == how_long(ms) {
  "about #{how_long(ms)} at the rate the baseline ran, plus loading each wekufe"
} else {
  "#{at_least(ms)}up to #{how_long(most)} at the rate the baseline ran, plus loading each wekufe: the coverage is doubted, so a wekufe its own tests do not kill faces the rest of the suite too"
}

# A floor under a minute says nothing anyone would wait differently for.
fn at_least(ms: Int) : String = if ms < 60000 { "" } else { "at least #{how_long(ms)} and " }

fn plural(n: Int, unit: String) : String = if n == 1 { "1 #{unit}" } else { "#{n} #{unit}s" }

# Half up, so an estimate never rounds its way down to nothing.
fn rounded_div(n: Int, by: Int) : Int = (n + by / 2) / by

#[doc("""
One test, and what it costs a run to have it judge wekufe.

A test costs twice in mutation testing: once in the suite, and once for
every wekufe whose line it reaches. Its own duration says little alone; a
test of two seconds that judges three hundred wekufe is ten minutes of
casting, and a slower one that judges one wekufe is not.
""")]
#[derive(Eq, Show)]
pub type TestCost = { test_id: String, duration_ms: Int, judges: Int }

#[doc("The casting time a test implies: its duration once for every wekufe it judges.")]
pub fn casting_ms(t: TestCost) : Int = t.duration_ms * t.judges

#[doc("""
Every test that judges one of these wekufe, dearest first.

A test judges the wekufe it is sent with. Where the coverage was doubted
it may also face the ones it is held back for, but only when the tests
credited with the line did not kill it, which is not known before casting:
counting those would rank a test by work it may never do.
""")]
pub fn test_costs(casts: [Wekufe], durations: [(String, Int)]) : [TestCost] {
  let took = map.from(durations)
  let judged =
    list.foldl(casts || .tests, map.empty(), (counts, t) => map.update(counts, t, 1, n => n + 1))
  ranked(
    map.to_pairs(judged)
      | (p => TestCost {
        test_id: p.fst,
        duration_ms: unwrap_or(map.get(took, p.fst), 0),
        judges: p.snd
      })
  )
}

#[doc("""
The costs of several runs over one suite as one list: each shard counted
the wekufe that fell to it, so what a test judges adds up, and its
duration is the one the first shard measured.
""")]
pub fn added_costs(parts: [[TestCost]]) : [TestCost] {
  let by_test = list.foldl(
    parts || (p => p),
    map.empty(),
    (acc, c) => map.update(
      acc,
      c.test_id,
      c,
      seen => TestCost { ...seen, judges: seen.judges + c.judges }
    )
  )
  ranked(map.values(by_test))
}

# Dearest first; a tie is broken by the id, so two runs of one shape list
# the same tests in the same order.
fn ranked(costs: [TestCost]) : [TestCost] = sort_by(
  costs,
  (a, b) => if casting_ms(a) != casting_ms(b) {
    casting_ms(b) - casting_ms(a)
  } else if a.test_id < b.test_id {
    0 - 1
  } else if a.test_id > b.test_id {
    1
  } else {
    0
  }
)
