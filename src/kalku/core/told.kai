#[doc("""
What a baseline said, kept where one site's question costs one look.

A plan asks the same two things of every site: which tests reach this
line, and what do they cost. Asked of the lists a baseline arrives in, each
answer walks all of them, and a suite of thousands with no coverage to
narrow it paid the square of its size for every site: half an hour of
silence before the first cast.

The lookups live in a module of their own because importing a map brings
its `filter` and `contains` with it, over the lists' own.
""")]

import collections.map
import kalku.wire.shapes

#[doc("A baseline's coverage and durations, indexed. `reaching` is absent when there was no coverage.")]
pub type Told = { reaching: Option[Map[String, [String]]], costs: Map[String, Int] }

#[doc("Index what a baseline said: which tests reach each line, and what each test cost.")]
pub fn told_by(coverage: Option[[CoverageEntry]], durations: [(String, Int)]) : Told = Told {
  reaching: coverage |> option.map(entries => list.foldl(entries, map.empty(), reached)),
  costs: map.from(durations)
}

#[doc("The tests that reach a line, where that was measured: none is an answer, and `None` is not knowing.")]
pub fn reaching(told: Told, file: String, line: Int) : Option[[String]] =
  told.reaching |> option.map(by_line => unwrap_or(map.get(by_line, place(file, line)), []))

#[doc("""
The tests that reach any line of a site, where that was measured.

A site's first line need not be one a coverage tool credits: a match arm
whose body starts on the next line is reached on the body's line, and never
on the pattern's.
""")]
pub fn reaching_site(told: Told, site: Site) : Option[[String]] =
  told.reaching
    |> option.map(
      by_line => uniq(lines_of(site) || (l => unwrap_or(map.get(by_line, place(site.file, l)), [])))
    )

#[doc("""
The lines a site's own text is on. A line its span reaches only for the
whitespace before what follows is not the site's, or the next arm's tests
would judge this one.
""")]
pub fn lines_of(site: Site) : [Int] {
  let from = site.span.start.line
  let written = match site.original {
    Some(text) -> enumerate(lines(text)) |? (l => trim(l.snd) != "") | (l => from + l.fst)
    None -> []
  }
  if list.is_empty(written) { [from] } else { written }
}

#[doc("What these tests took in the baseline, in milliseconds; a test nobody timed costs nothing.")]
pub fn cost_of(told: Told, tests: [String]) : Int =
  sum(tests | (t => unwrap_or(map.get(told.costs, t), 0)))

fn reached(by_line: Map[String, [String]], e: CoverageEntry) : Map[String, [String]] =
  map.update(by_line, place(e.file, e.line), e.tests, before => before ++ e.tests)

fn place(file: String, line: Int) : String = "#{file}:#{line}"

#[doc("Coverage with some tests taken out of it, and the lines that had no other.")]
pub type Narrowed = { coverage: [CoverageEntry], only_theirs: [String] }

#[doc("""
Coverage as it stands once these tests judge nothing.

A line only they reached is left with no test, and is named apart: nothing
reaches it that can judge, which is not the same as nothing reaching it,
and a reader told to write a test for it would be writing one that exists.
""")]
pub fn without(entries: [CoverageEntry], tests: [String]) : Narrowed {
  let gone = map.from(tests | (t => (t, true)))
  let kept =
    entries | (e => CoverageEntry { ...e, tests: e.tests |? (t => is_none(map.get(gone, t))) })
  Narrowed {
    coverage: kept,
    only_theirs: list.zip(entries, kept)
      |? (pair => (not list.is_empty(pair.fst.tests)) and list.is_empty(pair.snd.tests))
      | (pair => place(pair.fst.file, pair.fst.line))
  }
}

#[doc("True when a line of a site is among `only_theirs`: tests reach it, and none that can judge.")]
pub fn reached_only_by_them(only_theirs: [String], site: Site) : Bool =
  list.any(lines_of(site), l => list.contains(only_theirs, place(site.file, l)))

#[doc("How a line is named among `only_theirs`.")]
pub fn place_of(file: String, line: Int) : String = place(file, line)
