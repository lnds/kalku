#[doc("""
Which files of a project are its code and which are its suite.

The language says what its files look like (`core/setting_up.kai`) and this
reads a project through that: a whole project for `scope: all`, and the suite
a warm kalku holds a copy of. Nothing here knows a layout. A project whose
code is under `src/`, in any package of a workspace, is read the same way as
one whose code is under `lib/`.
""")]

import fs.dir
import fs.file
import kalku.core.cache
import kalku.core.setting_up

#[doc("Every source file the project has, which is what `scope: all` means.")]
pub fn every_source(root: String, known: Known) : [String] / File =
  filter(walked(root, known), f => is_source_of(known, f))

#[doc("Every file of the project's suite.")]
pub fn every_test(root: String, known: Known) : [String] / File =
  filter(walked(root, known), f => is_test_of(known, f))

# Everything under the project, without descending into what a build or
# version control leaves: a `target` or `deps` is more files than the rest of
# the project together, and none of them is read.
fn walked(root: String, known: Known) : [String] / File =
  flat_map(
    filter(dir.list_dir(root), name => not contains(known.ignored, name)),
    name => files_at("#{root}/#{name}")
  )

# A directory yields what is under it; a file at the top of the project is
# itself, which `walk` does not say.
fn files_at(path: String) : [String] / File = match dir.walk(path) {
  [] -> if file.exists(path) { [path] } else { [] }
  inside -> inside
}

#[doc("""
What a watch reads for a change, named from the project's root: the files a
run reads its settings from, where they exist, and the sources and suite of
the language the project is written in.
""")]
pub fn watched_here(known: Option[Known], settings: [String]) : [String] / File =
  filter(settings, f => file.exists(f))
    ++ (match known {
      Some(k) -> (every_source(".", k) ++ every_test(".", k)) | (f => without_dot(f))
      None -> []
    })

#[doc("A file a walk from `.` named, as a person names it: `lib/a.ex` for `./lib/a.ex`.")]
pub fn without_dot(path: String) : String = if starts_with(path, "./") {
  byte_slice(path, 2, length(path) - 2) |> unwrap_or(path)
} else {
  path
}

#[doc("""
Each file with the hash of what is in it now; a file that is gone hashes as
empty.

The paths are used as given. A walk gives them back already joined to the
root, and joining them again names a file that does not exist, which hashes
to the same nothing every time: a fingerprint that never changes is a warm
pool that is never renewed.
""")]
pub fn read_hashes(files: [String]) : [FileHash] / File =
  files | (f => FileHash { file: f, hash: hash_of(ok(read_or_empty(f)) ?? "") })

#[doc("""
What a file holds, or nothing when there is no such file. One that is there
and cannot be read is an error, not an empty file: read as empty, it would
be written over with what kalku could not see.
""")]
pub fn read_or_empty(path: String) : Result[String, String] / File =
  if file.exists(path) {
    file.read(path) |> map_err(why => "cannot read #{path}: #{why}")
  } else {
    Ok("")
  }
